<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>0b71d2a5-16f2-4136-a476-8beebb3038fd</UserSecretsId>
    <!-- Titularidad (ver LICENSE): queda en los metadatos de SigWeb.dll -->
    <Product>SGC Web</Product>
    <Authors>Pierr Angelo Chaves Correa</Authors>
    <Company>Pierr Angelo Chaves Correa</Company>
    <Copyright>© 2026 Pierr Angelo Chaves Correa. Todos los derechos reservados.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.8.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Multiproyecto y seguridad (Data/Seguridad) -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="SharpKml.Core" Version="6.1.0" />
  </ItemGroup>

  <!-- Diseñador de formularios: estructura de cada formulario. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\Formularios\estructuras-semilla.json" LogicalName="SigWeb.Data.Formularios.estructuras-semilla.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Manual de usuario: lo lee el asistente de ayuda interno (Data/Asistente/ManualAyuda). -->
    <None Update="docs\manual\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Datos de demostración (Data/Demo, solo con Demo:Sembrar = true): PDF de ejemplo y torres. -->
    <None Update="Data\Demo\recursos\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
