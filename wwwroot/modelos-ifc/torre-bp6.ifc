#32585=IFCPROPERTYSINGLEVALUE('Fuente',$,IFCTEXT('Planos DIS6052 y silueta DIS6042. Cuerpo BP6 = 25000 mm superiores del tronco de la serie par (vista frontal); delta, viga y brazos comunes (de BP6).'),$);
#32586=IFCPROPERTYSINGLEVALUE('AltoTotal_mm',$,IFCTEXT('58000'),$);
#32587=IFCPROPERTYSINGLEVALUE('AnchoBase_mm',$,IFCTEXT('14992'),$);
#32588=IFCPROPERTYSINGLEVALUE('Miembros',$,IFCTEXT('908'),$);
#32589=IFCPROPERTYSINGLEVALUE('MiembrosConPerfil',$,IFCTEXT('635'),$);
#32590=IFCPROPERTYSINGLEVALUE('PesoPerfilesLeidos_kg',$,IFCTEXT('10300.4'),$);
#32591=IFCPROPERTYSINGLEVALUE('MiembrosPerfilSupuesto',$,IFCTEXT('273'),$);
#32592=IFCPROPERTYSINGLEVALUE('PesoPerfilesSupuestos_kg',$,IFCTEXT('4461.6'),$);
#32593=IFCPROPERTYSINGLEVALUE('Supuesto01',$,IFCTEXT('La base corresponde a la pata de 12 m (cota 0 del plano); las patas de 1,5 a 10,5 m (H21\X2\2013\X0\H25) acortan la base y no se modelan como variante.'),$);
#32594=IFCPROPERTYSINGLEVALUE('Supuesto02',$,IFCTEXT('Cada pieza se relaciona con la hoja que detalla su zona (capa FOR de la silueta de cada plano); en zonas compartidas se elige la hoja de zona m\X2\00E1\X0\s espec\X2\00ED\X0\fica.'),$);
#32595=IFCPROPERTYSINGLEVALUE('Supuesto03',$,IFCTEXT('Las dos caras de cada vista se suponen id\X2\00E9\X0\nticas (simetr\X2\00ED\X0\a x \X2\2192\X0\ \X2\2212\X0\x, z \X2\2192\X0\ \X2\2212\X0\z).'),$);
#32596=IFCPROPERTYSINGLEVALUE('Supuesto04',$,IFCTEXT('Silueta DIS6042: la vista frontal dibuja la serie par (cuerpos 2, 4 y 6, con la pata de 12 m de BP6) y la vista lateral la serie impar (cuerpos 1, 3 y 5, con la pata de 12 m de BP5); cotas CUERPO 1\X2\2013\X0\6 de la silueta medidas desde la cintura. BP6: cuerpo de 25000 mm, serie par (vista frontal).'),$);
#32597=IFCPROPERTYSINGLEVALUE('Supuesto05',$,IFCTEXT('Tronco y pata (0\X2\2013\X0\37000): las cuatro caras son la de la vista de su serie; la cara longitudinal es la transversal girada 90\X2\00B0\X0\ (SUPUESTO: caras iguales; secci\X2\00F3\X0\n cuadrada comprobada: ancho lateral = ancho frontal a cada cota, diferencia \X2\2264\X0\ 12 mm).'),$);
#32598=IFCPROPERTYSINGLEVALUE('Supuesto06',$,IFCTEXT('Delta, viga y brazos: los de BP6, bajados 0 mm. Vista lateral de DIS6042 sobre la cintura en verdadera magnitud de la cara del m\X2\00E1\X0\stil (factor 1,0498); cara interior del delta con la vista CORTE de la silueta.'),$);
#32599=IFCPROPERTYSINGLEVALUE('Supuesto07',$,IFCTEXT('Marcas: cada vista de las hojas de detalle se proyecta (giro, traslaci\X2\00F3\X0\n, espejo y escala 1 o de verdadera magnitud 1.010161283) sobre la cara del esqueleto; solo se acepta si \X2\2265\X0\ 45 % de sus ejes cae sobre barras del esqueleto (\X2\2264\X0\ 60 mm). La geometr\X2\00ED\X0\a no se toma de las hojas.'),$);
#32600=IFCPROPERTYSINGLEVALUE('Supuesto08',$,IFCTEXT('Marcas del lado no dibujado de una vista: se asignan por simetr\X2\00ED\X0\a al lado reflejado (marcas D/Z del plano).'),$);
#32601=IFCPROPERTYSINGLEVALUE('Supuesto09',$,IFCTEXT('Redundantes de las hojas que el esqueleto no ten\X2\00ED\X0\a: se agregan solo si sus dos extremos, proyectados sobre la cara, caen sobre barras del esqueleto (\X2\2264\X0\ 20 mm); placas (L\X2\00C1\X0\MINAS) no se asignan a barras.'),$);
#32602=IFCPROPERTYSINGLEVALUE('Supuesto10',$,IFCTEXT('Barras sin marca: perfil supuesto (ver perfil_supuesto_origen); "Sin plano" donde no hay hoja de detalle le\X2\00ED\X0\da.'),$);
#32603=IFCPROPERTYSINGLEVALUE('Supuesto11',$,IFCTEXT('El perfil de cada pieza sale de su marca le\X2\00ED\X0\da en el plano y de la lista de materiales; las piezas sin perfil le\X2\00ED\X0\do llevan un perfil L SUPUESTO (PerfilSupuesto = S\X2\00ED\X0\): el de la pieza le\X2\00ED\X0\da m\X2\00E1\X0\s parecida de su misma cara, grupo y funci\X2\00F3\X0\n o, si no hay, el \X2\00E1\X0\ngulo L m\X2\00E1\X0\s chico de su hoja; se ven con un tono distinto.'),$);
#32604=IFCPROPERTYSINGLEVALUE('Supuesto12',$,IFCTEXT('La orientaci\X2\00F3\X0\n de las alas de los \X2\00E1\X0\ngulos no se lee de los planos procesados: se usa la convenci\X2\00F3\X0\n de montaje (montantes con alas hacia el interior; diagonales con un ala en el plano de la cara y la otra hacia el interior).'),$);
#32605=IFCPROPERTYSINGLEVALUE('Supuesto13',$,IFCTEXT('El tal\X2\00F3\X0\n del \X2\00E1\X0\ngulo se ubica sobre la l\X2\00ED\X0\nea de trabajo del plano (sin gramil ni excentricidad de conexi\X2\00F3\X0\n).'),$);
#32606=IFCPROPERTYSINGLEVALUE('Supuesto14',$,IFCTEXT('No se modelan placas, tornillos ni cartelas.'),$);
#32607=IFCPROPERTYSET('3N5__ErC9sXKk85x$x6KHQ',#5,'SigWeb_Torre',$,(#32585,#32586,#32587,#32588,#32589,#32590,#32591,#32592,#32593,#32594,#32595,#32596,#32597,#32598,#32599,#32600,#32601,#32602,#32603,#32604,#32605,#32606));
