{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "sigweb.example.com",
  "Aplicacion": {
    "UrlPublica": "https://sigweb.example.com"
  },
  "Autenticacion": {
    "AccesoLibreDesarrollo": false
  },
  "Seguridad": {
    "ControlEscritura": "Bloquear",
    "MfaObligatoriaAdministradores": true,
    "CspSoloReporte": false
  },
  "Correo": {
    "Modo": "Smtp",
    "Remitente": "SGC Web <no-responder@example.com>",
    "Smtp": {
      "Servidor": "email-smtp.us-east-1.amazonaws.com",
      "Puerto": 587
    }
  },
  "Proxy": {
    "ConfiarEnCualquierOrigen": true
  },
  "Telegram": {
    "PermitirChatsSinUsuario": false
  }
}
