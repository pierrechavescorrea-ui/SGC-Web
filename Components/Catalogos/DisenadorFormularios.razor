@* Diseñador de formularios (Configuración › Catálogos › Formularios). Lógica en DisenadorFormularios.razor.cs. *@
@namespace SigWeb.Components.Catalogos
@using SigWeb.Data.Formularios
@using SigWeb.Models

<div class="df">
    <aside class="df-mods">
        @foreach (var g in Grupos())
        {
            <div class="df-grupo">@g.Key</div>
            @foreach (var m in g.GroupBy(ModuloDe))
            {
                <div class="df-modulo">@m.Key</div>
                @foreach (var f in m)
                {
                    <button type="button" class="df-form @(actual?.Clave == f.Clave ? "activo" : "")" title="@f.Nombre" @onclick="() => Elegir(f)">
                        <span>@f.Nombre</span>
                        @if (versiones.TryGetValue(f.Clave, out var v)) { <span class="df-ver" title="Diseño propio, versión @v">v@(v)</span> }
                    </button>
                }
            }
        }
    </aside>

    <section class="df-centro">
        @if (actual is null)
        {
            <div class="df-vacio"><Ico Nombre="formularios" /> Elija un formulario a la izquierda.</div>
        }
        else
        {
            <div class="df-fija">
            <div class="df-barra">
                <div class="df-tit">
                    <span>@actual.Nombre</span>
                    <small>@ModuloDe(actual) · @(versiones.TryGetValue(actual.Clave, out var va) ? $"versión {va}" : "diseño original")</small>
                </div>
                @if (HayCambios) { <span class="df-pend" title="Cambios sin guardar">● sin guardar</span> }
                <div class="df-acciones">
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Deshacer" disabled="@(deshacer.Count == 0)" @onclick="Deshacer">↶</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Agregar paso" disabled="@(estructura is null)" @onclick="AgregarPaso"><Ico Nombre="sangria-mas" /></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary @(verNuevo ? "active" : "")" title="Campo nuevo" disabled="@(estructura is null)" @onclick="AbrirNuevo"><Ico Nombre="agregar" /></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary @(verHistorial ? "active" : "")" title="Versiones del diseño" @onclick="AbrirHistorial"><Ico Nombre="versiones" /></button>
                    <button type="button" class="btn btn-sm @(confirmarRestablecer ? "btn-danger" : "btn-outline-secondary")" title="@(confirmarRestablecer ? "Clic otra vez para volver al formulario original" : "Restablecer el formulario original")" @onclick="Restablecer"><Ico Nombre="restaurar" /></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Descartar cambios" disabled="@(!HayCambios)" @onclick="Descartar"><Ico Nombre="cancelar" /></button>
                    <button type="button" class="btn btn-sm btn-primary" title="Guardar (versión nueva)" disabled="@(!HayCambios || ocupado || !Servicio.Disponible)" @onclick="PedirGuardar"><Ico Nombre="guardar" /></button>
                </div>
            </div>

            @if (!Servicio.Disponible)
            {
                <div class="alert alert-warning py-1 small">Falta aplicar la migración <code>DisenoFormularios</code>: se puede diseñar, pero no guardar. Los formularios siguen como siempre.</div>
            }
            @if (mensaje != "")
            {
                <div @key="avisoN" class="alert @(error ? "alert-warning" : "alert-success") py-1 small">@mensaje</div>
            }
            @if (pedirMotivo)
            {
                <div class="frm-linea">
                    <CampoFormulario Etiqueta="Motivo del cambio (opcional)" Ancho="">
                        <input class="form-control" @bind="motivo" @bind:event="oninput" @onkeydown="@(e => { if (e.Key == "Enter") _ = Guardar(); })" />
                    </CampoFormulario>
                    <div class="frm-linea-btns">
                        <button type="button" class="btn btn-sm btn-outline-secondary frm-icono-btn" title="Cancelar" @onclick="() => pedirMotivo = false"><Ico Nombre="cancelar" /></button>
                        <button type="button" class="btn btn-sm btn-primary frm-icono-btn" title="Guardar" @onclick="Guardar"><Ico Nombre="guardar" /></button>
                    </div>
                </div>
            }
            </div>

            @if (verHistorial)
            {
                <div class="df-historial">
                    @if (historial.Count == 0) { <div class="text-muted small">Sin versiones: el formulario usa su diseño original.</div> }
                    @foreach (var h in historial)
                    {
                        var dh = DisenoModelo.DeJson<Diseno>(h.Json);
                        <div class="df-hist-fila">
                            <b>v@(h.Version)</b>
                            <span>@h.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                            <span class="text-muted">@(dh?.Original == true ? "Original" : h.Motivo ?? "")</span>
                            @if (h.Vigente) { <span class="badge text-bg-success">vigente</span> }
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" title="Traer esta versión al boceto" @onclick="() => TraerVersion(h)"><Ico Nombre="restaurar" /></button>
                        </div>
                    }
                </div>
            }

            @if (estructura is null)
            {
                <div class="df-vacio">
                    Este formulario aún no se ha abierto en esta instalación: ábralo una vez en <a href="@actual.Ruta">@ModuloDe(actual)</a>
                    (crear o editar un registro) y vuelva: el diseñador lo conocerá con todos sus campos.
                </div>
            }
            else
            {
                <div class="df-boceto ini-tablero">
                    @{ int numero = 0; var pasos = Pasos(); }
                    @foreach (var p in pasos)
                    {
                        var pe = PasoE(p.Clave);
                        var rejilla = EsRejilla(p.Clave);
                        if (!p.Bloque) numero++;
                        var idx = pasos.FindIndex(x => x.Clave == p.Clave);
                        <div @key="p.Clave" class="df-paso @(selPaso == p.Clave ? "df-sel" : "") @(p.Bloque ? "df-paso-bloque" : "") @(arrastrandoPaso == p.Clave ? "df-arrastrando" : "")"
                             @ondragover:preventDefault="true" @ondrop="() => SoltarPaso(p.Clave)">
                            <div class="df-paso-cab" @onclick="() => ElegirPaso(p.Clave)">
                                <span class="df-asa" draggable="true" data-arrastre title="Arrastrar para mover el paso" @ondragstart="() => arrastrandoPaso = p.Clave">⠿</span>
                                @if (!p.Bloque) { <span class="df-num">@numero</span> }
                                <span class="df-paso-tit">@p.Titulo</span>
                                @if (p.Bloque) { <span class="df-chip" title="Tiene botones y lógica propios: se mueve y se renombra, no se desarma">bloque</span> }
                                @if (p.Nueva) { <span class="df-chip df-chip-nuevo">nuevo</span> }
                                @if (ModuloDePaso(p.Clave) is { } modP)
                                {
                                    <span class="df-chip df-chip-ligado" title="Ligado a un módulo: sus campos marcados «Resumen» lo alimentan. Se renombra, no se quita."><Ico Nombre="enlace" /> @(SigWeb.Data.CostosNoCalidad.ModuloCostosNoCalidad.NombreModulo(modP) ?? modP)</span>
                                }
                                <span class="ms-auto d-inline-flex gap-1">
                                    <button type="button" class="ens-mini" title="Subir" disabled="@(idx == 0)" @onclick:stopPropagation="true" @onclick="() => { MoverPaso(p.Clave, -1); }"><Ico Nombre="subir" /></button>
                                    <button type="button" class="ens-mini" title="Bajar" disabled="@(idx == pasos.Count - 1)" @onclick:stopPropagation="true" @onclick="() => { MoverPaso(p.Clave, 1); }"><Ico Nombre="bajar" /></button>
                                </span>
                            </div>
                            @if (p.Bloque)
                            {
                                <div class="df-bloque-cuerpo">Contenido propio del módulo (botones, listas, adjuntos). Su lógica no cambia.</div>
                            }
                            else if (!rejilla)
                            {
                                <div class="df-libre">
                                    @foreach (var c in CamposDe(p.Clave, false))
                                    {
                                        <button type="button" class="df-chip-campo @(selCampo == c.Clave ? "df-sel" : "")" @onclick="() => ElegirCampo(c.Clave)">@EtiquetaDe(c)</button>
                                    }
                                    <span class="text-muted small">Paso con contenido propio: sus campos se renombran u ocultan; el orden lo fija el módulo.</span>
                                </div>
                            }
                            else
                            {
                                <div class="pw-panel pw-editando df-rejilla" data-rejilla-paso="@p.Clave" @ref="refsPaso[p.Clave]">
                                    @foreach (var c in CamposDe(p.Clave, false))
                                    {
                                        var n = c.CampoTablaId is null ? Nativo(c.Clave) : null;
                                        var t = Tabla(c.CampoTablaId);
                                        var obligatorio = n?.Obligatorio == true || c.Obligatorio;
                                        <div @key="c.Clave" class="pw-w df-campo @(selCampo == c.Clave ? "df-sel" : "") @(c.CampoTablaId is null ? "" : "df-nuevo")"
                                             data-w="@c.Clave" data-ancho="@c.W" data-alto="@c.H" data-minw="1" data-minh="1"
                                             @onclick="() => ElegirCampo(c.Clave)">
                                            <div class="df-mock df-t-@TipoDe(c)">
                                                <span class="df-mock-etq">
                                                    @EtiquetaDe(c)@if (obligatorio) { <b class="text-danger">*</b> }
                                                    @if (n is { Ocultable: false }) { <span class="df-candado" title="La app lo necesita: no se oculta"><Ico Nombre="candado" /></span> }
                                                </span>
                                                @if (t?.CampoPadreId is int pid && Tabla(pid) is { } padreM)
                                                {
                                                    <span class="df-condicion" title="Solo aparece con esa opción elegida">↳ si @padreM.Nombre = @t.OpcionPadre</span>
                                                }
                                                <span class="df-mock-caja"></span>
                                            </div>
                                            <span class="pw-tirador" title="Tamaño"></span>
                                        </div>
                                    }
                                </div>
                            }
                            @{ var ocultos = CamposDe(p.Clave, true).ToList(); }
                            @if (ocultos.Count > 0)
                            {
                                <div class="df-ocultos">
                                    <span>Ocultos:</span>
                                    @foreach (var c in ocultos)
                                    {
                                        <button type="button" class="df-chip-campo @(selCampo == c.Clave ? "df-sel" : "")" title="Elegir para mostrarlo" @onclick="() => ElegirCampo(c.Clave)">@EtiquetaDe(c)</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </section>

    <aside class="df-props">
        @if (actual is null || estructura is null)
        {
            <div class="text-muted small">Las propiedades del campo o paso elegido aparecen aquí.</div>
        }
        else if (verNuevo)
        {
            <h6>Campo nuevo</h6>
            <div class="df-props-campos">
                <CampoFormulario Etiqueta="Nombre" Ancho="" Obligatorio="true"><input class="form-control" @bind="ncNombre" @bind:event="oninput" /></CampoFormulario>
                <CampoFormulario Etiqueta="Paso" Ancho="">
                    <select class="form-select" @bind="ncPaso">
                        @foreach (var p in Pasos().Where(p => EsRejilla(p.Clave))) { <option value="@p.Clave">@p.Titulo</option> }
                    </select>
                </CampoFormulario>
                <CampoFormulario Etiqueta="Tipo" Ancho="">
                    <select class="form-select" @bind="ncTipo">
                        <option value="@TipoCampoTabla.Texto">Texto</option>
                        <option value="@TipoCampoTabla.Numero">Número</option>
                        <option value="@TipoCampoTabla.Fecha">Fecha</option>
                        <option value="@TipoCampoTabla.Lista">Lista desplegable</option>
                        <option value="@TipoCampoTabla.SiNo">Sí / No</option>
                        @if (!actual.PintaCamposTabla)
                        {
                            <option value="@TipoCampoTabla.Archivos">Archivos adjuntos (recuadro con «Adjuntar»)</option>
                        }
                    </select>
                </CampoFormulario>
                @if (ncTipo == TipoCampoTabla.Lista)
                {
                    <label class="form-check mb-0" title="Cada registro puede llevar varias opciones">
                        <input type="checkbox" class="form-check-input" @bind="ncMultiple" /> <span class="form-check-label">Permite varios valores</span>
                    </label>
                    <CampoFormulario Etiqueta="Opciones desde" Ancho="">
                        <select class="form-select" @bind="ncOrigen">
                            <option value="existente">Un catálogo</option>
                            <option value="opciones">Opciones solo de este campo</option>
                        </select>
                    </CampoFormulario>
                    @if (ncOrigen == "existente")
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Abre Catálogos con el módulo de este formulario; al guardar vuelve aquí" @onclick="PedirCatalogoNuevo"><Ico Nombre="agregar" /></button>
                        <CampoFormulario Etiqueta="Catálogo" Ancho="">
                            <select class="form-select" @bind="ncCatalogo">
                                <option value="">— Seleccione —</option>
                                @foreach (var (grupo, tipos) in CatalogosAgrupados())
                                {
                                    <optgroup label="@grupo">@foreach (var tc in tipos) { <option value="@tc">@tc</option> }</optgroup>
                                }
                            </select>
                        </CampoFormulario>
                    }
                    else
                    {
                        @if (ncOrigen == "nuevo")
                        {
                            <CampoFormulario Etiqueta="Nombre del catálogo" Ancho=""><input class="form-control" @bind="ncCatalogoNuevo" placeholder="@($"{actual.Nombre} — {(ncNombre == "" ? "campo" : ncNombre)}")" /></CampoFormulario>
                        }
                        <CampoFormulario Etiqueta="Opciones (una por línea)" Ancho=""><textarea class="form-control" rows="5" @bind="ncOpciones"></textarea></CampoFormulario>
                    }
                }
            </div>
            <div class="d-flex gap-2 justify-content-end mt-2">
                <button type="button" class="btn btn-sm btn-secondary" title="Cancelar" @onclick="() => verNuevo = false"><Ico Nombre="cancelar" /></button>
                <button type="button" class="btn btn-sm btn-primary" title="Crear campo" disabled="@ocupado" @onclick="CrearCampo"><Ico Nombre="agregar" /></button>
            </div>
            <p class="small text-muted mt-2 mb-0">Va al paso que elija arriba. También aparece como columna en la lista del módulo cuando el módulo la tiene.</p>
        }
        else if (selCampo is not null && Diseno(selCampo) is { } sc)
        {
            var n = sc.CampoTablaId is null ? Nativo(sc.Clave) : null;
            var t = Tabla(sc.CampoTablaId);
            <h6>@(t is null ? "Campo del formulario" : "Campo nuevo")</h6>
            <div class="df-props-campos">
                <CampoFormulario Etiqueta="Etiqueta" Ancho="">
                    <input class="form-control" value="@EtiquetaDe(sc)" placeholder="@n?.Etiqueta" @onchange="e => CambiarEtiqueta(sc, e.Value?.ToString())" />
                </CampoFormulario>
                <div class="d-flex gap-2">
                    <CampoFormulario Etiqueta="Ancho (de 12)" Ancho=""><input type="number" min="1" max="12" class="form-control" value="@sc.W" @onchange="e => CambiarTamano(sc, int.TryParse(e.Value?.ToString(), out var w) ? w : null, null)" /></CampoFormulario>
                    <CampoFormulario Etiqueta="Alto (filas)" Ancho=""><input type="number" min="1" max="8" class="form-control" value="@sc.H" @onchange="e => CambiarTamano(sc, null, int.TryParse(e.Value?.ToString(), out var h) ? h : null)" /></CampoFormulario>
                </div>
                @if (PuedeCambiarPaso(sc))
                {
                    <CampoFormulario Etiqueta="Paso" Ancho="">
                        <select class="form-select" value="@sc.Seccion" @onchange="e => MoverCampoAPaso(sc, e.Value?.ToString() ?? sc.Seccion)">
                            @foreach (var p in Pasos().Where(p => EsRejilla(p.Clave))) { <option value="@p.Clave">@p.Titulo</option> }
                        </select>
                    </CampoFormulario>
                }
                else
                {
                    <div class="small text-muted">Está en un paso con contenido propio: se queda en él.</div>
                }
                @if (t is not null)
                {
                    <div class="df-dato"><span>Tipo</span><b>@(t.Tipo switch { TipoCampoTabla.Lista => t.Multiple ? "Lista (varios valores)" : "Lista desplegable", TipoCampoTabla.Archivos => "Archivos adjuntos", TipoCampoTabla.Numero => "Número", TipoCampoTabla.Fecha => "Fecha", TipoCampoTabla.SiNo => "Sí / No", _ => "Texto" })</b></div>
                    @if (t.Tipo == TipoCampoTabla.Lista)
                    {
                        <label class="form-check mb-0" title="Cada registro puede llevar varias opciones (también en la columna de la tabla)">
                            <input type="checkbox" class="form-check-input" checked="@t.Multiple" @onchange="e => CambiarMultiple(t, e.Value is true)" /> <span class="form-check-label">Permite varios valores</span>
                        </label>
                    }
                    @if (t.CampoPadreId is int padreId && Tabla(padreId) is { } padreT)
                    {
                        <CampoFormulario Etiqueta="@($"Aparece cuando «{padreT.Nombre}» es")" Ancho="">
                            <select class="form-select" value="@t.OpcionPadre" @onchange="e => CambiarCondicion(t, e.Value?.ToString())">
                                @foreach (var op in OpcionesDeLista(padreT)) { <option value="@op">@op</option> }
                                @if (t.OpcionPadre is not null && !OpcionesDeLista(padreT).Contains(t.OpcionPadre)) { <option value="@t.OpcionPadre">@t.OpcionPadre</option> }
                                <option value="">— Siempre (quitar la condición) —</option>
                            </select>
                        </CampoFormulario>
                    }
                    @if (t.Tipo == TipoCampoTabla.Lista)
                    {
                        var ops = OpcionesDeLista(t);
                        <div class="df-dep">
                            <div class="df-dep-tit">Campos según la opción</div>
                            @if (ops.Count == 0) { <div class="small text-muted">La lista aún no tiene opciones.</div> }
                            @foreach (var pl in PlantillasDe(t))
                            {
                                var plt = pl;
                                <div class="df-dep-fila df-dep-todas">
                                    <span class="df-dep-op" title="Todas las opciones, también las que se agreguen después">Todas</span>
                                    <button type="button" class="df-chip-campo" title="Elegir: un campo por cada opción («@plt.Nombre - …»)" @onclick="() => ElegirPlantilla(plt)">@plt.Nombre</button>
                                </div>
                            }
                            @foreach (var op in ops)
                            {
                                var opcion = op;
                                <div class="df-dep-fila">
                                    <span class="df-dep-op" title="@opcion">@opcion</span>
                                    @foreach (var h in HijosDe(t, opcion))
                                    {
                                        var hijo = h;
                                        <button type="button" class="df-chip-campo" title="Elegir este campo" @onclick="() => ElegirCampo(DisenoModelo.ClaveNuevo(hijo.Id))">@SigWeb.Data.Tablas.MotorTabla.EtiquetaCampo(hijo)</button>
                                    }
                                    @if (depOpcion == opcion)
                                    {
                                        <div class="df-dep-nuevo">
                                            <input class="form-control form-control-sm" placeholder="Nombre del campo" @bind="depNombre" @bind:event="oninput" />
                                            <select class="form-select form-select-sm" @bind="depTipo">
                                                <option value="@TipoCampoTabla.Texto">Texto</option>
                                                <option value="@TipoCampoTabla.Numero">Número</option>
                                                <option value="@TipoCampoTabla.Fecha">Fecha</option>
                                                <option value="@TipoCampoTabla.SiNo">Sí / No</option>
                                                @if (!actual!.PintaCamposTabla) { <option value="@TipoCampoTabla.Archivos">Archivos adjuntos</option> }
                                            </select>
                                            <button type="button" class="ens-mini" title="Cancelar" @onclick="() => depOpcion = null"><Ico Nombre="cancelar" /></button>
                                            <button type="button" class="ens-mini" title="Crear el campo para esta opción" @onclick="() => CrearDependiente(t, opcion)"><Ico Nombre="guardar" /></button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="ens-mini ms-auto" title="@($"Agregar un campo que aparece con «{opcion}»")" @onclick="() => AbrirDependiente(opcion)"><Ico Nombre="agregar" /></button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (t.Tipo == TipoCampoTabla.Lista && t.CatalogoTipo is null)
                    {
                        <CampoFormulario Etiqueta="Opciones (una por línea)" Ancho=""><textarea class="form-control" rows="4" @onchange="e => CambiarOpciones(t, e.Value?.ToString())">@t.Opciones</textarea></CampoFormulario>
                    }
                    <label class="form-check mt-1"><input type="checkbox" class="form-check-input" checked="@sc.Obligatorio" @onchange="e => CambiarObligatorio(sc, e.Value is true)" /> <span class="form-check-label">Obligatorio</span></label>
                    <label class="form-check mb-0" title="@TituloResumen(sc, t)">
                        <input type="checkbox" class="form-check-input" checked="@(CamposPorOpcion.EsPlantilla(t) ? CamposPorOpcion.HijosDe(t, camposTabla).Any(h => h.EnResumen) : t.EnResumen)" @onchange="e => CambiarResumen(t, e.Value is true)" /> <span class="form-check-label">Resumen</span>
                    </label>
                }
                <label class="form-check">
                    <input type="checkbox" class="form-check-input" checked="@sc.Oculto" disabled="@(n is { Ocultable: false })" @onchange="e => CambiarOculto(sc, e.Value is true)" />
                    <span class="form-check-label">Ocultar en el formulario</span>
                </label>
                @if (n is { Ocultable: false })
                {
                    <div class="small text-muted"><Ico Nombre="candado" /> @(n.Obligatorio ? "Obligatorio" : n.Destacado ? "Campo principal" : "La lógica del módulo lo usa"): se mueve y se renombra, pero no se oculta.</div>
                }
                @{ var cat = t?.CatalogoTipo ?? n?.Catalogo; }
                @if (t is null && n?.Catalogo is not null)
                {
                    <div class="small text-muted">Lista del módulo: si acepta uno o varios valores lo fija su lógica (no se cambia aquí).</div>
                }
                @if (cat is not null)
                {
                    <div class="df-dato"><span>Opciones del catálogo</span><b>@cat</b></div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Abrir el catálogo para agregar, renombrar u ordenar opciones" @onclick="() => GestionarCatalogo(cat)"><Ico Nombre="catalogos" /></button>
                    <div class="small text-muted">Renombrar una opción allí actualiza los registros que ya la usan.</div>
                }
                @if (t is not null)
                {
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Quitar del formulario (el campo sigue en la tabla)" @onclick="() => QuitarDelFormulario(sc)"><Ico Nombre="cancelar" /></button>
                        <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar el campo (va a la Papelera con sus valores)" @onclick="() => PedirBorrarCampo(sc)"><Ico Nombre="eliminar" /></button>
                    </div>
                }
            </div>
        }
        else if (selPaso is not null && trabajo.Secciones.FirstOrDefault(s => s.Clave == selPaso) is { } sp)
        {
            var pe = PasoE(sp.Clave);
            <h6>@(pe?.Bloque == true ? "Bloque" : "Paso")</h6>
            <div class="df-props-campos">
                <CampoFormulario Etiqueta="Nombre" Ancho="">
                    <input class="form-control" value="@(sp.Titulo ?? pe?.Titulo)" placeholder="@pe?.Titulo" @onchange="e => CambiarTituloPaso(sp.Clave, e.Value?.ToString())" />
                </CampoFormulario>
                @if (pe is not null && sp.Titulo is not null)
                {
                    <div class="small text-muted">En el código: «@pe.Titulo».</div>
                }
                @if (sp.Nueva && ModulosLigables().Any())
                {
                    <CampoFormulario Etiqueta="Módulo que lo lee" Ancho="">
                        <select class="form-select" value="@(sp.Modulo ?? "")" @onchange="e => LigarModulo(sp.Clave, e.Value?.ToString())">
                            <option value="">— Ninguno —</option>
                            @foreach (var m in ModulosLigables()) { <option value="@m.Clave">@m.Nombre</option> }
                        </select>
                    </CampoFormulario>
                }
                @if (sp.Nueva && sp.Modulo is not null)
                {
                    <div class="small text-muted"><Ico Nombre="candado" /> Ligado a @SigWeb.Data.CostosNoCalidad.ModuloCostosNoCalidad.NombreModulo(sp.Modulo): se renombra, pero no se quita ni se pierde al restablecer. El módulo toma los campos de este paso marcados «Resumen» (numéricos = costos; los demás = datos para agrupar).</div>
                }
                else if (sp.Nueva)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" title="Quitar el paso (sus campos pasan al primer paso)" @onclick="() => QuitarPaso(sp.Clave)"><Ico Nombre="eliminar" /></button>
                }
                else if (pe?.Bloque == true)
                {
                    <div class="small text-muted">Bloque con lógica propia: se mueve (asa ⠿ o flechas) y se renombra.</div>
                }
            </div>
        }
        else
        {
            <div class="text-muted small mb-2">Elija un campo o un paso del boceto. Arrastre los campos (también a otro paso) y estírelos con la esquina; arrastre los pasos con ⠿.</div>
        }

        @if (actual is not null && estructura is not null && !verNuevo)
        {
            var disp = Disponibles().ToList();
            @if (disp.Count > 0)
            {
                <h6 class="mt-3">Campos de la tabla sin usar</h6>
                <div class="df-disp">
                    @foreach (var d in disp)
                    {
                        <button type="button" class="df-chip-campo" title="Agregar al paso elegido" @onclick="() => AgregarDisponible(d)"><Ico Nombre="agregar" /> @d.Nombre</button>
                    }
                </div>
            }
        }
    </aside>
</div>

@if (CampoABorrar is { } cb)
{
    <div class="modal-backdrop-custom" @onclick="CancelarBorrarCampo">
        <div class="modal-box-custom" style="max-width: 560px;" @onclick:stopPropagation="true">
            <h5 class="d-flex align-items-center gap-2"><Ico Nombre="eliminar" /> Eliminar campo</h5>
            <SigWeb.Components.Pages.PanelImpacto Informe="impactoBorrar" OnEntendido="@(v => impactoBorrarOk = v)" />
            <div class="frm-pie frm-pie-plano">
                <button type="button" class="btn btn-secondary btn-sm" title="Cancelar" @onclick="CancelarBorrarCampo"><Ico Nombre="cancelar" /></button>
                <button type="button" data-texto="Eliminar" class="btn btn-danger btn-sm" title="Eliminar (va a la Papelera)"
                        disabled="@(impactoBorrar is null || (impactoBorrar.RequiereEntender && !impactoBorrarOk))" @onclick="() => BorrarCampo(cb)"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}

@if (preguntaTodas is { } pq)
{
    <div class="modal-backdrop-custom">
        <div class="modal-box-custom df-todas" style="max-width: 520px;">
            <h5 class="d-flex align-items-center gap-2"><Ico Nombre="formularios" /> «@pq.Base» para @pq.Opcion</h5>
            <p class="mb-2">¿Aplicar este campo a las demás opciones de la lista, incluidas las que se agreguen después?</p>
            <div class="df-todas-op">
                <button type="button" class="df-todas-btn activo" title="Cada opción tendrá su campo «@pq.Base - opción» y las nuevas lo recibirán solas" @onclick="AplicarATodasAsync">
                    <Ico Nombre="seleccionar-todo" /><span><b>Todas las opciones</b><small>También las que se agreguen después</small></span>
                </button>
                <button type="button" class="df-todas-btn" title="Solo esta opción; las demás se agregan con ＋ en cada una" @onclick="UnoPorUno">
                    <Ico Nombre="editar" /><span><b>Uno por uno</b><small>Las demás opciones, manualmente</small></span>
                </button>
            </div>
            <div class="frm-pie frm-pie-plano">
                <button type="button" class="btn btn-secondary btn-sm" title="Cancelar (no se crea el campo)" @onclick="CancelarPregunta"><Ico Nombre="cancelar" /></button>
            </div>
        </div>
    </div>
}
