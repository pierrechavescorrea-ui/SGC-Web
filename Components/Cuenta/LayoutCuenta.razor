@inherits LayoutComponentBase
@inject IConfiguration Cfg
@* Páginas de cuenta: una sola lámina (img/login/escena.svg, generada con tools/login/escena_login.py desde los modelos 3D):
   a la izquierda, la vista desde adentro de una torre AAE mirando hacia arriba; detrás del formulario (vidrio), la planta de
   una torre BE como rosetón que gira despacio. Un brazo de la vista interior llega al rosetón: es una sola composición. *@
<div class="cu">
    <img class="cu-escena" src="img/login/escena.svg" width="1600" height="900" alt="" aria-hidden="true" />
    <div class="cu-vineta" aria-hidden="true"></div>

    <header class="cu-marca">
        <div class="cu-sobre">Sistema de gestión de calidad</div>
        <div class="cu-nombre">SGC<span>Web</span></div>
        <div class="cu-regla"></div>
        <div class="cu-lema">Líneas de transmisión</div>
    </header>

    <main class="cu-panel">
        <div class="cu-caja">
            @Body
        </div>
    </main>

    <footer class="cu-pie">
        @* Logo de la empresa (el mismo de la app, Administración › Sistema) en un marco de vidrio como el formulario. *@
        <div class="cu-logo" title="@Empresa">
            @if (!string.IsNullOrEmpty(Logo.Url))
            {
                <img src="@Logo.Url" alt="@Empresa" />
            }
            else
            {
                <span class="cu-logo-txt">@Empresa</span>
            }
        </div>
        <a href="privacidad">Tratamiento de datos</a>
        @* Firma «πr» (π + r = Pier): círculo en contorno con π cursiva serif y r sans pegadas. Letras convertidas a trazos
           (π de Liberation Serif Italic, r de Liberation Sans) para no depender de fuentes; color = texto del tema. *@
        <div class="cu-firma" aria-label="πr" title="πr">
            <svg viewBox="0 0 120 120" width="34" height="34" fill="none" aria-hidden="true">
                <circle cx="60" cy="60" r="58" stroke="currentColor" stroke-width="4" />
                <path fill="currentColor" d="M59.24 71.83Q59.24 73.28 59.82 74Q60.4 74.73 61.34 74.73Q63.27 74.73 65.34 73.76L66.01 75.28Q64.5 76.44 62.74 77.26Q60.98 78.08 58.76 78.08Q56.47 78.08 55.17 76.53Q53.86 74.99 53.86 72.21Q53.86 70.73 54.38 67.8L57.54 49.85H48.32L44.77 64.45Q42.81 72.6 41.1 77.43H35.2L35.46 75.98Q37.98 73.83 39.14 71.63Q40.3 69.44 41.46 64.9L45.23 49.85H40.91L38.65 53.97H36.81L38.68 47.14H69.43L68.94 49.85H62.89L59.79 67.54Q59.24 70.28 59.24 71.83ZM68.49 77.43V50.69Q68.49 47.01 68.3 42.57H73.77Q74.03 48.5 74.03 49.69H74.16Q75.55 45.21 77.35 43.56Q79.16 41.92 82.44 41.92Q83.6 41.92 84.8 42.24V47.56Q83.64 47.24 81.7 47.24Q78.09 47.24 76.19 50.35Q74.29 53.46 74.29 59.26V77.43Z" />
            </svg>
        </div>
    </footer>
</div>

@code {
    [Inject] private SigWeb.Data.Seguridad.LogoApp Logo { get; set; } = default!;
    private string Empresa => Cfg["Marca:Empresa"] ?? "Ingeniería Demo S.A.S.";
}
