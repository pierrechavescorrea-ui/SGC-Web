    private static RenderFragment IconoArchivo(string nombre) => __builder =>
    {
        var ext = Path.GetExtension(nombre).ToLowerInvariant();
        var (ico, clase) = ext switch
        {
            ".pdf" => ("PDF", "vr-ext-pdf"),
            ".xls" or ".xlsx" or ".xlsm" or ".csv" => ("XLS", "vr-ext-xls"),
            ".doc" or ".docx" or ".odt" or ".rtf" => ("DOC", "vr-ext-doc"),
            ".ppt" or ".pptx" => ("PPT", "vr-ext-ppt"),
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp" or ".heic" => ("IMG", "vr-ext-img"),
            ".dwg" or ".dxf" => ("CAD", "vr-ext-cad"),
            ".zip" or ".rar" or ".7z" => ("ZIP", "vr-ext-zip"),
            ".mp4" or ".mov" or ".avi" => ("VID", "vr-ext-vid"),
            _ => (ext.Length > 1 ? ext[1..Math.Min(ext.Length, 4)].ToUpperInvariant() : "ARC", "vr-ext-otro")
        };
        <span class="vr-ext @clase">@ico</span>
    };

    // ---------- Pasos del formulario con sus campos y valores ----------
    private RenderFragment FragPasos(List<string> pasos, PlanAccion p) => __builder =>
    {
        var varios = pasos.Count > 1;
        foreach (var pp in pasosPlan.Where(x => pasos.Contains(x.Clave)))
        {
            var na = pasosNa.TryGetValue(p.Id, out var nas) && nas.Contains(pp.Clave);
            <div class="vr-paso @(na ? "vr-paso-na" : "")">
                @if (varios || na) { <div class="vr-paso-tit">@pp.Titulo @if (na) { <span class="frm-na-chip">No aplica</span> }</div> }
                @if (na) { }
                else if (pp.Bloque)
                {
                    if (pp.Clave.Contains("Acciones", StringComparison.OrdinalIgnoreCase)) { @FragAcciones(p) }
                    else if (pp.Clave.Contains("eficacia", StringComparison.OrdinalIgnoreCase)) { @FragEficacia(p) }
                }
                else
                {
                    var campos = camposPlan.Where(c => c.Value.Seccion == pp.Clave && !c.Value.U.Oculto && CampoVisible(c.Key, p) && TieneValor(c.Key, p))
                        .OrderBy(c => c.Value.U.Y).ThenBy(c => c.Value.U.X).ToList();
                    <dl class="vr-campos">
                        @foreach (var c in campos)
                        {
                            <div class="vr-campo" style="--vw:@c.Value.U.W"><dt>@EtiquetaCampoPlan(c.Key)</dt><dd>@FragValorCampo(c.Key, p)</dd></div>
                        }
                        @if (campos.Count == 0) { <span class="text-muted small">Sin datos diligenciados.</span> }
                    </dl>
                }
            </div>
        }
    };

    private CampoTabla? CampoNuevoPlan(string? clave) =>
        clave is not null && clave.StartsWith("c:") && int.TryParse(clave[2..], out var id) ? motor?.Campos.FirstOrDefault(c => c.Id == id) : null;

    private string EtiquetaCampoPlan(string? clave)
    {
        if (clave is null) return "Campo";
        var d = disenoPlan?.Campos.FirstOrDefault(c => c.Clave == clave);
        if (!string.IsNullOrWhiteSpace(d?.Etiqueta)) return d!.Etiqueta!;
        if (CampoNuevoPlan(clave) is { } ct) return MotorTabla.EtiquetaCampo(ct);
        return estructuraPlan.Campos.FirstOrDefault(c => c.Clave == clave)?.Etiqueta ?? clave;
    }

    // El widget de pasos muestra solo los campos diligenciados (muchos no aplican en cada plan).
    private bool TieneValor(string clave, PlanAccion p)
    {
        if (CampoNuevoPlan(clave) is { } cp && SigWeb.Data.Formularios.CamposPorOpcion.EsPlantilla(cp))
            return SigWeb.Data.Formularios.CamposPorOpcion.HijosDe(cp, motor!.Campos).Any(h => !string.IsNullOrWhiteSpace(motor.Texto(p.Id, h, out _)));
        if (CampoNuevoPlan(clave) is { } ct)
            return ct.Tipo == TipoCampoTabla.Archivos
                ? archivosCampo.Any(a => a.CampoTablaId == ct.Id && a.FilaId == p.Id)
                : !string.IsNullOrWhiteSpace(motor!.Texto(p.Id, ct, out _));
        var etq = estructuraPlan.Campos.FirstOrDefault(c => c.Clave == clave)?.Etiqueta ?? "";
        return etq switch
        {
            "Código" or "Fecha" => true,
            "Origen del hallazgo" => !string.IsNullOrWhiteSpace(p.OrigenHallazgo),
            "Tipo de hallazgo" => !string.IsNullOrWhiteSpace(p.TipoHallazgo),
            "Descripción del hallazgo" => !string.IsNullOrWhiteSpace(p.DescripcionHallazgo),
            "Análisis de causa" => !string.IsNullOrWhiteSpace(p.AnalisisCausa) || !string.IsNullOrWhiteSpace(p.AnalisisCausaSvg),
            "Procesos" => SelectorMultiple.Leer(p.Proceso).Count > 0,
            "Nombre" => !string.IsNullOrWhiteSpace(p.ReportoNombre),
            "Cargo" => !string.IsNullOrWhiteSpace(p.ReportoCargo),
            "Empresa" => !string.IsNullOrWhiteSpace(p.ReportoEmpresa),
            "Lugares" => LugaresDe(p.Id).Any(),
            "Riesgos" => riesgosDePlan.TryGetValue(p.Id, out var rs) && rs.Count > 0,
            _ => false
        };
    }

    // Campo ligado a una opción: solo se muestra si su campo padre tiene esa opción.
    private bool CampoVisible(string clave, PlanAccion p)
    {
        if (CampoNuevoPlan(clave) is not { CampoPadreId: int padre } c || string.IsNullOrWhiteSpace(c.OpcionPadre) || motor is null) return true;
        var cp = motor.Campos.FirstOrDefault(x => x.Id == padre);
        if (cp is null) return true;
        return MotorTabla.Partes(motor.Texto(p.Id, cp, out _)).Contains(c.OpcionPadre!, StringComparer.OrdinalIgnoreCase);
    }

    private RenderFragment FragValorCampo(string? clave, PlanAccion p) => __builder =>
    {
        if (clave is null) { <span>—</span> return; }
        if (CampoNuevoPlan(clave) is { } cpl && SigWeb.Data.Formularios.CamposPorOpcion.EsPlantilla(cpl))
        {
            // Un valor por opción ("Valor - Humanos"…): opción y valor de cada uno con dato.
            var filasOp = SigWeb.Data.Formularios.CamposPorOpcion.HijosDe(cpl, motor!.Campos)
                .Select(h => (Op: h.OpcionPadre, V: motor.Texto(p.Id, h, out _))).Where(x => !string.IsNullOrWhiteSpace(x.V)).ToList();
            @if (filasOp.Count == 0) { <span>—</span> }
            else { <span class="ind-chips">@foreach (var f in filasOp) { <span class="ind-chip">@f.Op: @f.V</span> }</span> }
            return;
        }
        if (CampoNuevoPlan(clave) is { } ct)
        {
            if (ct.Tipo == TipoCampoTabla.Archivos)
            {
                var arch = archivosCampo.Where(a => a.CampoTablaId == ct.Id && a.FilaId == p.Id).ToList();
                @foreach (var a in arch) { <a class="vr-archivo" href="@a.RutaArchivo" target="_blank" rel="noopener">@IconoArchivo(a.NombreOriginal) <span>@a.NombreOriginal</span></a> }
                @if (arch.Count == 0) { <span>—</span> }
                return;
            }
            var texto = motor!.Texto(p.Id, ct, out _);
            if (string.IsNullOrWhiteSpace(texto)) { <span>—</span> return; }
            if (ct.Tipo == TipoCampoTabla.Lista)
            {
                <span class="ind-chips">
                    @foreach (var v in ct.Multiple ? MotorTabla.Partes(texto) : new List<string> { texto })
                    {
                        @if (ct.CatalogoTipo is not null) { <ValorCatalogo Tipo="@ct.CatalogoTipo" Valor="@v" ClaseSinFormato="ind-chip" /> }
                        else { <span class="ind-chip">@v</span> }
                    }
                </span>
                return;
            }
            <span class="rg-multi">@texto</span>
            return;
        }
        var etq = estructuraPlan.Campos.FirstOrDefault(c => c.Clave == clave)?.Etiqueta ?? "";
        switch (etq)
        {
            case "Código": <span>@p.Codigo</span> break;
            case "Fecha": <span>@p.Fecha.ToString("dd/MM/yyyy")</span> break;
            case "Origen del hallazgo": @if (string.IsNullOrWhiteSpace(p.OrigenHallazgo)) { <span>—</span> } else { <ValorCatalogo Tipo="@SembradorCatalogosRiesgo.OrigenHallazgo" Valor="@p.OrigenHallazgo" /> } break;
            case "Tipo de hallazgo": @if (string.IsNullOrWhiteSpace(p.TipoHallazgo)) { <span>—</span> } else { <ValorCatalogo Tipo="@SembradorCatalogosRiesgo.TipoHallazgo" Valor="@p.TipoHallazgo" /> } break;
            case "Descripción del hallazgo": <span class="rg-multi">@(string.IsNullOrWhiteSpace(p.DescripcionHallazgo) ? "—" : p.DescripcionHallazgo)</span> break;
            case "Análisis de causa": @FragAnalisisCausa(p, false) break;
            case "Procesos":
                var procs = SelectorMultiple.Leer(p.Proceso);
                <span class="ind-chips">@foreach (var pr in procs) { <span class="ind-chip">@pr</span> }@if (procs.Count == 0) { <span>—</span> }</span>
                break;
            case "Lugares": @FragLugares(p) break;
            case "Riesgos": @FragRiesgos(p) break;
            case "Nombre": <span>@(string.IsNullOrWhiteSpace(p.ReportoNombre) ? "—" : p.ReportoNombre)</span> break;
            case "Cargo": <span>@(string.IsNullOrWhiteSpace(p.ReportoCargo) ? "—" : p.ReportoCargo)</span> break;
            case "Empresa": <span>@(string.IsNullOrWhiteSpace(p.ReportoEmpresa) ? "—" : p.ReportoEmpresa)</span> break;
            default: <span>—</span> break;
        }
    };

