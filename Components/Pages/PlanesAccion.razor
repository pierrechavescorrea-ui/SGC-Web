    // Todas las carpetas del plan con sus archivos, ícono según el tipo de archivo.
    private RenderFragment FragAdjuntos(PlanAccion p) => __builder =>
    {
        var carpetas = CarpetasVista(p.Id).Where(c => c.Archivos.Count > 0).ToList();
        @if (carpetas.Count == 0) { <span class="text-muted small">Sin adjuntos.</span> }
