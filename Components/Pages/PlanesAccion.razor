    // ---------- Formulario ----------
    private async Task GuardarAsync()
    {
        if (form is null) return;
        guardando = true;
        await _dbLock.WaitAsync();
        try
        {
            var nuevo = form.Plan.Id == 0;
            var auditoriaId = form.Plan.AuditoriaId;
            var id = await Servicio.GuardarAsync(form);
            mensaje = nuevo
                ? $"El plan {form.Plan.Codigo.Trim()} se creó correctamente y está en el módulo Planes de acción."
                : "Plan guardado.";
            error = false;
            if (nuevo && auditoriaId is int aid)
                await JS.InvokeVoidAsync("sessionStorage.setItem", $"sigweb.auditoria.{aid}.planCreado", mensaje);
            // Guardar cierra el formulario y vuelve a la pantalla de donde se abrió (lista, hoja de vida,
            // riesgo, auditoría…), con su vista y selección (regla general de formularios).
            await JS.VolverAsync(RespaldoAtras);
        }
        catch (InvalidOperationException ex) { Db.ChangeTracker.Clear(); mensaje = ex.Message; error = true; }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo guardar el plan: inténtalo de nuevo. (" + ex.Message + ")"; error = true;
        }
        finally { guardando = false; _dbLock.Release(); }
    }

