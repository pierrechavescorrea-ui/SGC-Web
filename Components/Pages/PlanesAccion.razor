            <dd>@foreach (var s in soportes) { <a class="vr-archivo" href="@s.RutaArchivo" target="_blank" rel="noopener">@IconoArchivo(s.NombreOriginal) @s.NombreOriginal</a> }@if (soportes.Count == 0) { <span>—</span> }</dd>
