    // =====================================================================
    // Vistas configurables de "Plan por plan" (widgets como el panel de Inicio). La "Clásica" es la vista de siempre;
    // las demás se guardan en VistasRegistro (Configuración › Catálogos › Vistas) y se diseñan aquí (?disenarVista=id|nueva)
    // con el plan real a la vista. Cada navegador recuerda la vista elegida (localStorage).
    // =====================================================================
    private const string ModuloVista = "planes-accion", ClaveVistaLocal = "sigweb.vista.planes-accion";
    private List<VistaRegistro> vistasPlan = new();
    private int vistaPlanId = VistasModelo.IdClasica;
    private bool vistaLeida, disenandoVista;
    private int vistaEditId;
    private string vistaEditNombre = "";
    private List<Widget> vistaWidgets = new();
    private string? widgetSel;
    private ElementReference refPanelVista;
    private DotNetObjectReference<PlanesAccion>? yoVista;
    private string? mensajeVista;
    // Formulario del plan (para los widgets de pasos y campos): estructura, diseño, pasos y ubicación de cada campo.
    private Estructura estructuraPlan = new();
    private Diseno? disenoPlan;
    private List<(string Clave, string Titulo, bool Bloque, bool Nueva)> pasosPlan = new();
    private Dictionary<string, (string Seccion, Ubicacion U)> camposPlan = new();

    private bool MostrandoPanelVista => vistaPlanes == "plan" && !modoEdicion && (vistaPlanId != VistasModelo.IdClasica || disenandoVista) && Mostrados.Any();

    private List<Widget> VistaActual() =>
        disenandoVista ? vistaWidgets
        : vistasPlan.FirstOrDefault(v => v.Id == vistaPlanId) is { } v ? VistasModelo.Leer(v.Json) : VistasModelo.InicialPlan();

    private string VistaJson() => System.Text.Json.JsonSerializer.Serialize(VistaActual().Select(w => new { id = w.Id, x = w.X, y = w.Y, w = w.W, h = w.H }));

    private async Task CargarVistasAsync(Dictionary<string, Microsoft.Extensions.Primitives.StringValues> q)
    {
        yoVista ??= DotNetObjectReference.Create(this);
        vistasPlan = await VistasModelo.ListarAsync(Db, ModuloVista);
        try
        {
            estructuraPlan = await ServicioForm.EstructuraAsync("planes-accion") ?? new Estructura();
            disenoPlan = await ServicioForm.DisenoAsync("planes-accion");
            pasosPlan = DisenoModelo.Pasos(estructuraPlan, disenoPlan);
            camposPlan = DisenoModelo.Disponer(estructuraPlan, disenoPlan);
        }
        catch { }
        if (q.TryGetValue("disenarVista", out var dv))
        {
            var val = dv.ToString();
            disenandoVista = true; vistaPlanes = "plan"; widgetSel = null; mensajeVista = null;
            if (int.TryParse(val, out var id) && vistasPlan.FirstOrDefault(v => v.Id == id) is { } v)
            { vistaEditId = v.Id; vistaEditNombre = v.Nombre; vistaWidgets = VistasModelo.Leer(v.Json); }
            else
            { vistaEditId = 0; vistaEditNombre = "Vista nueva"; vistaWidgets = VistasModelo.InicialPlan(); }
        }
        else disenandoVista = false;
    }

    private async Task LeerVistaElegidaAsync()
    {
        string? guardada = null;
        try { guardada = await JS.InvokeAsync<string?>("localStorage.getItem", ClaveVistaLocal); } catch { }
        var id = int.TryParse(guardada, out var g) && (g == VistasModelo.IdClasica || vistasPlan.Any(v => v.Id == g)) ? g
            : vistasPlan.FirstOrDefault(v => v.Predeterminada)?.Id ?? VistasModelo.IdClasica;
        if (id != vistaPlanId) { vistaPlanId = id; StateHasChanged(); }
    }

    private async Task CambiarVistaAsync(int id)
    {
        vistaPlanId = id;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ClaveVistaLocal, vistaPlanId.ToString()); } catch { }
        StateHasChanged();
    }

    // Vistas del detalle en el menú del ícono del encabezado: solo en la vista Plan, fuera de edición y de diseño.
    private string? firmaMenuVista;
    private void SincronizarMenuVista()
    {
        var mostrar = vistaPlanes == "plan" && !modoEdicion && !disenandoVista && form is null;
        var firma = mostrar ? $"{vistaPlanId}|{string.Join(",", vistasPlan.Select(v => v.Id + v.Nombre + v.Predeterminada))}" : null;
        if (firma == firmaMenuVista) return;
        firmaMenuVista = firma;
        if (!mostrar) { MenuIco.Quitar(this); return; }
        MenuIco.Registrar(new SigWeb.Data.Navegacion.MenuIcono.Menu
        {
            Titulo = "Vista del plan", Dueno = this, Actual = vistaPlanId.ToString(),
            Opciones = vistasPlan.Select(v => new SigWeb.Data.Navegacion.MenuIcono.Opcion(v.Id.ToString(), v.Nombre, null, v.Predeterminada))
                .Prepend(new SigWeb.Data.Navegacion.MenuIcono.Opcion(VistasModelo.IdClasica.ToString(), VistasModelo.NombreClasica, "La pantalla de siempre")).ToList(),
            Elegir = c => InvokeAsync(() => CambiarVistaAsync(int.TryParse(c, out var i) ? i : VistasModelo.IdClasica)),
            EnlaceGestion = "editor?pestana=vistas", TituloGestion = "Crear y diseñar vistas",
        });
    }

    // Movimientos y tamaños desde el motor de rejilla (modo diseño).
    [JSInvokable]
    public Task MovidaVista(string json)
    {
        if (!disenandoVista) return Task.CompletedTask;
        foreach (var e in System.Text.Json.JsonDocument.Parse(json).RootElement.EnumerateArray())
        {
            var w = vistaWidgets.FirstOrDefault(x => x.Id == e.GetProperty("id").GetString());
            if (w is null) continue;
            w.X = e.GetProperty("x").GetInt32(); w.Y = e.GetProperty("y").GetInt32(); w.W = e.GetProperty("w").GetInt32(); w.H = e.GetProperty("h").GetInt32();
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void AgregarWidget(TipoWidget t)
    {
        var (x, y) = DisenoModelo.Hueco(vistaWidgets.Select(o => (o.X, o.Y, o.W, o.H)).ToList(), t.W, t.H);
        var w = new Widget { Tipo = t.Tipo, X = x, Y = y, W = t.W, H = t.H };
        if (t.Tipo == "kpi") w.Kpi = "estado";
        if (t.Tipo == "pasos") w.Pasos = pasosPlan.Where(pp => !pp.Bloque).Take(1).Select(pp => pp.Clave).ToList();
        if (t.Tipo == "campo") w.Campo = camposPlan.Keys.FirstOrDefault();
        if (t.Tipo == "nota") w.Texto = "Sin nota para este plan.";
        vistaWidgets.Add(w);
        widgetSel = w.Id;
    }

    private void QuitarWidget(string id) { vistaWidgets.RemoveAll(w => w.Id == id); if (widgetSel == id) widgetSel = null; }

    private void AlternarPaso(Widget w, string clave, bool incluir)
    {
        w.Pasos.Remove(clave);
        if (incluir) { var orden = pasosPlan.Select(pp => pp.Clave).ToList(); w.Pasos.Add(clave); w.Pasos = w.Pasos.OrderBy(orden.IndexOf).ToList(); }
    }

    private async Task GuardarVista()
    {
        mensajeVista = null;
        await _dbLock.WaitAsync();
        try
        {
            await CamposDeNotasAsync();
            var id = await VistasModelo.GuardarAsync(Db, ModuloVista, vistaEditId, vistaEditNombre, vistaWidgets);
            Db.ChangeTracker.Clear();
            vistasPlan = await VistasModelo.ListarAsync(Db, ModuloVista);
            vistaPlanId = id; vistaEditId = id;
            try { await JS.InvokeVoidAsync("localStorage.setItem", ClaveVistaLocal, id.ToString()); } catch { }
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeVista = "No se pudo guardar la vista: " + ex.Message; return; }
        finally { _dbLock.Release(); }
        disenandoVista = false;
        Nav.NavigateTo("editor?pestana=vistas");   // de vuelta a Configuración › Editor › Vistas
    }

    private void CancelarDisenoVista() { disenandoVista = false; Nav.NavigateTo("editor?pestana=vistas"); }

    // ---------- Widget "nota": texto propio de cada plan ----------
    // Cada widget de nota tiene su campo oculto en la tabla de Planes ("Nota · título", no es columna visible); el texto de cada
    // plan se guarda ahí (también sale en Excel y el Dossier). Se crea al guardar la vista.
    private async Task CamposDeNotasAsync()
    {
        if (motor is null) return;
        foreach (var w in vistaWidgets.Where(w => w.Tipo == "nota" && (CampoNuevoPlan(w.Campo) is null)))
        {
            var baseNombre = "Nota · " + (string.IsNullOrWhiteSpace(w.Titulo) ? "Nota" : w.Titulo!.Trim());
            var nombre = baseNombre; var k = 2;
            while (motor.Campos.Any(c => string.Equals(c.Nombre, nombre, StringComparison.OrdinalIgnoreCase))) nombre = $"{baseNombre} {k++}";
            var id = await motor.GuardarCampoAsync(Db, new CampoTabla { Nombre = nombre, Tipo = TipoCampoTabla.Texto });
            var ent = await Db.CamposTabla.FirstAsync(c => c.Id == id);
            ent.Visible = false;
            await Db.SaveChangesAsync();
            w.Campo = $"c:{id}";
        }
    }

    private string? notaEditando;     // "{widget}:{plan}" en edición
    private string notaTexto = "";

    private async Task EditarNota(Widget w, PlanAccion p)
    {
        if (CampoNuevoPlan(w.Campo) is null) await CampoDeNotaGuardadaAsync(w);
        notaEditando = $"{w.Id}:{p.Id}";
        notaTexto = CampoNuevoPlan(w.Campo) is { } c && motor is not null ? motor.Texto(p.Id, c, out _) ?? "" : "";
    }

    // Vista guardada antes de que la nota fuera por plan: se le crea su campo ahora y se guarda la vista con él.
    private async Task CampoDeNotaGuardadaAsync(Widget w)
    {
        if (vistasPlan.FirstOrDefault(v => v.Id == vistaPlanId) is not { } vista) return;
        await _dbLock.WaitAsync();
        try
        {
            vistaWidgets = VistasModelo.Leer(vista.Json);
            await CamposDeNotasAsync();
            await VistasModelo.GuardarAsync(Db, ModuloVista, vista.Id, vista.Nombre, vistaWidgets);
            Db.ChangeTracker.Clear();
            vistasPlan = await VistasModelo.ListarAsync(Db, ModuloVista);
            if (vistaWidgets.FirstOrDefault(x => x.Id == w.Id) is { } nuevo) w.Campo = nuevo.Campo;
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeVista = "No se pudo preparar la nota: " + ex.Message; }
        finally { _dbLock.Release(); }
    }

    private async Task GuardarNota(Widget w, PlanAccion p)
    {
        if (motor is null || CampoNuevoPlan(w.Campo) is not { } c) return;
        await _dbLock.WaitAsync();
        try
        {
            await motor.GuardarValorAsync(Db, p.Id, c, string.IsNullOrWhiteSpace(notaTexto) ? null : notaTexto.Trim());
            notaEditando = null;
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeVista = "No se pudo guardar la nota: " + ex.Message; }
        finally { _dbLock.Release(); }
    }

    private RenderFragment FragNota(Widget w, PlanAccion p) => __builder =>
    {
        var c = CampoNuevoPlan(w.Campo);
        var texto = c is not null && motor is not null ? motor.Texto(p.Id, c, out _) : null;
        if (notaEditando == $"{w.Id}:{p.Id}")
        {
            <div class="vr-nota vr-nota-edicion frm-linea">
                <textarea class="form-control form-control-sm" rows="4" data-sin-flotante @bind="notaTexto" @bind:event="oninput" placeholder="@w.Texto"></textarea>
                <div class="vr-nota-acc">
                    <button type="button" class="ens-mini" title="Cancelar" @onclick="() => notaEditando = null"><Ico Nombre="cancelar" /></button>
                    <button type="button" class="ens-mini" title="Guardar la nota de este plan" @onclick="() => GuardarNota(w, p)"><Ico Nombre="guardar" /></button>
                </div>
            </div>
        }
        else
        {
            <div class="vr-nota">
                @if (string.IsNullOrWhiteSpace(texto)) { <span class="vr-nota-vacia">@w.Texto</span> }
                else { <span class="rg-multi">@texto</span> }
                @if (!disenandoVista)
                {
                    <button type="button" class="ens-mini vr-nota-editar" title="Editar la nota de este plan" @onclick:stopPropagation="true" @onclick="() => EditarNota(w, p)"><Ico Nombre="editar" /></button>
                }
            </div>
        }
    };

    private void RestablecerVista() { vistaWidgets = VistasModelo.InicialPlan(); widgetSel = null; }

    private string TituloWidget(Widget w) =>
        !string.IsNullOrWhiteSpace(w.Titulo) ? w.Titulo!
        : w.Tipo == "pasos" ? (w.Pasos.Count == 1 ? pasosPlan.FirstOrDefault(pp => pp.Clave == w.Pasos[0]).Titulo ?? "Paso" : "Pasos")
        : w.Tipo == "campo" ? EtiquetaCampoPlan(w.Campo)
        : w.Tipo == "kpi" ? VistasModelo.KpisPlan.FirstOrDefault(k => k.Clave == w.Kpi).Nombre ?? "Indicador"
        : VistasModelo.TipoDe(w.Tipo)?.Nombre ?? w.Tipo;

    // ---------- Barra: elegir vista o (en diseño) nombre y guardar ----------
    private RenderFragment SelectorVista() => __builder =>
    {
        // Fuera del diseño, el selector de vista está en el encabezado (grupo aparte); aquí solo queda el aviso.
        if (!disenandoVista && mensajeVista is null) return;
        <div class="vr-barra">
            @if (disenandoVista)
            {
                <span class="vr-dis-tit"><Ico Nombre="formularios" /> Diseñando vista</span>
                <input class="form-control form-control-sm vr-nombre" @bind="vistaEditNombre" placeholder="Nombre de la vista" title="Nombre de la vista" />
                <span class="text-muted small d-none d-xl-inline">Arrastre y estire los widgets; elija uno para sus opciones.</span>
                <span class="ms-auto d-inline-flex gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" title="Volver a la disposición inicial (como la clásica)" @onclick="RestablecerVista"><Ico Nombre="restaurar" /></button>
                    <button type="button" class="btn btn-sm btn-secondary" title="Cancelar" @onclick="CancelarDisenoVista"><Ico Nombre="cancelar" /></button>
                    <button type="button" class="btn btn-sm btn-primary" title="Guardar la vista" @onclick="GuardarVista"><Ico Nombre="guardar" /></button>
                </span>
            }
            @if (mensajeVista is not null) { <span class="small text-danger">@mensajeVista</span> }
        </div>
    };

    // ---------- Panel de widgets ----------
    private RenderFragment PanelVista(PlanAccion p, List<PlanAccion> lista, int pos) => __builder =>
    {
        var widgets = VistaActual();
        <div class="vr-cuerpo @(disenandoVista ? "vr-disenando" : "")">
            <div class="pw-panel vr-panel @(disenandoVista ? "pw-editando" : "")" @ref="refPanelVista">
                @foreach (var wd in widgets)
                {
                    var w = wd;
                    var tw = VistasModelo.TipoDe(w.Tipo);
                    <div @key="w.Id" class="pw-w vr-w @(widgetSel == w.Id ? "vr-sel-w" : "")" data-w="@w.Id" data-ancho="@w.W" data-alto="@w.H"
                         data-minw="@(tw?.MinW ?? 2)" data-minh="@(tw?.MinH ?? 2)" @onclick="() => { if (disenandoVista) widgetSel = w.Id; }">
                        <div class="vr-tarjeta vr-t-@w.Tipo">
                            @if (w.Tipo is not ("encabezado" or "kpi")) { <div class="vr-tit">@TituloWidget(w)</div> }
                            <div class="vr-contenido">@WidgetPlan(w, p, lista, pos)</div>
                        </div>
                        @if (disenandoVista)
                        {
                            <button type="button" class="pw-quitar" title="Quitar" @onclick:stopPropagation="true" @onclick="() => QuitarWidget(w.Id)">×</button>
                            <span class="pw-tirador" title="Tamaño"></span>
                        }
                    </div>
                }
            </div>
            @if (disenandoVista)
            {
                <aside class="vr-paleta">
                    @if (widgetSel is not null && vistaWidgets.FirstOrDefault(x => x.Id == widgetSel) is { } sw)
                    {
                        <h6>@(VistasModelo.TipoDe(sw.Tipo)?.Nombre ?? sw.Tipo)</h6>
                        <div class="vr-props">
                            <CampoFormulario Etiqueta="Título" Ancho=""><input class="form-control" value="@sw.Titulo" placeholder="@TituloWidget(new Widget { Tipo = sw.Tipo, Pasos = sw.Pasos, Kpi = sw.Kpi, Campo = sw.Campo })" @onchange="e => sw.Titulo = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString()" /></CampoFormulario>
                            @if (sw.Tipo == "kpi")
                            {
                                <CampoFormulario Etiqueta="Indicador" Ancho="">
                                    <select class="form-select" value="@sw.Kpi" @onchange="e => sw.Kpi = e.Value?.ToString()">
                                        @foreach (var k in VistasModelo.KpisPlan) { <option value="@k.Clave">@k.Nombre</option> }
                                    </select>
                                </CampoFormulario>
                            }
                            @if (sw.Tipo == "pasos")
                            {
                                <div class="small fw-semibold mt-1">Pasos que muestra</div>
                                @foreach (var pp in pasosPlan)
                                {
                                    var clave = pp.Clave;
                                    <label class="form-check mb-0"><input type="checkbox" class="form-check-input" checked="@sw.Pasos.Contains(clave)" @onchange="e => AlternarPaso(sw, clave, e.Value is true)" /> <span class="form-check-label">@pp.Titulo@(pp.Bloque ? " (bloque)" : "")</span></label>
                                }
                            }
                            @if (sw.Tipo == "campo")
                            {
                                <CampoFormulario Etiqueta="Campo" Ancho="">
                                    <select class="form-select" value="@sw.Campo" @onchange="e => sw.Campo = e.Value?.ToString()">
                                        @foreach (var pp in pasosPlan.Where(pp => !pp.Bloque))
                                        {
                                            <optgroup label="@pp.Titulo">
                                                @foreach (var kv in camposPlan.Where(c => c.Value.Seccion == pp.Clave).OrderBy(c => c.Value.U.Y).ThenBy(c => c.Value.U.X))
                                                { <option value="@kv.Key">@EtiquetaCampoPlan(kv.Key)</option> }
                                            </optgroup>
                                        }
                                    </select>
                                </CampoFormulario>
                            }
                            @if (sw.Tipo == "nota")
                            {
                                <CampoFormulario Etiqueta="Indicación (cuando el plan no tiene nota)" Ancho=""><textarea class="form-control" rows="3" @onchange="e => sw.Texto = e.Value?.ToString()">@sw.Texto</textarea></CampoFormulario>
                            }
                            <button type="button" class="btn btn-sm btn-outline-danger mt-1" title="Quitar el widget" @onclick="() => QuitarWidget(sw.Id)"><Ico Nombre="eliminar" /></button>
                        </div>
                    }
                    <h6 class="mt-2">Agregar widget</h6>
                    <div class="vr-lista-widgets">
                        @foreach (var t in VistasModelo.WidgetsPlan)
                        {
                            var tipo = t;
                            <button type="button" class="vr-item" title="@tipo.Descripcion" @onclick="() => AgregarWidget(tipo)">
                                <span class="vr-item-ico"><Ico Nombre="@tipo.Icono" /></span>
                                <span class="vr-item-txt"><span>@tipo.Nombre</span><small>@tipo.Descripcion</small></span>
                            </button>
                        }
                    </div>
                </aside>
            }
        </div>
    };

    // ---------- Contenido de cada widget ----------
    private RenderFragment WidgetPlan(Widget w, PlanAccion p, List<PlanAccion> lista, int pos) => __builder =>
    {
        switch (w.Tipo)
        {
            case "encabezado": @FragEncabezado(p, lista, pos) break;
            case "kpi": @FragKpi(w.Kpi ?? "estado", p) break;
            case "acciones": @FragAcciones(p) break;
            case "tabla-acciones": @FragTablaAcciones(p) break;
            case "ficha": @FragFicha(p) break;
            case "pasos": @FragPasos(w.Pasos.Count == 0 ? pasosPlan.Select(pp => pp.Clave).ToList() : w.Pasos, p) break;
            case "campo": @FragValorCampo(w.Campo, p) break;
            case "adjuntos": @FragAdjuntos(p) break;
            case "etiquetas": @FragEtiquetas(p) break;
            case "riesgos": @FragRiesgos(p) break;
            case "lugares": @FragLugares(p) break;
            case "eficacia": @FragEficacia(p) break;
            case "nota": @FragNota(w, p) break;
            case "analisis-causa": @FragAnalisisCausa(p, true) break;
            default: <span class="text-muted small">Widget desconocido.</span> break;
        }
    };

    private RenderFragment FragEncabezado(PlanAccion p, List<PlanAccion> lista, int pos) => __builder =>
    {
        <div class="ind-det-cab vr-encabezado">
            <button type="button" class="ind-nav" title="Anterior" disabled="@(pos <= 0)" @onclick="() => selId = lista[pos - 1].Id">‹</button>
            <div class="ind-det-tits">
                <h2 class="ind-det-nom"><button type="button" class="doc-vinculo pv-titulo" title="Abrir plan" @onclick="() => AbrirPlan(p.Id)">@p.Codigo</button> <span class="pv-desc-tit">@p.DescripcionHallazgo</span></h2>
                @FragEtiquetas(p)
            </div>
            <span class="ind-det-pos">@(pos + 1) / @lista.Count</span>
            <button type="button" class="ind-nav" title="Siguiente" disabled="@(pos >= lista.Count - 1)" @onclick="() => selId = lista[pos + 1].Id">›</button>
        </div>
    };

    private RenderFragment FragEtiquetas(PlanAccion p) => __builder =>
    {
        <div class="ind-chips">
            @if (!string.IsNullOrWhiteSpace(p.TipoHallazgo)) { <span class="ind-chip pv-chip-fuerte">@p.TipoHallazgo</span> }
            @if (!string.IsNullOrWhiteSpace(p.OrigenHallazgo)) { <span class="ind-chip">@p.OrigenHallazgo</span> }
            @if (CodigoAuditoria(p) is { Length: > 0 } codAud) { <a class="ind-chip text-decoration-none" href="auditoria-interna/@p.AuditoriaId?vista=planes" title="Auditoría de origen">@codAud</a> }
            @foreach (var pr in SelectorMultiple.Leer(p.Proceso)) { <span class="ind-chip">@pr</span> }
            <span class="ind-chip">@p.Fecha.ToString("dd/MM/yyyy")</span>
            @if (!string.IsNullOrWhiteSpace(p.ReportoNombre)) { <span class="ind-chip" title="Reportó">@p.ReportoNombre</span> }
        </div>
    };

    private RenderFragment FragKpi(string kpi, PlanAccion p) => __builder =>
    {
        var av = Avance(p.Id);
        var est = EstadoDe(p.Id);
        var accs = AccionesDe(p.Id);
        switch (kpi)
        {
            case "estado":
                <div class="ind-kpi ind-kpi-grande pv-kpi-estado vr-kpi @ClaseEstado(est)">
                    <span class="ind-kpi-tit">Estado del plan</span><span class="ind-kpi-val">@EscalaAccion.Nombre(est)</span>
                    <span class="ind-kpi-est">@(est == EstadoAccionPlan.Cerrada ? "Todas las acciones cerradas" : $"{av.Total - av.Cerradas} acción(es) por cerrar")</span>
                </div>
                break;
            case "avance":
                <div class="ind-kpi pv-kpi-anillo vr-kpi">
                    <span class="pv-anillo" style="--pct:@(av.Pct);"><span>@(av.Pct)%</span></span>
                    <span class="pv-anillo-txt"><span class="ind-kpi-tit">Avance</span><span class="ind-kpi-sub">@av.Cerradas de @av.Total acciones cerradas</span></span>
                </div>
                break;
            case "proxima":
                var prox = ProximaAccion(p.Id);
                <div class="ind-kpi vr-kpi @(prox is not null && Vencida(prox) ? "pv-kpi-vencida" : "")">
                    <span class="ind-kpi-tit">Próxima acción</span><span class="ind-kpi-val pv-kpi-fecha">@(prox?.Fecha.ToString("dd/MM/yyyy") ?? "—")</span>
                    <span class="ind-kpi-sub">@(prox is null ? "Sin pendientes" : Vencida(prox) ? $"Vencida hace {(DateTime.Today - prox.Fecha.Date).Days} día(s)" : $"En {(prox.Fecha.Date - DateTime.Today).Days} día(s)")</span>
                </div>
                break;
            case "dias":
                <div class="ind-kpi vr-kpi"><span class="ind-kpi-tit">Días desde el hallazgo</span><span class="ind-kpi-val">@((DateTime.Today - p.Fecha.Date).Days)</span><span class="ind-kpi-sub">@p.Fecha.ToString("dd/MM/yyyy")</span></div>
                break;
            case "abiertas":
                <div class="ind-kpi vr-kpi"><span class="ind-kpi-tit">Acciones por cerrar</span><span class="ind-kpi-val">@(av.Total - av.Cerradas)</span><span class="ind-kpi-sub">de @av.Total acción(es)</span></div>
                break;
            case "vencidas":
                var nv = accs.Count(Vencida);
                <div class="ind-kpi vr-kpi @(nv > 0 ? "pv-kpi-vencida" : "")"><span class="ind-kpi-tit">Acciones vencidas</span><span class="ind-kpi-val">@nv</span><span class="ind-kpi-sub">@(nv == 0 ? "Al día" : "Con fecha ya pasada")</span></div>
                break;
            case "adjuntos":
                <div class="ind-kpi vr-kpi"><span class="ind-kpi-tit">Adjuntos</span><span class="ind-kpi-val">@TotalAdjuntos(p.Id)</span><span class="ind-kpi-sub">en @CarpetasVista(p.Id).Count(c => c.Archivos.Count > 0) carpeta(s)</span></div>
                break;
            case "eficacia":
                var efi = EscalaEficacia.De(p.Eficaz, p.FechaProgramadaEficacia, est);
                <div class="ind-kpi vr-kpi"><span class="ind-kpi-tit">Eficacia</span><span class="ind-kpi-val vr-kpi-texto" style="color:@EscalaEficacia.Color(efi)">@EscalaEficacia.Nombre(efi, p.FechaProgramadaEficacia)</span><span class="ind-kpi-sub">@(p.FechaVerificacionEficacia?.ToString("dd/MM/yyyy") ?? (p.FechaProgramadaEficacia is DateTime fp ? $"Programada {fp:dd/MM/yyyy}" : "Sin fecha programada"))</span></div>
                break;
        }
    };

    private RenderFragment FragAcciones(PlanAccion p) => __builder =>
    {
        var accs = AccionesDe(p.Id);
        <ol class="pv-linea">
            @foreach (var a in accs)
            {
                var acc = a;
                var productos = (acc.Producto ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                var nAnexos = AnexosDe(acc.Id);
                <li class="pv-paso @ClaseEstado(acc.Estado) @(Vencida(acc) ? "pv-vencida" : "")">
                    <span class="pv-paso-punto"></span>
                    <button type="button" class="pv-paso-tarjeta" title="Ver la acción en el plan" @onclick="() => AbrirAcciones(p.Id, acc.Id)">
                        <span class="pv-paso-cab">
                            <span class="pv-paso-tipo">@EscalaAccion.Nombre(acc.Tipo)</span>
                            <EstadoAccion Estado="acc.Estado" />
                            <span class="pv-paso-fecha">@acc.Fecha.ToString("dd/MM/yyyy")@(Vencida(acc) ? " · vencida" : "")</span>
                        </span>
                        <span class="pv-paso-desc">@acc.Descripcion</span>
                        <span class="pv-paso-pie">
                            @if (!string.IsNullOrWhiteSpace(acc.Responsable)) { <span class="ind-chip">@string.Join(", ", SelectorMultiple.Leer(acc.Responsable))</span> }
                            @foreach (var pr in productos) { <span class="ind-chip pv-producto">@pr</span> }
                            @if (nAnexos > 0) { <span class="ind-chip">📎 @nAnexos</span> }
                        </span>
                    </button>
                </li>
            }
            @if (accs.Count == 0) { <li class="text-muted small">Sin acciones.</li> }
        </ol>
    };

    private RenderFragment FragTablaAcciones(PlanAccion p) => __builder =>
    {
        var accs = AccionesDe(p.Id);
        <table class="table table-sm vr-tabla mb-0">
            <thead><tr><th>Tipo</th><th>Acción</th><th>Responsable</th><th>Fecha</th><th>Estado</th></tr></thead>
            <tbody>
                @foreach (var a in accs)
                {
                    var acc = a;
                    <tr class="@(Vencida(acc) ? "pv-vencida" : "")" style="cursor:pointer" @onclick="() => AbrirAcciones(p.Id, acc.Id)">
                        <td class="text-nowrap">@EscalaAccion.Nombre(acc.Tipo)</td><td>@acc.Descripcion</td>
                        <td>@string.Join(", ", SelectorMultiple.Leer(acc.Responsable))</td>
                        <td class="text-nowrap">@acc.Fecha.ToString("dd/MM/yyyy")</td><td><EstadoAccion Estado="acc.Estado" /></td>
                    </tr>
                }
                @if (accs.Count == 0) { <tr><td colspan="5" class="text-muted small">Sin acciones.</td></tr> }
            </tbody>
        </table>
    };

    // Análisis de causa en las vistas: texto + diagrama (clic = maximizar). Fuera del diseño de vistas, + / editar abre el
    // editor y se guarda al momento en el plan. grande = widget propio (la imagen llena el widget, el texto debajo).
    private RenderFragment FragAnalisisCausa(PlanAccion p, bool grande) => __builder =>
    {
        var hayTexto = !string.IsNullOrWhiteSpace(p.AnalisisCausa);
        var hayDiagrama = !string.IsNullOrWhiteSpace(p.AnalisisCausaSvg);
        <div class="@(grande ? "vr-causa" : "")">
            @if (hayDiagrama || !disenandoVista)
            {
                <CampoAnalisisCausa Json="@p.AnalisisCausaDiagrama" Svg="@p.AnalisisCausaSvg" Titulo="@p.Codigo" Grande="grande"
                                    SoloLectura="disenandoVista" OnCambio="r => GuardarCausasVista(p, r)" />
            }
            @if (hayTexto)
            {
                <div class="rg-multi @(hayDiagrama ? "ac-texto-bajo" : "")">@p.AnalisisCausa</div>
            }
            else if (!hayDiagrama)
            {
                <span>—</span>
            }
        </div>
    };

    private async Task GuardarCausasVista(PlanAccion p, SigWeb.Data.Planes.ResultadoAnalisisCausa r)
    {
        await _dbLock.WaitAsync();
        try
        {
            var ent = await Db.PlanesAccion.FirstAsync(x => x.Id == p.Id);
            if (SigWeb.Data.Planes.AnalisisCausa.Aplicar(ent, r) is string error) { mensajeVista = error; return; }
            await Db.SaveChangesAsync();
            p.AnalisisCausaDiagrama = ent.AnalisisCausaDiagrama; p.AnalisisCausaSvg = ent.AnalisisCausaSvg; p.AnalisisCausa = ent.AnalisisCausa;
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); mensajeVista = "No se pudo guardar el análisis de causa: " + ex.Message; }
        finally { _dbLock.Release(); }
    }

    private RenderFragment FragFicha(PlanAccion p) => __builder =>
    {
        <dl class="ind-ficha pv-ficha">
            <dt>Descripción del hallazgo</dt><dd>@(string.IsNullOrWhiteSpace(p.DescripcionHallazgo) ? "—" : p.DescripcionHallazgo)</dd>
            <dt>Análisis de causa</dt><dd>@FragAnalisisCausa(p, false)</dd>
            <dt>Lugares</dt><dd>@FragLugares(p)</dd>
            <dt>Riesgos</dt><dd>@FragRiesgos(p)</dd>
            <dt>Adjuntos</dt><dd>@CeldaAdjuntos(p.Id)</dd>
        </dl>
    };

    private RenderFragment FragLugares(PlanAccion p) => __builder =>
    {
        var l = LugaresDe(p.Id).ToList();
        <div class="ind-chips">
            @foreach (var x in l) { <span class="ind-chip">@x</span> }
            @if (l.Count == 0) { <span>—</span> }
        </div>
    };

    private RenderFragment FragRiesgos(PlanAccion p) => __builder =>
    {
        <div class="ind-chips">
            @if (riesgosDePlan.TryGetValue(p.Id, out var rs) && rs.Count > 0)
            {
                @foreach (var r in rs) { <a class="ind-chip pv-riesgo" href="@($"riesgos/{r}")">@NombreRiesgo(r)</a> }
            }
            else { <span>—</span> }
        </div>
    };

    private RenderFragment FragEficacia(PlanAccion p) => __builder =>
    {
        var efi = EscalaEficacia.De(p.Eficaz, p.FechaProgramadaEficacia, EstadoDe(p.Id));
        var soportes = archivosEficacia.Where(x => x.PlanAccionId == p.Id).ToList();
        <dl class="ind-ficha pv-ficha">
            <dt>Estado</dt><dd><span class="rg-pill" style="background:@EscalaEficacia.Color(efi);color:#fff">@EscalaEficacia.Nombre(efi, p.FechaProgramadaEficacia)</span></dd>
            <dt>Criterio</dt><dd class="rg-multi">@(string.IsNullOrWhiteSpace(p.CriterioEficacia) ? "—" : p.CriterioEficacia)</dd>
            <dt>Fecha programada</dt><dd>@(p.FechaProgramadaEficacia?.ToString("dd/MM/yyyy") ?? "—")</dd>
            @if (p.Eficaz is not null)
            {
                <dt>Verificó</dt><dd>@(p.VerificoEficacia ?? "—") · @(p.FechaVerificacionEficacia?.ToString("dd/MM/yyyy") ?? "")</dd>
                <dt>Evidencia</dt><dd class="rg-multi">@(string.IsNullOrWhiteSpace(p.EvidenciaEficacia) ? "—" : p.EvidenciaEficacia)</dd>
            }
