        <button type="button" class="btn btn-sm btn-outline-secondary mt-1" title="Ver y administrar todos los adjuntos" @onclick="() => { verAdjuntosDe = p.Id; LimpiarAdj(); }"><Ico Nombre="listado" /></button>
