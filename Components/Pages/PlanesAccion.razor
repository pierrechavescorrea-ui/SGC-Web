        {
            <div class="doc-menu-sec d-flex align-items-center gap-1 @(c.Automatica ? "adj-auto" : "")" title="@(c.CampoId is not null ? "Campo de adjuntos del formulario: la carpeta lleva el nombre de su paso" : c.Eficacia ? "Soportes de la verificación de eficacia del plan" : null)">
                <Ico Nombre="@(c.AccionId is not null ? "plan-accion" : c.CampoId is not null ? "formularios" : c.Eficacia ? "aprobar" : "carpeta")" /> <span class="text-truncate">@c.Nombre@(enMenu && archivos.Count > MaxMenu ? $" ({MaxMenu} de {archivos.Count})" : archivos.Count > 0 ? $" ({archivos.Count})" : "")</span>
                <label class="ens-mini ms-auto mb-0" title="@($"Cargar en {c.Nombre}")"><Ico Nombre="agregar" /><InputFile class="d-none" multiple OnChange="@(e => SubirACarpeta(c, e))" /></label>
                @if (c.CarpetaId is int idc)
