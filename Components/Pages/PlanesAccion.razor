    private async Task ImportarExcel(ImportacionExcel imp)
    {
        mensaje = "";
        if (imp.Filas.Count == 0) { mensaje = "No hay filas con datos para importar."; error = true; return; }
        importando = true;
        await _dbLock.WaitAsync();
        try
        {
            var nombres = (motor?.Campos ?? new()).ToDictionary(c => c.Id, c => c.Nombre);
            using var scope = Scopes.CreateScope();
            var dbImportacion = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            var r = await SigWeb.Data.Planes.ImportadorPlanesAccion.ImportarAsync(dbImportacion, imp, nombres);
            mensaje = $"{r.Planes} plan(es) nuevo(s), {r.PlanesActualizados} existente(s) con acciones nuevas, {r.Acciones} acción(es)."
                + (r.Avisos.Count > 0 ? " " + string.Join(" ", r.Avisos) : "");
            error = r.Avisos.Count > 0;
            mostrarImportar = false;
            Cargar();
            await CargarMotorAsync();
        }
        catch (Exception ex) { mensaje = "No se pudo importar: " + ex.Message; error = true; }
        finally { importando = false; _dbLock.Release(); }
    }

