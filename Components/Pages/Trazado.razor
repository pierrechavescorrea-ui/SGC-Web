                                       @onchange="@(e => { registro.Completado = (bool)e.Value!; if (!registro.Completado) registro.EstadoParametroId = null; })" />
                                <span>@(string.IsNullOrEmpty(p.Codigo) ? "" : $"{p.Codigo} — ")@p.Nombre</span>
                            </span>
                            <span class="d-flex align-items-center gap-1">
                                @if (enEdicion)
                                {
                                    <select class="form-select form-select-sm py-0" style="width:auto;" title="Estado (Matriz PIE)"
                                            value="@(registro.EstadoParametroId?.ToString() ?? "")"
                                            @onchange="@(e => CambiarEstadoRegistro(registro, e.Value?.ToString()))">
                                        <option value="">Sin estado</option>
                                        @foreach (var es in estadosParametro)
                                        {
                                            <option value="@es.Id">@es.Nombre</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    var est = estadosParametro.FirstOrDefault(x => x.Id == registro.EstadoParametroId);
                                    if (registro.Completado && est is not null)
                                    {
                                        <span class="badge" style="background:@est.Color;" title="Estado (Matriz PIE)">@est.Nombre</span>
                                    }
                                    <button type="button" class="ens-mini" title="Editar" @onclick="() => IniciarEdicionParametro(p.Id)"><Ico Nombre="editar" /></button>
                                }
                            </span>
                        </div>
                        <div class="ficha-bloque-fila">
                            <span class="ficha-bloque-etiqueta">Fecha</span>
                            @if (enEdicion)
                            {
                                <input type="date" class="form-control form-control-sm" @bind="registro.Fecha" />
                            }
                            else
                            {
                                <span>@(registro.Fecha?.ToString("dd/MM/yyyy") ?? "—")</span>
                            }
                        </div>
                        <div class="ficha-bloque-fila">
                            <span class="ficha-bloque-etiqueta">Facturado</span>
                            @if (enEdicion)
                            {
                                <input type="date" class="form-control form-control-sm" @bind="registro.FechaFacturado" />
                            }
                            else
                            {
                                <span>@(registro.FechaFacturado?.ToString("dd/MM/yyyy") ?? "—")</span>
                            }
                        </div>
                        <div class="ficha-bloque-fila">
                            <span class="ficha-bloque-etiqueta">Observación</span>
                            @if (enEdicion)
                            {
                                <input class="form-control form-control-sm" @bind="registro.Observaciones" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrWhiteSpace(registro.Observaciones) ? "—" : registro.Observaciones)</span>
                            }
                        </div>
                        @if (enEdicion)
                        {
                            <div class="ficha-bloque-fila">
                                <span class="ficha-bloque-etiqueta">Archivos</span>
                                <InputFile class="form-control form-control-sm" multiple
                                           OnChange="@(e => CargarArchivosParametro(e, p.Id))" accept=".pdf,image/*" />
                            </div>
                        }
                        else if (!(archivosPorParametro.TryGetValue(p.Id, out var archivosVista) && archivosVista.Count > 0))
                        {
                            <div class="ficha-bloque-fila">
                                <span class="ficha-bloque-etiqueta">Archivos</span>
                                <span>—</span>
                            </div>
                        }
                        @if (archivosPorParametro.TryGetValue(p.Id, out var archivos) && archivos.Count > 0)
                        {
                            <ul class="small list-unstyled mt-1 mb-1 pildora-lista">
                                @foreach (var archivo in archivos)
                                {
                                    <li>
                                        <PildoraArchivo Url="@archivo.RutaArchivo" Nombre="@archivo.NombreOriginal" />
                                        @if (enEdicion)
                                        {
                                            <button type="button" class="btn btn-link btn-sm text-danger p-0 ms-1"
                                                    @onclick="() => PedirEliminarArchivoParametro(archivo, p.Id)" title="Quitar">✕</button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        @if (enEdicion)
                        {
                            <div class="frm-pie frm-pie-plano">
                                @if (mensajesGuardado.TryGetValue(p.Id, out var msj))
                                {
                                    <span class="frm-pie-msg text-success small">@msj</span>
                                }
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CancelarEdicionParametro(p.Id)" title="Cancelar"><Ico Nombre="cancelar" /></button>
                                <button class="btn btn-sm btn-primary" @onclick="() => GuardarYCerrarParametro(p)" title="Guardar"><Ico Nombre="guardar" /></button>
                            </div>
                        }
                    </div>
                }
                </div>
            }

            @if (registrosVinculadosComponente.Count > 0)
            {
                <hr />
                <h6>Otros módulos vinculados aquí</h6>
                @foreach (var grupo in registrosVinculadosComponente.GroupBy(r => r.Modulo))
                {
                    <div class="small mb-1"><strong>@grupo.Key:</strong></div>
                    <ul class="small ps-3">
                        @foreach (var r in grupo)
                        {
                            <li><strong>@r.Titulo</strong> — <span class="text-muted">@r.Detalle</span></li>
                        }
                    </ul>
                }
            }
            </div>
        </div>
    </div>
}

