    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                motor = await MotorTabla.CargarAsync(Db, "trazado-torres", ColumnasNativasTorres(), elementos.Select(e => (e.Id, e.Codigo)));
                StateHasChanged();
            }
            catch { motor = null; }
            referencia = DotNetObjectReference.Create(this);
            await DibujarMapa();
            // ?torre=Id (buscador rápido Ctrl + K): abre esa torre.
            torreAplicada = TorreQ;
            if (TorreQ is int tq && elementos.FirstOrDefault(e => e.Id == tq) is { } torreQ)
            {
                await IrATorre(torreQ);
                if (CompQ is int idComp && componentesDeLaTorre.FirstOrDefault(c => c.Id == idComp) is { } comp)
                {
                    AbrirFichaComponente(comp);
                    RestaurarPestana(PestanaQ);
                    planAbierto = PlanQ; hallazgoAbierto = HallazgoQ;
                    irATarjeta = PlanQ is int ip ? $"hv-plan-{ip}" : HallazgoQ is int ih ? $"hv-hallazgo-{ih}" : null;
                }
                else if (HdvQ == true && componentesDeLaTorre.FirstOrDefault(c => c.EsHojaDeVida) is { } hv) AbrirFichaComponente(hv);
                StateHasChanged();
            }
            // El mapa se dibuja visible (Leaflet no calcula su tamaño oculto) y luego se pasa a la tabla.
            if (VistaQ == "tabla") await CambiarVista("tabla");
            vistaLista = true;
        }
        if (vistaLista) await AnotarVista();
    }

    // Pestaña abierta en la ficha (hoja de vida o elemento): misma clave que ?pestana= y RestaurarPestana.
    private string? PestanaActual() =>
        mostrarTabPlanos ? "planos" : mostrarTabInformacion ? "info" : mostrarTabHallazgos ? "riesgos" : mostrarTabPlanesAccion ? "planes" : mostrarTabCambios ? "cambios" : mostrarTabModulos ? "modulos"
            : actividadTabSeleccionada is int a ? $"act-{a}" : null;

    // ---------- Torre anterior / siguiente desde la ficha abierta ----------
    // Orden natural del código (3, 5N, 10, 15A…; no alfabético) entre las torres visibles del trazado.
    private static (long Num, string Resto) ClaveOrdenTorre(string codigo)
    {
        var t = (codigo ?? "").Trim();
        var i = 0; while (i < t.Length && !char.IsDigit(t[i])) i++;
        var j = i; while (j < t.Length && char.IsDigit(t[j])) j++;
        var num = j > i && long.TryParse(t[i..j], out var n) ? n : long.MaxValue;
        return (num, (t[..i] + "|" + t[j..]).ToUpperInvariant());
    }

    private ElementoTrazado? TorreVecina(int paso)
    {
        if (elementoSeleccionado is null || elementos.Count < 2) return null;
        var orden = elementos.OrderBy(e => ClaveOrdenTorre(e.Codigo).Num).ThenBy(e => ClaveOrdenTorre(e.Codigo).Resto)
            .ThenBy(e => e.Codigo, StringComparer.OrdinalIgnoreCase).ToList();
        var i = orden.FindIndex(e => e.Id == elementoSeleccionado.Id);
        var k = i + paso;
        return i < 0 || k < 0 || k >= orden.Count ? null : orden[k];
    }

    private string TituloTorreVecina(int paso) => TorreVecina(paso) is { } t
        ? $"{(paso < 0 ? "Torre anterior" : "Torre siguiente")}: {t.Codigo}"
        : paso < 0 ? "Es la primera torre" : "Es la última torre";

    // Cambia de torre sin cerrar la ficha: abre el mismo elemento (hoja de vida, o el de igual nombre, p. ej. «Pata A»)
    // y la misma pestaña. Si la otra torre no tiene ese elemento, abre su hoja de vida.
    private async Task IrATorreVecina(int paso)
    {
        if (TorreVecina(paso) is not { } destino || componenteSeleccionado is null) return;
        var eraHojaVida = componenteSeleccionado.EsHojaDeVida;
        var nombre = componenteSeleccionado.Nombre.Trim();
        var pestana = PestanaActual();
        SeleccionarElemento(destino.Id);
        var comp = (eraHojaVida ? null : componentesDeLaTorre.FirstOrDefault(c => !c.EsHojaDeVida
                        && string.Equals(c.Nombre.Trim(), nombre, StringComparison.OrdinalIgnoreCase)))
                   ?? componentesDeLaTorre.FirstOrDefault(c => c.EsHojaDeVida);
        if (comp is null) return;
        AbrirFichaComponente(comp);
        RestaurarPestana(pestana);
        await AnotarVista();
    }

    // Torre, vista y ficha abiertas → URL, sin navegar (Atrás desde otra pantalla vuelve aquí igual).
    private async Task AnotarVista()
    {
        var comp = mostrarModalComponente ? componenteSeleccionado?.Id : null;
        var pestana = comp is null ? null : PestanaActual();
        var plan = pestana == "planes" ? planAbierto : null;
        var hallazgo = pestana == "riesgos" ? hallazgoAbierto : null;
        var clave = $"{elementoSeleccionado?.Id}|{vistaPrincipal}|{comp}|{pestana}|{plan}|{hallazgo}";
        if (clave == vistaAnotada) return;
        vistaAnotada = clave;
        await JS.RecordarVistaAsync("/trazado", new Dictionary<string, object?>
        {
            ["torre"] = elementoSeleccionado?.Id,
            ["vista"] = vistaPrincipal == "tabla" ? "tabla" : null,
            ["comp"] = comp,
            ["pestana"] = pestana,
            ["plan"] = plan,
            ["hallazgo"] = hallazgo,
            ["hdv"] = null,
        });
    }

    private void RestaurarPestana(string? p)
    {
        switch (p)
        {
            case "planos": MostrarTabPlanos(); break;
            case "info": MostrarTabInformacion(); break;
            case "riesgos": MostrarTabHallazgos(); break;
            case "planes": MostrarTabPlanesAccion(); break;
            case "cambios": _ = MostrarTabCambios(); break;
            case "modulos": MostrarTabModulos(); break;
            case { } x when x.StartsWith("act-") && int.TryParse(x[4..], out var id) && actividadesDelComponente.Any(a => a.Id == id):
                SeleccionarActividadTab(id); break;
        }
    }

    // Solo se listan las capas que todavía tienen al menos una torre activa
    // en el mapa. Una capa cuyas torres fueron todas eliminadas o migradas
    // hacia otra queda vacía y ya no aporta nada en este panel — mostrarla
    // solo sería ruido (sus datos, si los tuviera, siguen en la Papelera).
    // Capas, torres y la selección desde el mapa leen con su propio DbContext (ConDb): llegan desde
    // eventos del mapa (JS) y de botones mientras otra operación de la página puede estar esperando
    // la base; con el Db compartido eso lanzaba "A second operation was started…" y tumbaba el circuito.
    private T ConDb<T>(Func<AppDbContext, T> f)
    {
        using var scope = Scopes.CreateScope();
        return f(scope.ServiceProvider.GetRequiredService<AppDbContext>());
    }

    private void CargarCapas()
    {
        conteoTorresPorCapa = ConDb(db => db.ElementosTrazado.AsNoTracking()
            .Where(e => !e.Eliminado && e.CapaTrazadoId != null)
            .GroupBy(e => e.CapaTrazadoId!.Value)
            .ToDictionary(g => g.Key, g => g.Count()));

        capas = ConDb(db => db.Capas.AsNoTracking()
            .OrderByDescending(c => c.FechaCarga)
            .ToList()
            .Where(c => conteoTorresPorCapa.ContainsKey(c.Id))
            .ToList());
    }

    // Una torre solo se dibuja/lista si no está eliminada Y (no tiene capa,
    // caso raro, o su capa está marcada como visible).
    private void CargarElementos()
    {
        var capasVisibles = capas.Where(c => c.Visible).Select(c => c.Id).ToHashSet();
        elementos = ConDb(db => db.ElementosTrazado.AsNoTracking()
            .Where(e => !e.Eliminado)
            .ToList())
            .Where(e => e.CapaTrazadoId == null || capasVisibles.Contains(e.CapaTrazadoId.Value))
            .OrderBy(e => e.Codigo)
            .ToList();
    }

    private string? NombreCapaDe(ElementoTrazado torre)
    {
        if (torre.CapaTrazadoId is null) return null;
        return capas.FirstOrDefault(c => c.Id == torre.CapaTrazadoId)?.Nombre;
    }

    // ---------- Gestión de capas: apagar, renombrar, eliminar del mapa ----------
