                                                <button type="button" class="ens-mini" title="Subir o gestionar documentos del informe" @onclick="() => AbrirArchivosInformePata(informeElemento)"><Ico Nombre="agregar" /></button>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    </div>
                    }

</SigWeb.Components.Trazado.PanelCarpetasHojaVida>
