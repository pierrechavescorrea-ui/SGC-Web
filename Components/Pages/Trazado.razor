                                                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => seleccionVincular.Clear()" title="Ninguna"><Ico Nombre="cancelar" /></button>
                                                <button type="button" class="btn btn-sm btn-primary ms-auto" disabled="@(seleccionVincular.Count == 0 || vinculando)" @onclick="VincularSeleccionadas"
                                                        title="Vincular las hojas marcadas"><Ico Nombre="agregar" /></button>
                                            </div>
                                        }
                                        @if (gruposVincular.Sum(g => g.Archivos.Count) >= MaxHojasVincular)
                                        {
                                            <div class="form-text">Se muestran las primeras @MaxHojasVincular hojas: escribe más para afinar.</div>
                                        }
                                    }
                                }
                            </div>
                        }
                        else
                        {
