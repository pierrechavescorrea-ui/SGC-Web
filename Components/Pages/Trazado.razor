    // ---------- Planos del listado maestro vinculados a este componente ----------
    private void CargarPlanosVinculadosDelComponente()
    {
        mostrarVincularPlano = false;
        filtroVincularPlano = "";
        archivosDisponiblesVincular = new();

        if (componenteSeleccionado is null)
        {
            planosVinculadosDelComponente = new();
            return;
        }

        var vinculos = Db.ComponentesPlano.AsNoTracking()
            .Where(v => v.ComponenteId == componenteSeleccionado.Id)
            .ToList();
        if (vinculos.Count == 0)
        {
            planosVinculadosDelComponente = new();
            return;
        }

        var idsArchivos = vinculos.Select(v => v.ArchivoPlanoMaestroId).ToList();
        var archivos = Db.ArchivosPlanoMaestro.AsNoTracking()
            .Where(a => idsArchivos.Contains(a.Id) && !a.Eliminado)
            .ToDictionary(a => a.Id);

        var idsPlanos = archivos.Values.Select(a => a.PlanoMaestroId).Distinct().ToList();
        var planos = Db.PlanosMaestro.AsNoTracking()
            .Where(p => idsPlanos.Contains(p.Id) && !p.Eliminado)
            .ToDictionary(p => p.Id);

        planosVinculadosDelComponente = vinculos
            .Where(v => archivos.ContainsKey(v.ArchivoPlanoMaestroId) && planos.ContainsKey(archivos[v.ArchivoPlanoMaestroId].PlanoMaestroId))
            .Select(v => (v, archivos[v.ArchivoPlanoMaestroId], planos[archivos[v.ArchivoPlanoMaestroId].PlanoMaestroId]))
            .OrderBy(x => x.Item3.Codigo).ThenBy(x => x.Item2.NombreOriginal)
            .ToList();
    }

    // Se calcula solo aquí, dentro del manejador del evento oninput (nunca en
    // el marcado): ver el comentario junto a archivosDisponiblesVincular.
    // Busca por código/título del plano, pero el resultado es por ARCHIVO
    // (una hoja puntual), para poder vincular solo la que corresponde.
    // ---------- Vincular planos del listado maestro (varias hojas a la vez) ----------
    // La búsqueda se agrupa por plano: el código sin la hoja ("…DIS6052-H14" → "…DIS6052"). Con varias hojas,
    // pregunta si se vinculan todas o se eligen (casillas). Alcance: esta ficha, o el mismo elemento (hoja de vida
    // o pata con el mismo nombre) en todas las torres de su familia (BP) o de su tipo exacto (BP3), según la
    // regla de tipos de Línea 3D (TiposTorre). Lee y escribe con su propio DbContext (ver ConDb).
    private sealed record GrupoVincular(string Raiz, List<(ArchivoPlanoMaestro A, PlanoMaestro P)> Archivos);
    private const int MaxHojasVincular = 300;
    private List<GrupoVincular> gruposVincular = new();
    private HashSet<int> seleccionVincular = new();
    private bool modoManualVincular, vinculando, errorVincular;
    private string alcanceVincular = "ficha";
    private string? mensajeVincular;
    private SigWeb.Data.Modelos3D.TipoTorre? tipoTorreVincular;
    private Dictionary<int, SigWeb.Data.Modelos3D.TipoTorre> tiposTorresVincular = new();
    private int torresFamiliaVincular, torresTipoVincular;
    private static readonly System.Text.RegularExpressions.Regex RxHojaPlano =
        new(@"[\s_\-]*H\s*\d+\b.*$", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string RaizPlano(string codigo)
    {
        var r = RxHojaPlano.Replace(codigo ?? "", "").Trim(' ', '-', '_');
        return r.Length == 0 ? (codigo ?? "").Trim() : r;
    }

    private static string NormTipo(string? s) => new string((s ?? "").ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray());

    private void AbrirVincularPlano()
    {
        mostrarVincularPlano = true;
        filtroVincularPlano = ""; gruposVincular = new(); seleccionVincular.Clear();
        modoManualVincular = false; mensajeVincular = null; alcanceVincular = "ficha";
        tipoTorreVincular = null; torresFamiliaVincular = torresTipoVincular = 0;
        try
        {
            tiposTorresVincular = ConDb(db => SigWeb.Data.Modelos3D.TiposTorre.Cargar(db, new List<SigWeb.Data.Modelos3D.ConfigModelo>()));
            if (elementoSeleccionado is { } t && tiposTorresVincular.TryGetValue(t.Id, out var tt))
            {
                tipoTorreVincular = tt;
                torresFamiliaVincular = string.IsNullOrEmpty(tt.Familia) ? 0 : tiposTorresVincular.Values.Count(x => x.Familia == tt.Familia);
                torresTipoVincular = string.IsNullOrWhiteSpace(tt.Texto) ? 0 : tiposTorresVincular.Values.Count(x => NormTipo(x.Texto) == NormTipo(tt.Texto));
            }
        }
        catch (Exception ex) { Console.Error.WriteLine("Vincular planos: no se pudo leer el tipo de las torres: " + ex.Message); tiposTorresVincular = new(); }
    }

    private void CerrarVincularPlano()
