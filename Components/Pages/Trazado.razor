                                                </div>
                                                <div class="d-flex gap-1 mt-1">
                                                    <button type="button" class="btn btn-sm btn-primary" disabled="@vinculando" @onclick="VincularTodasLasHojas" title="Vincular las @totalHojas"><Ico Nombre="enlace" /></button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => modoManualVincular = true" title="Elegir manualmente"><Ico Nombre="seleccionar-todo" /></button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="vp-lista">
                                                @foreach (var g in gruposVincular)
