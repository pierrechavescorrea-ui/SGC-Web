    private void BuscarPlanosParaVincular(ChangeEventArgs e)
    {
        filtroVincularPlano = e.Value?.ToString() ?? "";
        modoManualVincular = false; mensajeVincular = null;
        RecalcularVincular();
    }

    // Hojas que coinciden (todas las palabras escritas en código, título o nombre del archivo), sin las ya
    // vinculadas a esta ficha cuando el alcance es la ficha. Solo archivos vigentes.
    private void RecalcularVincular()
    {
        if (componenteSeleccionado is null || string.IsNullOrWhiteSpace(filtroVincularPlano)) { gruposVincular = new(); seleccionVincular.Clear(); return; }
        var palabras = filtroVincularPlano.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var yaVinculados = alcanceVincular == "ficha" ? planosVinculadosDelComponente.Select(x => x.Archivo.Id).ToHashSet() : new HashSet<int>();
        var (planos, archivos) = ConDb(db =>
        {
            var pl = db.PlanosMaestro.AsNoTracking().Where(p => !p.Eliminado).ToDictionary(p => p.Id);
            var ar = db.ArchivosPlanoMaestro.AsNoTracking()
                .Where(a => !a.Eliminado && a.Clase != SigWeb.Models.ClaseArchivoDocumento.Obsoleta).ToList();
            return (pl, ar);
        });
        var coincidentes = archivos
            .Where(a => planos.ContainsKey(a.PlanoMaestroId) && !yaVinculados.Contains(a.Id))
            .Select(a => (A: a, P: planos[a.PlanoMaestroId]))
            .Where(x => palabras.All(w => $"{x.P.Codigo} {x.P.Titulo} {x.A.NombreOriginal}".Contains(w, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(x => x.P.Codigo).ThenBy(x => NumeroHoja(x.A.NombreOriginal)).ThenBy(x => x.A.NombreOriginal)
            .Take(MaxHojasVincular)
            .ToList();
        gruposVincular = coincidentes.GroupBy(x => RaizPlano(x.P.Codigo), StringComparer.OrdinalIgnoreCase)
            .Select(g => new GrupoVincular(g.Key, g.Select(x => (x.A, x.P)).ToList()))
            .OrderBy(g => g.Raiz).ToList();
        var visibles = coincidentes.Select(x => x.A.Id).ToHashSet();
        seleccionVincular.RemoveWhere(id => !visibles.Contains(id));
    }

    private static int NumeroHoja(string nombre)
    {
        var m = System.Text.RegularExpressions.Regex.Match(nombre ?? "", @"H\s*(\d+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return m.Success && int.TryParse(m.Groups[1].Value, out var n) ? n : int.MaxValue;
    }

    private void MarcarGrupoVincular(GrupoVincular g, bool marcar)
    {
        foreach (var x in g.Archivos) { if (marcar) seleccionVincular.Add(x.A.Id); else seleccionVincular.Remove(x.A.Id); }
    }

