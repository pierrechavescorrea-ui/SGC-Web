                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Cerrar" @onclick="CerrarRelacionarMaterial"><Ico Nombre="cancelar" /></button>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0" title="Relacionar material del listado" @onclick="AbrirRelacionarMaterial"><Ico Nombre="agregar" /></button>
                            }

                        </div>
                    </div>

                    @if (componenteSeleccionado.EsHojaDeVida)
                    {
