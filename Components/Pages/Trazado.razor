@code {
    private string mensaje = "";
    private bool error = false;
    private bool pantallaCompleta = false;
    private bool mostrarOpcionesCarga = false;

    private List<ElementoTrazado> elementos = new();
    private ElementoTrazado? elementoSeleccionado;
    // % de cumplimiento PIE de la torre seleccionada (misma regla que Matriz PIE).
    private SigWeb.Data.Pie.CumplimientoPie.Resultado pctPie = new(null, 0, 0);
    private DotNetObjectReference<Trazado>? referencia;

    // ---------- Vista del espacio principal: mapa o tabla ----------
    // Mismo espacio, dos representaciones de los mismos datos cargados
    // (KMZ/Excel): el mapa se oculta con CSS (nunca se destruye, ver nota
    // más abajo) y la tabla ocupa el mismo alto dinámico mientras tanto.
    private string vistaPrincipal = "mapa"; // "mapa" | "tabla"

    // ---------- Renombrar la torre seleccionada ----------
    // Codigo/Nombre se editan aquí; como el resto de tablas (Componente,
    // RegistroParametro, Material) se vinculan por Id y no por código, un
    // cambio de nombre no afecta ningún registro ya cargado.
    private bool editandoNombreTorre = false;
    private string codigoEdicionTorre = "";
    private string errorEdicionTorre = "";

    // ---------- Selección de torres al importar ----------
    private List<PuntoImportado> puntosPendientes = new();
    private HashSet<string> codigosSeleccionados = new();
    private string filtroImportacion = "";
    private bool mostrarSeleccionImportacion = false;

    // ---------- Detección de nombres parecidos a una torre existente ----------
    // Ej. "102" ya existe y el archivo trae "102N": ¿es la misma torre
    // (migrar todo lo ya cargado hacia el nuevo código) o son distintas
    // (conservar ambas)? Se resuelve antes de escribir nada en la base.
    private record ConflictoNombre(string CodigoNuevo, string CodigoExistente, int IdExistente, bool EliminadaEnMapa);
    private List<ConflictoNombre> conflictosNombre = new();
    private Dictionary<string, string> decisionesConflicto = new(); // codigo -> "ambas" | "migrar"
    private bool mostrarConflictosNombre = false;

    // ---------- Excel de coordenadas (Torre, X, Y) ----------

    // ---------- Vincular puntos cercanos como patas con ubicación real ----------
    private const double RadioPatasMetros = 60;
    private record CandidataPata(string Codigo, string CodigoTorreCercana, double DistanciaMetros, double Latitud, double Longitud);
    private List<CandidataPata> candidatasPatas = new();
    private HashSet<string> codigosPatasSeleccionadas = new();
    private bool mostrarVinculacionPatas = false;

    // ---------- Buscador de torres sobre el mapa (panel flotante) ----------
    private string filtroBuscadorTorres = "";
    private bool mostrarListaTorres = true;

    // ---------- Tabla completa de torres cargadas (KMZ/Excel) ----------
    // A diferencia del buscador flotante (compacto, para ubicar rápido en
    // el mapa) y de la tabla de componentes de la torre seleccionada
    // (navegar sus patas/elementos), esta es la representación completa,
    // en tabla, de todos los puntos cargados — con scroll propio porque
    // puede ser muy extensa.
    private string filtroTablaTorres = "";

    // ---------- Vista del mapa: valores por defecto (íconos, colores, capa
    // base). El ícono/color de cada torre o pata se puede sobrescribir
    // individualmente desde su propia ficha; estos son solo el "respaldo"
    // para cuando el elemento no tiene su propio override. ----------
    private string configIconoTorre = "torre";
    private string configColorTorre = "#EC1C24";
    private string configIconoPata = "pedestal";
    private string configColorPata = "#666666";
    private string configCapaBase = "calle";

    // Formas genéricas de ícono disponibles para torres y patas (además
    // del "pedestal" realista, que solo tiene sentido para patas). Los
    // valores coinciden con las claves de wwwroot/js/mapaTrazado.js.
    private static readonly (string Valor, string Etiqueta)[] OpcionesIconoMapa =
    {
        ("torre", "Silueta de torre"),
        ("pin", "Pin (como Google Maps)"),
        ("circulo", "Punto simple"),
        ("cuadrado", "Cuadrado"),
        ("diamante", "Diamante"),
        ("triangulo", "Triángulo"),
        ("estrella", "Estrella")
    };

    // ---------- Capas (una por cada carga de KMZ/Excel) ----------
    // Agrupan las torres que llegaron juntas en una misma carga, para
    // poder identificar qué se cargó, apagar su visibilidad sin borrar
    // nada, renombrarla, o mandar sus torres a la Papelera de una vez.
    private List<CapaTrazado> capas = new();
    private Dictionary<int, int> conteoTorresPorCapa = new();
    private bool mostrarCapas = false;
    private bool mostrarDatosAdicionales = false;
    private bool mostrarUnificarTorres = false;
    private bool mostrarInspeccionarCad = false;
    private bool mostrarImportarCad = false;

    // Después de crear elemento(s) desde un DWG/DXF: refrescar lo que haya
    // en pantalla (lista de componentes de la torre, si está abierta, y el
    // mapa, para que se vea la geometría recién dibujada).
    private async Task ImportacionCadCompletada()
    {
        RecargarComponentesDeLaTorre();
