                                                            var idA = a.Id;
                                                            <label class="vp-hoja" title="@a.NombreOriginal">
                                                                <input type="checkbox" checked="@seleccionVincular.Contains(idA)" @onchange="e => MarcarHojaVincular(idA, e.Value is true)" />
                                                                <span class="vp-hoja-nom">@a.NombreOriginal</span>
