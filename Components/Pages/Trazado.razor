        archivoParametroPendienteEliminar = null;
    }

    private async Task GuardarRegistro(ParametroActividad p)
    {
        var r = registrosEditables[p.Id];

        // Si no hay nada que guardar (ni marcado, ni observación) y
        // todavía no existía en la base de datos, no crea una fila vacía.
        // (Si ya tiene archivos adjuntos, el registro ya se creó al
        // subirlos, así que r.Id ya no será 0 en ese caso.)
        if (r.Id == 0 && !r.Completado && string.IsNullOrWhiteSpace(r.Observaciones) && r.FechaFacturado is null)
        {
            return;
        }

        if (r.Id == 0)
        {
            Db.RegistrosParametro.Add(r);
        }
        else
        {
            Db.RegistrosParametro.Update(r);
        }

        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();

        mensajesGuardado[p.Id] = "Guardado ✓";
        CargarRegistrosVinculadosComponente();
        RecalcularPctPie();
    }

    private void RecalcularPctPie() =>
        pctPie = elementoSeleccionado is null ? new(null, 0, 0) : SigWeb.Data.Pie.CumplimientoPie.DeTorre(Db, elementoSeleccionado.Id);

    private void CerrarModalComponente()
    {
        RecalcularPctPie();
        mostrarModalComponente = false;
        componenteSeleccionado = null;
        parametrosDeActividad = new();
        registrosEditables = new();
        mensajesGuardado = new();
        registrosVinculadosComponente = new();
        archivosPorParametro = new();
        camposExtraComponente = new();
        archivosDelComponente = new();
        actividadesDelComponente = new();
        actividadesPermitidasIds = new();
        mostrarConfigActividadesComponente = false;
        // Abierta desde Avance de obra (?volver=…): cerrar la ficha regresa allá (a la pantalla anterior).
        if (AtrasLinea3D is { } url) _ = JS.VolverAsync(url);
    }

    // Cierra el diálogo de importación de "datos adicionales" (tabla de
    // torres en Excel) y refresca lo que puede haber cambiado: los datos
    // extra de la torre seleccionada y las patas dibujadas en el mapa
    // (si el usuario cargó coordenadas por pata).
    private async Task CerrarDatosAdicionales()
    {
        mostrarDatosAdicionales = false;
        if (elementoSeleccionado is not null)
        {
            SeleccionarElemento(elementoSeleccionado.Id);
        }
        await DibujarMapa();
    }

    // Cierra el diálogo de "Unificar torres duplicadas" y refresca todo
    // lo que pudo cambiar: la torre eliminada ya no está en el mapa, la
    // que sobrevivió puede tener datos nuevos, y las capas pueden haber
    // quedado con menos torres activas.
    private async Task CerrarUnificarTorres()
    {
        mostrarUnificarTorres = false;
        CargarCapas();
        CargarElementos();
        if (elementoSeleccionado is not null)
        {
            SeleccionarElemento(elementoSeleccionado.Id);
        }
        await DibujarMapa();
    }

    public async ValueTask DisposeAsync()
    {
        referencia?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("destruirMapaTrazado");
        }
        catch (Exception)
        {
            // Si al momento de limpiar el mapa la página ya se está cerrando o
            // navegando a otra parte, el circuito de Blazor puede lanzar distintos
            // tipos de excepción según el momento exacto. No hay nada que limpiar
            // si el navegador ya no está ahí, así que se ignora.
        }
    }
}
