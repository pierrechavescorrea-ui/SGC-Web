    // Compatibilidad: vincular una sola hoja.
    private Task VincularPlano(int archivoPlanoMaestroId) => VincularArchivosAsync(new() { archivoPlanoMaestroId });

    private async Task VincularArchivosAsync(List<int> idsArchivos)
    {
        if (componenteSeleccionado is null || elementoSeleccionado is null || idsArchivos.Count == 0 || vinculando) return;
        vinculando = true; mensajeVincular = null; errorVincular = false;
        try
        {
            // Torres destino según el alcance.
            var torres = new List<int> { elementoSeleccionado.Id };
            if (alcanceVincular == "familia" && tipoTorreVincular is { Familia: { Length: > 0 } fam })
                torres = tiposTorresVincular.Where(kv => kv.Value.Familia == fam).Select(kv => kv.Key).ToList();
            else if (alcanceVincular == "tipo" && tipoTorreVincular is { } tt && !string.IsNullOrWhiteSpace(tt.Texto))
                torres = tiposTorresVincular.Where(kv => NormTipo(kv.Value.Texto) == NormTipo(tt.Texto)).Select(kv => kv.Key).ToList();

            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            // Mismo elemento en cada torre: la hoja de vida, o el elemento con el mismo nombre (Pata A…).
            var esHv = componenteSeleccionado.EsHojaDeVida;
            var nombre = componenteSeleccionado.Nombre.Trim().ToLower();
            var comps = alcanceVincular == "ficha"
                ? new List<int> { componenteSeleccionado.Id }
                : await db.Componentes.AsNoTracking()
                    .Where(c => torres.Contains(c.ElementoTrazadoId) && !c.Eliminado && (esHv ? c.EsHojaDeVida : !c.EsHojaDeVida && c.Nombre.Trim().ToLower() == nombre))
                    .Select(c => c.Id).ToListAsync();
            var existentes = (await db.ComponentesPlano.AsNoTracking()
                    .Where(v => comps.Contains(v.ComponenteId) && idsArchivos.Contains(v.ArchivoPlanoMaestroId))
                    .Select(v => new { v.ComponenteId, v.ArchivoPlanoMaestroId }).ToListAsync())
                .Select(v => (v.ComponenteId, v.ArchivoPlanoMaestroId)).ToHashSet();
            var nuevos = 0;
            foreach (var c in comps)
                foreach (var a in idsArchivos.Distinct())
                    if (existentes.Add((c, a))) { db.ComponentesPlano.Add(new ComponentePlano { ComponenteId = c, ArchivoPlanoMaestroId = a }); nuevos++; }
            await db.SaveChangesAsync();

            var hojas = idsArchivos.Distinct().Count();
            mensajeVincular = comps.Count <= 1
                ? $"{hojas} hoja{(hojas == 1 ? "" : "s")} vinculada{(hojas == 1 ? "" : "s")}" + (nuevos < hojas ? $" ({hojas - nuevos} ya estaban)." : ".")
                : $"{hojas} hoja{(hojas == 1 ? "" : "s")} en {comps.Count} fichas: {nuevos} vínculos nuevos" + (nuevos < hojas * comps.Count ? $", {hojas * comps.Count - nuevos} ya existían." : ".");
            seleccionVincular.Clear(); modoManualVincular = false;
            CargarPlanosVinculadosDelComponente();
            RecalcularVincular();
        }
        catch (Exception ex) { errorVincular = true; mensajeVincular = "No se pudieron vincular: " + ex.Message; }
        finally { vinculando = false; }
    }

