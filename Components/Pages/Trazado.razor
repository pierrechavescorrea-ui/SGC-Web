                                                    <div class="vp-grupo">
                                                        <label class="vp-grupo-cab">
                                                            <input type="checkbox" checked="@(marcadas == grupo.Archivos.Count)" @onchange="e => MarcarGrupoVincular(grupo, e.Value is true)" />
                                                            <strong>@grupo.Raiz</strong>
                                                            <span class="text-muted small">@marcadas / @grupo.Archivos.Count</span>
                                                        </label>
