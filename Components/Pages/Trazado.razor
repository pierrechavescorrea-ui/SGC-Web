    private async Task CargarArchivosComponente(InputFileChangeEventArgs e)
    {
        if (componenteSeleccionado is null) return;

        const long maxBytes = 15 * 1024 * 1024; // 15 MB por archivo (planos pueden pesar más)
        var carpeta = Path.Combine(Env.WebRootPath, "uploads", "trazado");
        Directory.CreateDirectory(carpeta);

        foreach (var archivo in e.GetMultipleFiles(10))
        {
            if (archivo.Size > maxBytes)
            {
                mensaje = $"\"{archivo.Name}\" supera 15 MB y se omitió.";
                error = true;
                continue;
            }

            var extension = Path.GetExtension(archivo.Name);
            var nombreArchivo = $"{Guid.NewGuid()}{extension}";
            var rutaFisica = Path.Combine(carpeta, nombreArchivo);

            await using var stream = archivo.OpenReadStream(maxBytes);
            await using var destino = File.Create(rutaFisica);
            await stream.CopyToAsync(destino);

            Db.ArchivosComponente.Add(new ArchivoComponente
            {
                ComponenteId = componenteSeleccionado.Id,
                NombreOriginal = archivo.Name,
                RutaArchivo = $"/uploads/trazado/{nombreArchivo}"
            });
        }

        await Db.SaveChangesAsync();
        Db.ChangeTracker.Clear();
        CargarArchivosDelComponente();
    }

    // Igual que con los adjuntos de checklist: pide confirmación y solo
    // marca Eliminado = true (va a la Papelera).
    private void PedirEliminarArchivoComponente(ArchivoComponente archivo)
    {
        archivoComponentePendienteEliminar = archivo;
