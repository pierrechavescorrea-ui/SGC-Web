                                                @foreach (var rr in porPata.Where(x => !string.IsNullOrWhiteSpace(x.Resumen)).OrderByDescending(x => x.Fecha).Take(5))
                                                {
                                                    <div class="hv-ens-res">@(rr.Fecha is DateTime fr ? fr.ToString("dd/MM/yyyy") + " · " : "")@rr.Resumen</div>
                                                }
                                                @foreach (var idInforme in porPata.Where(x => x.InformeId is not null).Select(x => x.InformeId!.Value).Distinct())
