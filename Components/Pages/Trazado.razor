                                        @foreach (var d in h.DondeTexto.Split(", ", StringSplitOptions.RemoveEmptyEntries)) { <span class="rg-chip">@d</span> }
                                        <span class="ms-auto"><ValorCatalogo Tipo="@SigWeb.Data.Riesgos.SembradorCatalogosRiesgo.EstadoHallazgo" Valor="@NombreEstadoHallazgo(h.Hallazgo.Estado)" FondoDef="@ColorEstadoHallazgo(h.Hallazgo.Estado)" TextoDef="#fff" /></span>
