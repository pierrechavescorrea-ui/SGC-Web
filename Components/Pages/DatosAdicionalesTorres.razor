@* Importa la "tabla de torres" en Excel: un archivo con muchos campos
   (coordenadas de la torre y de cada pata, tipo de cimentación, SPT, planos, etc.).
   Es la fuente de la UBICACIÓN de las torres: un código que no existe y trae
   coordenadas de torre se crea (hoja de vida + 4 patas); uno que existe se mueve.
   El encabezado de esa tabla suele venir repartido en varias filas (un
   título general arriba, y A/B/C/D debajo, cada letra en su propia
   columna), así que no se intenta adivinar el resultado final: se
   muestran las filas de encabezado tal cual, con un valor de ejemplo, y
   el usuario confirma o corrige a qué campo va cada columna antes de
   importar. *@
@page "/trazado/datos-adicionales"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Trazado
@using SigWeb.Models
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SigWeb.Data.Trazado.AlmacenArchivosCarga AlmacenArchivos
@inject IWebHostEnvironment Env

<PageTitle>Datos adicionales de torres</PageTitle>

<EncabezadoPagina Titulo="Datos adicionales de torres" Icono="trazado" Subtitulo="@SubtituloPaso" Atras="/trazado">
    <Acciones>
        @if (paso == "mapeo" && tabla is not null)
        {
            <button type="button" class="pg-btn @(verVista ? "activo" : "")" title="Vista previa de los datos" aria-label="Vista previa de los datos" @onclick="() => verVista = !verVista">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v14H4zM4 10h16M4 15h16M10 5v14"/></svg>
            </button>
            <button type="button" class="pg-btn pg-btn-primario" disabled="@(!TieneIdentificador || importando || ColumnasRepetidas.Count > 0)" title="@(ColumnasRepetidas.Count > 0 ? "Hay columnas que van al mismo campo: corrígelas" : $"Continuar ({tabla.Filas.Count} fila(s))")" @onclick="RevisarAntesDeImportar">
                @(importando ? "Revisando..." : $"Continuar ({tabla.Filas.Count})")
            </button>
        }
        else if (paso == "conflictos")
        {
            <button type="button" class="pg-btn" title="Volver a las columnas" @onclick='() => paso = "mapeo"'><Ico Nombre="tabla" /></button>
            <button type="button" class="pg-btn pg-btn-primario" disabled="@importando" title="Continuar" @onclick="PrepararComparacion">@(importando ? "Comparando..." : "Continuar")</button>
        }
        else if (paso == "comparar")
        {
            <button type="button" class="pg-btn" title="Volver a las columnas (no se pierde lo elegido)" disabled="@importando" @onclick='() => paso = "mapeo"'><Ico Nombre="tabla" /></button>
            <button type="button" class="pg-btn pg-btn-primario" disabled="@importando" @onclick="Aplicar">@(importando ? "Importando..." : "Confirmar e importar")</button>
        }
    </Acciones>
</EncabezadoPagina>

<style>
    .dat-torre { border: 1px solid var(--bs-border-color, #dee2e6); border-radius: 8px; padding: 8px 10px; margin-bottom: 8px; background: var(--bs-body-bg, #fff); }
    .dat-excluida { opacity: .5; }
    .dat-torre-cab { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
    .dat-cambio { display: grid; grid-template-columns: minmax(140px, 32%) 1fr auto 1fr; gap: 8px; font-size: .84rem; padding: 2px 0; align-items: baseline; }
    .dat-cambio-campo { color: var(--bs-secondary-color, #6c757d); }
    .dat-antes { text-decoration: line-through; color: var(--bs-danger, #dc3545); overflow-wrap: anywhere; }
    .dat-ahora { color: var(--bs-success, #198754); font-weight: 600; overflow-wrap: anywhere; }
    .dat-pestanas { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }
    .dat-nuevas { display: flex; flex-wrap: wrap; gap: 6px 14px; max-height: 9rem; overflow: auto; font-size: .85rem; }
    .dat-nueva { display: inline-flex; align-items: center; gap: 5px; margin: 0; cursor: pointer; }
    /* Vista previa del Excel: celdas con aire y sin partir números/códigos. */
    .dat-vista table.tabla-compacta > :not(caption) > * > * { padding: .4rem .9rem; white-space: nowrap; }
    .dat-vista thead th { vertical-align: bottom; line-height: 1.25; }
    /* Tabla de columnas: filas separadas y encabezados legibles. */
    table.dat-map { table-layout: fixed; width: 100%; }
    table.dat-map > :not(caption) > * > * { padding: .65rem .85rem; vertical-align: middle; }
    table.dat-map thead th { background: var(--t-solido-2, var(--t-superficie-2, var(--bs-body-bg, #fff))); font-size: .8rem; letter-spacing: .02em;
                             color: var(--t-texto-2, var(--bs-secondary-color, #6c757d)); }
    table.dat-map tbody tr + tr > td { border-top: 1px solid var(--t-borde, var(--bs-border-color-translucent, rgba(0,0,0,.08))); }
    .dat-col { display: flex; gap: .6rem; align-items: flex-start; min-width: 0; }
    .dat-col-letra { flex: none; min-width: 1.7rem; height: 1.7rem; padding: 0 .35rem; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;
                     font-size: .75rem; font-weight: 700; background: var(--t-superficie-2, var(--bs-secondary-bg, #e9ecef)); color: var(--t-texto-2, var(--bs-secondary-color, #6c757d)); }
    .dat-col-nom { font-size: .88rem; line-height: 1.3; min-width: 0; overflow-wrap: anywhere; }
    .dat-col-nom .dat-col-sub { display: block; font-size: .78rem; color: var(--bs-secondary-color, #6c757d); }
    .dat-ejemplo { font-size: .85rem; color: var(--bs-secondary-color, #6c757d); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-variant-numeric: tabular-nums; }
    /* Detalle: lista de campos + nombre del campo nuevo + marca, en una línea que no se aprieta. */
    .dat-campo { display: grid; grid-template-columns: minmax(11rem, 15rem) minmax(10rem, 1fr) auto; gap: .5rem; align-items: center; flex: 1; min-width: 0; }
    .dat-campo.existente { grid-template-columns: minmax(11rem, 1fr) auto; }
    .dat-campo select, .dat-campo input { min-width: 0; width: 100%; white-space: nowrap; text-overflow: ellipsis; }
    .dat-detalle { display: flex; gap: .5rem; align-items: center; }
    .dat-detalle > .dat-pata { flex: none; width: 6.5rem; }
    @@media (max-width: 1100px) {
        .dat-campo, .dat-campo.existente { grid-template-columns: 1fr auto; }
        .dat-campo input { grid-column: 1; }
    }
</style>
<div class="dat-modulo">
        @if (paso == "subir")
        {

            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-5">
                    <label class="form-label mb-1 small">Archivo Excel</label>
                    @if (archivoPrevio is not null)
                    {
                        <div class="form-control form-control-sm d-flex align-items-center gap-2" title="Elegido en Bases de datos">
                            <Ico Nombre="excel" /><span class="text-truncate">@archivoPrevio.Nombre</span>
                        </div>
                    }
                    else
                    {
                        <InputFile class="form-control form-control-sm" OnChange="SeleccionarArchivo" accept=".xlsx" />
                    }
                </div>
                @if (hojasLibro.Count > 1)
                {
                    <div class="col-md-3">
                        <label class="form-label mb-1 small">Hoja</label>
                        <select class="form-select form-select-sm" @bind="hojaElegida" @bind:after="CambiarHoja">
                            @foreach (var h in hojasLibro)
                            {
                                <option value="@h.Nombre">@h.Nombre@(h.Visible ? "" : " (oculta)") · @h.Filas filas</option>
                            }
                        </select>
                    </div>
                }
                <div class="col-md-3">
                    <label class="form-label mb-1 small">Filas de encabezado</label>
                    <input type="number" class="form-control form-control-sm" min="1" max="6" @bind="filasEncabezado" />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Revisión *</label>
                    <input class="form-control form-control-sm" placeholder="Ej: A29-10" @bind="versionReferencia" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label mb-1 small">Fecha de la revisión</label>
                    <input type="date" class="form-control form-control-sm" @bind="fechaRevision" />
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label mb-1 small">Comunicado o descripción de los cambios (opcional)</label>
                <textarea class="form-control form-control-sm" rows="3" placeholder="Pega aquí el texto del comunicado (movimientos de torres, ajustes de cimentaciones…)" @bind="descripcionRevision"></textarea>
            </div>
            @if (revisionYaCargada is { } ya)
            {
                <div class="alert alert-warning py-1 small">La revisión <strong>@ya.Codigo</strong> ya se cargó el @ya.FechaCarga.ToString("dd/MM/yyyy HH:mm") (@ya.Estado). Puedes cargarla de nuevo como corrección; solo se aplicará lo que cambie.</div>
            }

            @if (!string.IsNullOrEmpty(errorArchivo))
            {
                <div class="alert alert-warning py-1">@errorArchivo</div>
            }

            <div class="frm-pie frm-pie-plano">
                <button class="btn btn-secondary btn-sm" @onclick="Cerrar" title="Cancelar"><Ico Nombre="cancelar" /></button>
                <button class="btn btn-primary btn-sm" disabled="@((archivoCargado is null && archivoPrevio is null) || string.IsNullOrWhiteSpace(versionReferencia))" title="@(string.IsNullOrWhiteSpace(versionReferencia) ? "Escribe la revisión" : "Leer archivo")" @onclick="LeerArchivo">
                    <Ico Nombre="aceptar" />
                </button>
            </div>
        }
        else if (paso == "mapeo" && tabla is not null)
        {
            @if (ColumnasRepetidas.Count > 0)
            {
                <div class="alert alert-danger py-1 small">
                    <strong>Columnas que van al mismo campo</strong> (la última pisaría a la otra):
                    @foreach (var g in ColumnasRepetidas) { <div>@g.Destino: columnas @string.Join(" y ", g.Columnas)</div> }
                    Cambia el campo de una de ellas (p. ej. elige otro existente o «➕ Campo nuevo…») o ignórala.
                </div>
            }

            @if (!TieneCoordenadaTorre)
            {
                <div class="alert alert-warning py-1 small">
                    Ninguna columna está marcada como <strong>Coordenada de la torre</strong> (Este y Norte). La ubicación de las torres en el
                    mapa sale de esta tabla: sin ellas no se crean torres nuevas ni se actualiza su ubicación.
                </div>
            }
            @if (mapeos.Any(m => m.Destino is TipoDestino.CoordenadaPata or TipoDestino.CoordenadaTorre))
            {
                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-6">
                        <label class="form-label mb-1 small">Sistema de coordenadas (torre y patas)</label>
                        <select class="form-select form-select-sm" @bind="sistemaSeleccionado">
                            <option value="@SistemaCoordenadas.Geograficas">Geográficas (Lat/Lon, grados decimales)</option>
                            <option value="@SistemaCoordenadas.MagnaBogota">MAGNA-SIRGAS — Origen Bogotá (planas)</option>
                            <option value="@SistemaCoordenadas.Utm17N">UTM zona 17N</option>
                            <option value="@SistemaCoordenadas.Utm18N">UTM zona 18N</option>
                            <option value="@SistemaCoordenadas.Utm19N">UTM zona 19N</option>
                        </select>
                    </div>
                </div>
            }

            @if (verVista)
            {
                <div class="dat-vista">
                    <table class="table table-sm tabla-compacta align-middle mb-0">
                        <thead>
                            <tr>
                                @for (int i = 0; i < mapeos.Count; i++)
                                {
                                    var mp = mapeos[i];
                                    <th class="@(mp.Destino == TipoDestino.Ignorar ? "dat-ign" : "")" title="@mp.Columna.EncabezadoVisible">
                                        <div class="text-muted small">@mp.Columna.Direccion</div>
                                        <div>@EtiquetaDestino(mp)</div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fila in tabla.Filas.Take(15))
                            {
                                <tr>
                                    @for (int i = 0; i < mapeos.Count; i++)
                                    {
                                        <td class="small @(mapeos[i].Destino == TipoDestino.Ignorar ? "dat-ign" : "")">@(i < fila.Length ? fila[i] : "")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="dat-scroll">
                <table class="table table-sm align-middle dat-map">
                    <thead style="position: sticky; top: 0; z-index: 1;">
                        <tr>
                            <th style="width: 24%;">Columna (encabezado)</th>
                            <th style="width: 12%;">Ejemplo</th>
                            <th style="width: 18%;">Migrar como</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in mapeos)
                        {
                            var lineas = m.Columna.Encabezados.Where(l => !string.IsNullOrWhiteSpace(l)).ToList();
                            <tr class="@(EsRepetida(m) ? "table-danger" : "")">
                                <td>
                                    <div class="dat-col" title="@m.Columna.EncabezadoVisible">
                                        <span class="dat-col-letra">@m.Columna.Direccion</span>
                                        <div class="dat-col-nom">
                                            @if (lineas.Count > 0)
                                            {
                                                <strong>@lineas[0]</strong>
                                                @foreach (var linea in lineas.Skip(1))
                                                {
                                                    <span class="dat-col-sub">@linea</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><div class="dat-ejemplo" title="@m.Columna.Ejemplo">@m.Columna.Ejemplo</div></td>
                                <td>
                                    <select class="form-select form-select-sm" @bind="m.Destino">
                                        <option value="@TipoDestino.Ignorar">Ignorar</option>
                                        <option value="@TipoDestino.IdentificadorTorre">Identificador de torre</option>
                                        <option value="@TipoDestino.CoordenadaTorre">Coordenada de la torre</option>
                                        <option value="@TipoDestino.CampoTorre">Campo de la torre</option>
                                        <option value="@TipoDestino.CoordenadaPata">Coordenada de pata</option>
                                        <option value="@TipoDestino.CampoPata">Campo de la pata</option>
                                    </select>
                                </td>
                                <td>
                                    @if (m.Destino == TipoDestino.CampoTorre)
                                    {
                                        @SelectorCampo(m, clavesTorre)
                                    }
                                    else if (m.Destino == TipoDestino.CampoPata)
                                    {
                                        <div class="dat-detalle">
                                            <select class="form-select form-select-sm dat-pata" @bind="m.PataLetra">
                                                <option value="A">Pata A</option>
                                                <option value="B">Pata B</option>
                                                <option value="C">Pata C</option>
                                                <option value="D">Pata D</option>
                                            </select>
                                            @SelectorCampo(m, clavesPata)
                                        </div>
                                    }
                                    else if (m.Destino == TipoDestino.CoordenadaPata)
                                    {
                                        <div class="dat-detalle">
                                            <select class="form-select form-select-sm dat-pata" @bind="m.PataLetra">
                                                <option value="A">Pata A</option>
                                                <option value="B">Pata B</option>
                                                <option value="C">Pata C</option>
                                                <option value="D">Pata D</option>
                                            </select>
                                            <select class="form-select form-select-sm" @bind="m.EjeCoordenada">
                                                <option value="Este">Este / Longitud</option>
                                                <option value="Norte">Norte / Latitud</option>
                                            </select>
                                        </div>
                                    }
                                    else if (m.Destino == TipoDestino.CoordenadaTorre)
                                    {
                                        <div class="dat-detalle">
                                            <select class="form-select form-select-sm" style="max-width: 15rem;" @bind="m.EjeCoordenada">
                                                <option value="Este">Este / Longitud</option>
                                                <option value="Norte">Norte / Latitud</option>
                                            </select>
                                            <span class="badge text-bg-info" title="Ubica la torre en el mapa, Avance de obra y Línea 3D">Ubicación</span>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!TieneIdentificador)
            {
                <div class="alert alert-warning py-1 mt-2">
                    Marca una columna como "Identificador de torre" (normalmente "NÚMERO DE TORRE" o "Código") para poder importar.
                </div>
            }

            <div class="d-flex justify-content-end gap-2 mt-2">
                <button class="btn btn-secondary btn-sm" @onclick="Cerrar" title="Cancelar"><Ico Nombre="cancelar" /></button>
            </div>
        }
        else if (paso == "conflictos")
        {

            <div class="dat-scroll">
                <table class="table table-sm tabla-compacta align-middle">
                    <thead style="position: sticky; top: 0; background: #fff;">
                        <tr>
                            <th>Código en el archivo</th>
                            <th>Torre existente parecida</th>
                            <th style="width: 220px;">Decisión</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in conflictos)
                        {
                            <tr>
                                <td>@c.CodigoFila</td>
                                <td>@c.TorreSugerida.Codigo</td>
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="@("decision_" + c.CodigoFila)"
                                               checked="@(c.Decision == "Omitir")" @onchange="@(() => c.Decision = "Omitir")" />
                                        <label class="form-check-label">Omitir</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="@("decision_" + c.CodigoFila)"
                                               checked="@(c.Decision == "Migrar")" @onchange="@(() => c.Decision = "Migrar")" />
                                        <label class="form-check-label">Migrar a @c.TorreSugerida.Codigo</label>
                                    </div>
                                    @if (TieneCoordenadaTorre)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="@("decision_" + c.CodigoFila)"
                                                   checked="@(c.Decision == "Nueva")" @onchange="@(() => c.Decision = "Nueva")" />
                                            <label class="form-check-label">Son torres distintas: crear @c.CodigoFila</label>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-2">
                <button class="btn btn-secondary btn-sm" @onclick="Cerrar" title="Cancelar"><Ico Nombre="cancelar" /></button>
            </div>
        }
        else if (paso == "comparar")
        {
            <div class="dat-pestanas mb-2">
                <span class="pg-vistas">
                    <button type="button" class="pg-btn @(vistaComparar == "torres" ? "activo" : "")" title="Cambios por torre" @onclick='() => vistaComparar = "torres"'><Ico Nombre="torre" /></button>
                    <button type="button" class="pg-btn @(vistaComparar == "columnas" ? "activo" : "")" title="Resumen por columna" @onclick='() => vistaComparar = "columnas"'><Ico Nombre="tabla" /></button>
                </span>
                <span class="small text-muted ms-2">Revisión <strong>@versionReferencia.Trim()</strong></span>
            </div>
            @if (fueraDeRango.Count > 0)
            {
                <div class="alert alert-danger py-1 small">
                    <strong>@fueraDeRango.Count torre(s) quedan fuera de Colombia</strong> con el sistema <strong>@sistemaSeleccionado</strong>: no se
                    ubican ni se crean. Revise el sistema de coordenadas en el paso de Columnas. @string.Join(", ", fueraDeRango.Take(20))@(fueraDeRango.Count > 20 ? "…" : "")
                </div>
            }
            @if (vistaComparar == "torres")
            {
                <div class="dat-scroll">
                    @if (torresNuevas.Count > 0)
                    {
                        <div class="dat-torre" title="Códigos del archivo que aún no existen: se crean con su ubicación, su hoja de vida y sus 4 patas. Desmarque las que no quiera crear.">
                            <div class="dat-torre-cab"><strong>Torres nuevas (@torresNuevas.Count(c => !torresExcluidas.Contains(c)) de @torresNuevas.Count)</strong><span class="badge text-bg-success">Se crean</span></div>
                            <div class="dat-nuevas">
                                @foreach (var cod in torresNuevas.Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(NumeroTorre).ThenBy(c => c))
                                {
                                    var c = cod;
                                    <label class="dat-nueva @(torresExcluidas.Contains(c) ? "dat-excluida" : "")">
                                        <input type="checkbox" checked="@(!torresExcluidas.Contains(c))" @onchange="e => { if (e.Value is true) torresExcluidas.Remove(c); else torresExcluidas.Add(c); }" />
                                        @c
                                    </label>
                                }
                            </div>
                        </div>
                    }
                    @if (cambiosPorTorre.Count == 0)
                    {
                        <p class="text-muted small">Ningún valor ya cargado cambia en esta revisión@(resumen.Sum(r => r.Nuevos) > 0 ? $"; solo se agregan {resumen.Sum(r => r.Nuevos)} dato(s) nuevo(s)" : "").</p>
                    }
                    @foreach (var t in cambiosPorTorre.Values.OrderBy(x => NumeroTorre(x.Codigo)).ThenBy(x => x.Codigo))
                    {
                        var torreP = t;
                        var excluida = torresExcluidas.Contains(torreP.Codigo);
                        <div class="dat-torre @(excluida ? "dat-excluida" : "")">
                            <div class="dat-torre-cab">
                                <label class="d-flex align-items-center gap-2 mb-0" title="@(excluida ? "No se aplicará a esta torre" : "Se aplicará")">
                                    <input type="checkbox" checked="@(!excluida)" @onchange="e => { if (e.Value is true) torresExcluidas.Remove(torreP.Codigo); else torresExcluidas.Add(torreP.Codigo); }" />
                                    <strong>@torreP.Codigo</strong>
                                </label>
                                <span class="small text-muted">@torreP.Cambios.Count cambio@(torreP.Cambios.Count == 1 ? "" : "s")@(torreP.Nuevos > 0 ? $" · {torreP.Nuevos} dato(s) nuevo(s)" : "")</span>
                            </div>
                            @foreach (var c in torreP.Cambios)
                            {
                                <div class="dat-cambio"><span class="dat-cambio-campo">@(c.Ambito == "Torre" ? "" : c.Ambito + " · ")@c.Clave</span><span class="dat-antes">@c.Antes</span><span>→</span><span class="dat-ahora">@c.Ahora</span></div>
                            }
                            <input class="form-control form-control-sm mt-1" data-sin-flotante placeholder="Observación de esta torre (p. ej. del comunicado)" value="@(observacionTorre.GetValueOrDefault(torreP.Codigo))"
                                   @onchange="e => observacionTorre[torreP.Codigo] = e.Value?.ToString() ?? string.Empty" />
                        </div>
                    }
                    @if (torresNoEncontradas.Count > 0)
                    {
                        <div class="small mt-1 text-warning" title="Filas omitidas: sin coordenadas de torre para crearla, o marcadas Omitir en Coincidencias"><strong>Se omiten (@torresNoEncontradas.Count):</strong> @string.Join(", ", torresNoEncontradas.Take(30))@(torresNoEncontradas.Count > 30 ? "…" : "")</div>
                    }
                </div>
            }
            else
            {
            <div class="dat-scroll">
                <table class="table table-sm tabla-compacta align-middle">
                    <thead style="position: sticky; top: 0; background: #fff;">
                        <tr>
                            <th>Campo</th><th>Dónde</th><th></th>
                            <th class="text-end" title="Valores que hoy no existen">Nuevos</th>
                            <th class="text-end" title="Valores distintos a los cargados">Cambiados</th>
                            <th class="text-end" title="Valores iguales: no se tocan">Iguales</th>
                            <th class="text-center" title="Reemplazar los valores cambiados (los anteriores van a la Papelera)">Reemplazar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in resumen)
                        {
                            <tr>
                                <td>@r.Clave</td>
                                <td class="small text-muted">@r.Ambito</td>
                                <td>@if (r.Nueva) { <span class="badge bg-success" title="Columna que antes no estaba cargada">Nueva</span> }</td>
                                <td class="text-end">@r.Nuevos</td>
                                <td class="text-end">
                                    @if (r.Cambiados > 0) { <button type="button" class="btn btn-link btn-sm p-0" title="Ver cambios" @onclick="() => r.Detalle = !r.Detalle">@r.Cambiados</button> } else { <span>0</span> }
                                </td>
                                <td class="text-end">@r.Iguales</td>
                                <td class="text-center"><input type="checkbox" disabled="@(r.Cambiados == 0)" @bind="r.AplicarCambios" /></td>
                            </tr>
                            @if (r.Detalle)
                            {
                                <tr><td colspan="7" class="small bg-light">
                                    @foreach (var mu in r.Muestras) { <div><strong>@mu.Torre</strong>: @mu.Antes → @mu.Ahora</div> }
                                    @if (r.Cambiados > r.Muestras.Count) { <div class="text-muted">… y @(r.Cambiados - r.Muestras.Count) más</div> }
                                </td></tr>
                            }
                        }
                        @if (ubicNuevas + ubicCambiadas + ubicIguales > 0)
                        {
                            <tr>
                                <td>Ubicación de la torre</td><td class="small text-muted">Torre</td><td></td>
                                <td class="text-end">@ubicNuevas</td><td class="text-end">@ubicCambiadas</td><td class="text-end">@ubicIguales</td>
                                <td class="text-center"><input type="checkbox" disabled="@(ubicCambiadas == 0)" title="Mover las torres a la ubicación nueva (se puede deshacer con la revisión)" @bind="aplicarUbic" /></td>
                            </tr>
                        }
                        @if (coordNuevas + coordCambiadas + coordIguales > 0)
                        {
                            <tr>
                                <td>Coordenadas de pata</td><td class="small text-muted">Patas</td><td></td>
                                <td class="text-end">@coordNuevas</td><td class="text-end">@coordCambiadas</td><td class="text-end">@coordIguales</td>
                                <td class="text-center"><input type="checkbox" disabled="@(coordCambiadas == 0)" title="Usar la ubicación nueva (la anterior no queda en la Papelera)" @bind="aplicarCoord" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (clavesConservadas.Count > 0)
                {
                    <div class="small mt-2" title="Columnas ya cargadas que este archivo no trae: se conservan sin cambios"><strong>Se conservan:</strong> @string.Join(", ", clavesConservadas)</div>
                }
                @if (torresNuevas.Count > 0)
                {
                    <div class="small mt-1 text-success" title="Se crean con su ubicación, hoja de vida y 4 patas"><strong>Torres nuevas (@torresNuevas.Count):</strong> @string.Join(", ", torresNuevas.Take(30))@(torresNuevas.Count > 30 ? "…" : "")</div>
                }
                @if (torresNoEncontradas.Count > 0)
                {
                    <div class="small mt-1 text-warning" title="Sin coordenadas de torre para crearla, o marcadas Omitir en Coincidencias"><strong>Se omiten (@torresNoEncontradas.Count):</strong> @string.Join(", ", torresNoEncontradas.Take(30))@(torresNoEncontradas.Count > 30 ? "…" : "")</div>
                }
            </div>
            }
            <div class="d-flex justify-content-end gap-2 mt-2">
                <button class="btn btn-secondary btn-sm" @onclick="Cerrar" title="Cancelar"><Ico Nombre="cancelar" /></button>
            </div>
        }
        else if (paso == "resultado")
        {
            <div class="alert alert-success">@mensajeResultado</div>

            @if (torresNoEncontradas.Count > 0)
            {
                <div class="alert alert-warning">
                    <strong>@torresNoEncontradas.Count fila(s) omitidas</strong> (sin coordenadas de torre para crearla, o marcadas Omitir):
                    <div class="small mt-1">@string.Join(", ", torresNoEncontradas)</div>
                </div>
            }

            <div class="d-flex justify-content-end">
                <button class="btn btn-primary btn-sm" @onclick="Cerrar" title="Cerrar"><Ico Nombre="cancelar" /></button>
            </div>
        }
</div>

@code {
    // Campos ya cargados (para "Detalle": elegir uno existente o crear uno nuevo).
    // ?revision={id}: corregir las columnas de una revisión ya cargada (se deshizo y se reabre con su archivo y configuración).
    [SupplyParameterFromQuery(Name = "revision")] public int? RevisionQ { get; set; }
    private SigWeb.Data.Trazado.ConfigCargaTabla? configPrevia;
    private List<string> clavesTorre = new();
    private List<string> clavesPata = new();
    private const string CampoNuevo = "__nuevo__";
    private bool verVista = true;

    private string SubtituloPaso => paso switch
    {
        "subir" => "1 · Archivo",
        "mapeo" => "2 · Columnas",
        "conflictos" => "3 · Coincidencias",
        "comparar" => "4 · Comparación",
        _ => "5 · Resultado"
    };

    private static string EtiquetaDestino(MapeoColumna m) => m.Destino switch
    {
        TipoDestino.IdentificadorTorre => "Identificador",
        TipoDestino.CampoTorre => string.IsNullOrWhiteSpace(m.NombreCampo) ? "Campo de la torre" : m.NombreCampo,
        TipoDestino.CoordenadaTorre => $"Torre · {m.EjeCoordenada}",
        TipoDestino.CoordenadaPata => $"Pata {m.PataLetra} · {m.EjeCoordenada}",
        TipoDestino.CampoPata => $"Pata {m.PataLetra} · {m.NombreCampo}",
        _ => "Ignorar"
    };

    // CoordenadaTorre (2026-11-18): la tabla de torres es la ÚNICA fuente de la ubicación de las torres (ya no hay Excel de
    // coordenadas aparte). Este + Norte de la torre → ElementoTrazado.Latitud/Longitud (mapa, Avance de obra, Línea 3D, tendido);
    // un código que no existe y trae coordenadas crea la torre (hoja de vida + 4 patas). Nuevo valor al final: la configuración
    // guardada de revisiones anteriores se lee por nombre (ConfigCargaTabla.Destino).
    private enum TipoDestino { Ignorar, IdentificadorTorre, CampoTorre, CoordenadaPata, CampoPata, CoordenadaTorre }

    private bool TieneCoordenadaTorre =>
        mapeos.Any(m => m.Destino == TipoDestino.CoordenadaTorre && m.EjeCoordenada == "Este") &&
        mapeos.Any(m => m.Destino == TipoDestino.CoordenadaTorre && m.EjeCoordenada == "Norte");

    private class MapeoColumna
    {
        public ColumnaTablaTorres Columna { get; set; } = null!;
        public TipoDestino Destino { get; set; } = TipoDestino.Ignorar;
        public string NombreCampo { get; set; } = "";
        public string PataLetra { get; set; } = "A";
        public string EjeCoordenada { get; set; } = "Este";
    }

    private class ConflictoTorre
    {
        public string CodigoFila { get; set; } = "";
        public ElementoTrazado TorreSugerida { get; set; } = null!;
        public string Decision { get; set; } = "Omitir"; // "Omitir" | "Migrar" — Omitir por defecto (recomendado)
    }

    private string paso = "subir"; // "subir" | "mapeo" | "conflictos" | "resultado"
    private int filasEncabezado = 3;
    private IBrowserFile? archivoCargado;
    private string errorArchivo = "";
    private string versionReferencia = "";
    private DateTime? fechaRevision = DateTime.Today;
    private string? descripcionRevision;
    private RevisionTablaTorres? revisionYaCargada;
    private string vistaComparar = "torres";

    // Vista previa por torre (solo cambios de valores ya cargados y de ubicación de patas) y lo elegido por torre.
    private sealed record CambioVista(string Ambito, string Clave, string? Antes, string Ahora);
    private sealed class TorreVista { public string Codigo = ""; public List<CambioVista> Cambios = new(); public int Nuevos; }
    private Dictionary<int, TorreVista> cambiosPorTorre = new();
    private HashSet<string> torresExcluidas = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string> observacionTorre = new(StringComparer.OrdinalIgnoreCase);

    // Lo que escribió la revisión, para registrarlo como CambioTablaTorres (los Id de los campos se conocen al guardar).
    private sealed record RegistroCambio(ElementoTrazado Torre, int? ComponenteId, string Ambito, string Clave, string? Antes, string? Ahora,
        TipoCambioTabla Tipo, object? CampoNuevo, object? CampoAnterior);
    private List<RegistroCambio> registro = new();

    private TorreVista VistaDe(ElementoTrazado t) =>
        cambiosPorTorre.TryGetValue(t.Id, out var v) ? v : (cambiosPorTorre[t.Id] = new TorreVista { Codigo = t.Codigo });

    private static int NumeroTorre(string codigo)
    {
        var d = new string((codigo ?? "").SkipWhile(c => !char.IsDigit(c)).TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(d, out var n) ? n : int.MaxValue;
    }

    private TablaTorresCruda? tabla;
    private List<MapeoColumna> mapeos = new();
    private SistemaCoordenadas sistemaSeleccionado = SistemaCoordenadas.MagnaBogota;
    private List<ConflictoTorre> conflictos = new();

    private bool importando = false;
    private string mensajeResultado = "";
    private List<string> torresNoEncontradas = new();

    private bool TieneIdentificador => mapeos.Any(m => m.Destino == TipoDestino.IdentificadorTorre);

    // ?archivo={token}: el Excel ya se eligió en Trazado › Bases de datos (AlmacenArchivosCarga).
    [SupplyParameterFromQuery(Name = "archivo")] public string? ArchivoQ { get; set; }
    private SigWeb.Data.Trazado.ArchivoCarga? archivoPrevio;
    private byte[]? bytesLeidos;

    protected override void OnInitialized()
    {
        if (RevisionQ is int idRev && archivoPrevio is null)
        {
            var rv = Db.RevisionesTablaTorres.AsNoTracking().FirstOrDefault(r => r.Id == idRev);
            if (rv is not null && !string.IsNullOrEmpty(rv.RutaArchivo))
            {
                var fisica = Path.Combine(Env.WebRootPath, rv.RutaArchivo.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(fisica))
                {
                    archivoPrevio = new SigWeb.Data.Trazado.ArchivoCarga(rv.NombreArchivo, File.ReadAllBytes(fisica));
                    versionReferencia = rv.Codigo; fechaRevision = rv.Fecha; descripcionRevision = rv.Descripcion;
                    configPrevia = SigWeb.Data.Trazado.ConfigCargaTabla.Leer(fisica);
                }
            }
        }
        archivoPrevio ??= AlmacenArchivos.Ver(ArchivoQ);
        if (archivoPrevio is not null) { SugerirRevision(archivoPrevio.Nombre); if (hojasLibro.Count == 0) ListarHojas(archivoPrevio.Bytes); }
        if (configPrevia is not null)
        {
            if (configPrevia.Hoja is not null && hojasLibro.Any(h => h.Nombre == configPrevia.Hoja)) hojaElegida = configPrevia.Hoja;
            filasEncabezado = configPrevia.FilasEncabezado;
        }
    }

    private void SugerirRevision(string nombre)
    {
        if (string.IsNullOrWhiteSpace(versionReferencia)) versionReferencia = SigWeb.Data.Trazado.ServicioRevisionesTabla.RevisionDesdeNombre(nombre) ?? "";
        var cod = versionReferencia.Trim();
        revisionYaCargada = cod.Length == 0 ? null
            : Db.RevisionesTablaTorres.AsNoTracking().Where(r => r.Codigo == cod && r.Estado != EstadoRevisionTabla.Deshecha).OrderByDescending(r => r.FechaCarga).FirstOrDefault();
    }

    private async Task SeleccionarArchivo(InputFileChangeEventArgs e)
    {
        archivoCargado = e.File;
        archivoPrevio = null;
        errorArchivo = "";
        SugerirRevision(e.File.Name);
        // Se lee ya (el InputFile sigue en pantalla) para listar las hojas del libro.
        try
        {
            await using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            bytesLeidos = ms.ToArray();
            ListarHojas(bytesLeidos);
        }
        catch (Exception ex) { errorArchivo = $"No se pudo leer el archivo: {ex.Message}"; bytesLeidos = null; }
    }

    // Hojas del libro y la sugerida: la primera visible (las ocultas suelen ser auxiliares, p. ej. "Distancias").
    private List<LectorExcelTablaTorres.HojaExcel> hojasLibro = new();
    private string? hojaElegida;

    private void ListarHojas(byte[] bytes)
    {
        try
        {
            using var ms = new MemoryStream(bytes);
            hojasLibro = LectorExcelTablaTorres.Hojas(ms);
            var h = hojasLibro.FirstOrDefault(x => x.Visible) ?? hojasLibro.FirstOrDefault();
            hojaElegida = h?.Nombre;
            if (h is not null) filasEncabezado = h.EncabezadoSugerido;
        }
        catch { hojasLibro = new(); hojaElegida = null; }
    }

    private void CambiarHoja()
    {
        if (hojasLibro.FirstOrDefault(x => x.Nombre == hojaElegida) is { } h) filasEncabezado = h.EncabezadoSugerido;
    }

    private async Task LeerArchivo()
    {
        if (archivoCargado is null && archivoPrevio is null) return;
        errorArchivo = "";

        try
        {
            var bytes = archivoPrevio?.Bytes ?? bytesLeidos;
            if (bytes is null) { errorArchivo = "Vuelve a elegir el archivo."; return; }
            using var ms = new MemoryStream(bytes);
            tabla = LectorExcelTablaTorres.Leer(ms, filasEncabezado, hojaElegida);
        }
        catch (Exception ex)
        {
            errorArchivo = $"No se pudo leer el archivo: {ex.Message}";
            return;
        }

        if (tabla.Columnas.Count == 0)
        {
            errorArchivo = "No se detectaron columnas en la primera hoja del archivo.";
            return;
        }

        clavesTorre = await Db.CamposExtraTorre.AsNoTracking().Where(c => !c.Eliminado).Select(c => c.Clave.Trim()).Distinct().ToListAsync();
        clavesTorre = clavesTorre.Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c, StringComparer.OrdinalIgnoreCase).ToList();
        clavesPata = await Db.CamposExtraComponente.AsNoTracking().Where(c => !c.Eliminado).Select(c => c.Clave.Trim()).Distinct().ToListAsync();
        clavesPata = clavesPata.Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c, StringComparer.OrdinalIgnoreCase).ToList();
        mapeos = tabla.Columnas.Select(SugerirMapeo).ToList();
        // Cada columna se liga al campo existente con el mismo nombre (sin mayúsculas, espacios ni signos): así una
        // revisión nueva ACTUALIZA ese campo en vez de crear otro.
        foreach (var m in mapeos)
        {
            var lista = m.Destino == TipoDestino.CampoPata ? clavesPata : clavesTorre;
            if (lista.FirstOrDefault(c => NormCampo(c) == NormCampo(m.NombreCampo)) is { } existente) m.NombreCampo = existente;
        }
        if (configPrevia is not null)
        {
            foreach (var m in mapeos)
                if (configPrevia.Columnas.FirstOrDefault(c => c.Indice == m.Columna.Indice) is { } cc)
                {
                    m.Destino = Enum.TryParse<TipoDestino>(cc.Destino, out var d) ? d : m.Destino;
                    m.NombreCampo = cc.NombreCampo ?? ""; m.PataLetra = cc.PataLetra ?? "A"; m.EjeCoordenada = cc.EjeCoordenada ?? "Este";
                }
            if (Enum.TryParse<SistemaCoordenadas>(configPrevia.Sistema, out var sis)) sistemaSeleccionado = sis;
            foreach (var kv in configPrevia.Observaciones) observacionTorre[kv.Key] = kv.Value;
        }
        SugerirSistemaCoordenadas();
        paso = "mapeo";
    }

    // ---------- Sugerencia automática (el usuario la revisa y corrige) ----------
    private MapeoColumna SugerirMapeo(ColumnaTablaTorres columna)
    {
        var mapeo = new MapeoColumna { Columna = columna };
        var texto = QuitarTildes(columna.EncabezadoVisible.ToLowerInvariant());

        if (string.IsNullOrWhiteSpace(texto))
        {
            mapeo.Destino = TipoDestino.Ignorar;
            return mapeo;
        }

        if (texto.Contains("numero de torre") || texto.Trim() == "torre" || texto.Contains("codigo de torre") || texto.Contains("codigo torre"))
        {
            mapeo.Destino = TipoDestino.IdentificadorTorre;
            return mapeo;
        }

        var letra = DetectarLetraPata(texto);
        bool pareceCoordenada = texto.Contains("coorden") || texto.Contains("este") || texto.Contains("norte");

        if (letra is not null && pareceCoordenada)
        {
            mapeo.Destino = TipoDestino.CoordenadaPata;
            mapeo.PataLetra = letra;
            mapeo.EjeCoordenada = texto.Contains("norte") && !texto.Contains("este") ? "Norte"
                : (EsUltimaPalabra(texto, "norte") ? "Norte" : "Este");
            return mapeo;
        }

        // Coordenada de la torre: palabras completas (no "este" dentro de "oeste" o "nordeste"), sin letra de pata.
        var palabras = texto.Split(new[] { ' ', '-', '_', '(', ')', ':', '/', '.', ',' }, StringSplitOptions.RemoveEmptyEntries);
        bool sola = palabras.Length == 1;   // "X", "Y", "N", "E" solo cuentan como encabezado completo ("y" suele ser conjunción)
        bool esNorte = palabras.Any(p => p is "norte" or "latitud" or "lat" || (sola && p is "n" or "y"));
        bool esEste = palabras.Any(p => p is "este" or "longitud" or "lon" or "long" || (sola && p is "e" or "x"));
        if (letra is null && (palabras.Any(p => p.StartsWith("coorden")) || palabras.Length <= 2) && esNorte != esEste)
        {
            mapeo.Destino = TipoDestino.CoordenadaTorre;
            mapeo.EjeCoordenada = esNorte ? "Norte" : "Este";
            return mapeo;
        }

        if (letra is not null && (texto.Contains("pata") || texto.Contains("cimentacion") || texto.Contains("plano") || texto.Contains("pedestal")))
        {
            mapeo.Destino = TipoDestino.CampoPata;
            mapeo.PataLetra = letra;
            mapeo.NombreCampo = NombreCampoPorDefecto(columna);
            return mapeo;
        }

        mapeo.Destino = TipoDestino.CampoTorre;
        mapeo.NombreCampo = NombreCampoPorDefecto(columna);
        return mapeo;
    }

    private static bool EsUltimaPalabra(string texto, string palabra)
    {
        var partes = texto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length > 0 && partes[^1] == palabra;
    }

    private string NombreCampoPorDefecto(ColumnaTablaTorres columna)
    {
        var visible = columna.EncabezadoVisible.Trim();
        return visible.Length > 1 ? visible : $"Columna {columna.Direccion}";
    }

    private static string? DetectarLetraPata(string textoMinusculasSinTildes)
    {
        var partes = textoMinusculasSinTildes.Split(new[] { ' ', '-', '_', '(', ')' }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var p in partes)
        {
            if (p.Length == 1 && "abcd".Contains(p)) return p.ToUpperInvariant();
        }
        return null;
    }

    private static string QuitarTildes(string texto) => texto
        .Replace("á", "a").Replace("é", "e").Replace("í", "i")
        .Replace("ó", "o").Replace("ú", "u").Replace("ñ", "n");

    // Sistema: primero lo que diga un encabezado de coordenadas (p. ej. "Sistema de Referencia: Magnas-Sirgas Bogotá"),
    // si no, por la magnitud de un par Este/Norte de ejemplo (de la torre o, si no hay, de una pata). El usuario lo confirma.
    private void SugerirSistemaCoordenadas()
    {
        var coords = mapeos.Where(m => m.Destino is TipoDestino.CoordenadaTorre or TipoDestino.CoordenadaPata).ToList();
        if (coords.Count == 0) return;
        foreach (var m in coords)
        {
            var t = QuitarTildes(m.Columna.EncabezadoVisible.ToLowerInvariant());
            if (t.Contains("magna") && t.Contains("bogota")) { sistemaSeleccionado = SistemaCoordenadas.MagnaBogota; return; }
            if (t.Contains("utm") && t.Contains("17")) { sistemaSeleccionado = SistemaCoordenadas.Utm17N; return; }
            if (t.Contains("utm") && t.Contains("18")) { sistemaSeleccionado = SistemaCoordenadas.Utm18N; return; }
            if (t.Contains("utm") && t.Contains("19")) { sistemaSeleccionado = SistemaCoordenadas.Utm19N; return; }
            if (t.Contains("latitud") || t.Contains("longitud") || t.Contains("geograf") || t.Contains("wgs")) { sistemaSeleccionado = SistemaCoordenadas.Geograficas; return; }
        }

        MapeoColumna? este = coords.FirstOrDefault(m => m.Destino == TipoDestino.CoordenadaTorre && m.EjeCoordenada == "Este");
        MapeoColumna? norte = coords.FirstOrDefault(m => m.Destino == TipoDestino.CoordenadaTorre && m.EjeCoordenada == "Norte");
        if (este is null || norte is null)
        {
            este = coords.FirstOrDefault(m => m.Destino == TipoDestino.CoordenadaPata && m.EjeCoordenada == "Este");
            norte = este is null ? null : coords.FirstOrDefault(m => m.Destino == TipoDestino.CoordenadaPata && m.EjeCoordenada == "Norte" && m.PataLetra == este.PataLetra);
        }
        if (este is null || norte is null) return;

        if (LeerNumero(este.Columna.Ejemplo) is double x && LeerNumero(norte.Columna.Ejemplo) is double y)
            sistemaSeleccionado = ConversorCoordenadas.Detectar(x, y);
    }

    // Número de una celda: punto decimal (lo normal al leer el Excel) o coma decimal si no hay punto.
    private static double? LeerNumero(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        var t = s.Trim().Replace(" ", "");
        if (double.TryParse(t, NumberStyles.Float, CultureInfo.InvariantCulture, out var v)) return v;
        if (!t.Contains('.') && double.TryParse(t.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out v)) return v;
        return null;
    }

    // ---------- Revisión previa (detecta filas que no calzan por código exacto pero se parecen a una torre existente) ----------
    private async Task RevisarAntesDeImportar()
    {
        if (tabla is null || !TieneIdentificador || importando) return;
        importando = true;

        var colIdentificador = mapeos.First(m => m.Destino == TipoDestino.IdentificadorTorre);
        int indiceIdentificador = mapeos.IndexOf(colIdentificador);

        var torres = await Db.ElementosTrazado.AsNoTracking().Where(t => !t.Eliminado).ToListAsync();
        var codigosExactos = torres.Select(t => NormalizarCodigo(t.Codigo)).ToHashSet();

        conflictos = new();
        var vistos = new HashSet<string>();

        foreach (var fila in tabla.Filas)
        {
            var codigoCrudo = fila[indiceIdentificador];
            var codigoTorre = NormalizarCodigo(codigoCrudo);
            if (string.IsNullOrWhiteSpace(codigoTorre)) continue;
            if (codigosExactos.Contains(codigoTorre)) continue;
            if (!vistos.Add(codigoTorre)) continue; // ya evaluado (filas repetidas)

            var parecida = torres.FirstOrDefault(t => DetectorNombresParecidos.SonParecidos(codigoTorre, NormalizarCodigo(t.Codigo)));
            if (parecida is not null)
            {
                conflictos.Add(new ConflictoTorre { CodigoFila = codigoCrudo, TorreSugerida = parecida });
            }
        }

        importando = false;
        if (conflictos.Count > 0) paso = "conflictos";
        else await PrepararComparacion();
    }

    // ---------- Comparar con lo ya cargado, y luego fusionar ----------
    // Nada se borra: una columna nueva se agrega; un valor distinto reemplaza al
    // anterior (que va a la Papelera, recuperable); lo igual no se toca; y las
    // columnas que el archivo no trae se conservan tal cual.
    private class ResumenColumna
    {
        public string Clave { get; set; } = "";
        public string Ambito { get; set; } = "Torre";
        public bool Nueva { get; set; }
        public int Nuevos { get; set; }
        public int Cambiados { get; set; }
        public int Iguales { get; set; }
        public bool AplicarCambios { get; set; } = true;
        public bool Detalle { get; set; }
        public List<(string Torre, string Antes, string Ahora)> Muestras { get; } = new();
    }

    private List<ResumenColumna> resumen = new();
    private List<string> clavesConservadas = new();
    private int coordNuevas, coordCambiadas, coordIguales;
    private bool aplicarCoord = true;
    // Ubicación de la torre (CoordenadaTorre) y torres que la carga crea.
    private int ubicNuevas, ubicCambiadas, ubicIguales;
    private bool aplicarUbic = true;
    private List<string> torresNuevas = new();
    private List<string> fueraDeRango = new();
    private List<int> idsTorresCreadas = new();
    private CapaTrazado? capaCarga;

    // Este/Norte de la torre en esta fila → (lat, lon) WGS84. null = sin coordenadas o fuera de Colombia (sistema equivocado).
    private (double Lat, double Lon)? UbicacionTorre(string[] fila, string codigo)
    {
        var mEste = mapeos.FirstOrDefault(m => m.Destino == TipoDestino.CoordenadaTorre && m.EjeCoordenada == "Este");
        var mNorte = mapeos.FirstOrDefault(m => m.Destino == TipoDestino.CoordenadaTorre && m.EjeCoordenada == "Norte");
        if (mEste is null || mNorte is null) return null;
        int ie = mapeos.IndexOf(mEste), iN = mapeos.IndexOf(mNorte);
        if (LeerNumero(ie < fila.Length ? fila[ie] : null) is not double x || LeerNumero(iN < fila.Length ? fila[iN] : null) is not double y) return null;
        var (lat, lon) = ConversorCoordenadas.Convertir(x, y, sistemaSeleccionado);
        if (lat is < -5 or > 14 || lon is < -83 or > -65 || double.IsNaN(lat) || double.IsNaN(lon))
        {
            if (!fueraDeRango.Contains(codigo)) fueraDeRango.Add(codigo);
            return null;
        }
        return (lat, lon);
    }

    // Torre que no existe: en la comparación es solo una vista (Id negativo, no se guarda); al aplicar se crea —o se revive de
    // la Papelera si hay una con el mismo código— con su capa, hoja de vida y 4 patas. Queda como "Torre nueva" en la revisión
    // (Deshacer la manda a la Papelera, igual que las altas del KMZ).
    private int idTemporal;
    private async Task<ElementoTrazado> TorreNuevaAsync(string codigo, (double Lat, double Lon) u, bool aplicar, List<Componente> componentes)
    {
        if (!aplicar)
        {
            // Vista previa: torre y patas simuladas (Id negativos, sin guardar) para contar también sus datos de pata.
            torresNuevas.Add(codigo);
            var sim = new ElementoTrazado { Id = --idTemporal, Codigo = codigo, Latitud = u.Lat, Longitud = u.Lon };
            foreach (var l in new[] { "A", "B", "C", "D" })
                componentes.Add(new Componente { Id = --idTemporal, ElementoTrazadoId = sim.Id, Nombre = $"Pata {l}", EsPredeterminado = true });
            return sim;
        }

        var norm = NormalizarCodigo(codigo);
        if (capaCarga is null)
        {
            var ref_ = versionReferencia.Trim();
            capaCarga = new CapaTrazado
            {
                Nombre = $"Tabla de torres — {DateTime.Now:dd/MM/yyyy HH:mm}" + (ref_.Length == 0 ? "" : $" (rev. {ref_})"),
                Origen = "TablaTorres", FechaCarga = DateTime.Now, Version = ref_.Length == 0 ? null : ref_,
            };
            Db.Capas.Add(capaCarga);
            await Db.SaveChangesAsync();
        }

        var torre = await Db.ElementosTrazado.IgnoreQueryFilters().Where(t => t.Eliminado && t.Codigo.ToUpper() == norm).OrderByDescending(t => t.FechaEliminacion).FirstOrDefaultAsync();
        if (torre is not null) { torre.Eliminado = false; torre.FechaEliminacion = null; }
        else { torre = new ElementoTrazado { Codigo = codigo }; Db.ElementosTrazado.Add(torre); }
        torre.Latitud = u.Lat; torre.Longitud = u.Lon; torre.CapaTrazadoId = capaCarga.Id;
        await Db.SaveChangesAsync();

        // Revivida: conserva sus elementos. Nueva (o sin ellos): hoja de vida + Pata A–D.
        var propios = componentes.Where(c => c.ElementoTrazadoId == torre.Id).ToList();
        if (!propios.Any(c => c.EsHojaDeVida))
        {
            var hv = new Componente { ElementoTrazadoId = torre.Id, Nombre = "Hoja de vida", EsPredeterminado = true, EsHojaDeVida = true, Orden = -1 };
            Db.Componentes.Add(hv); componentes.Add(hv);
        }
        string[] letras = { "A", "B", "C", "D" };
        for (int i = 0; i < letras.Length; i++)
        {
            if (propios.Any(c => c.Nombre.Equals($"Pata {letras[i]}", StringComparison.OrdinalIgnoreCase))) continue;
            var pata = new Componente { ElementoTrazadoId = torre.Id, Nombre = $"Pata {letras[i]}", EsPredeterminado = true, Orden = i };
            Db.Componentes.Add(pata); componentes.Add(pata);
        }
        await Db.SaveChangesAsync();

        registro.Add(new RegistroCambio(torre, null, "Torre", ServicioRevisionesTabla.ClaveAlta, null,
            ServicioRevisionesTabla.Coordenada(u.Lat, u.Lon), TipoCambioTabla.Nuevo, null, null));
        idsTorresCreadas.Add(torre.Id);
        torresNuevas.Add(codigo);
        return torre;
    }
    private enum Estado { Nuevo, Cambiado, Igual }

    private Dictionary<(int TorreId, string Clave), CampoExtraTorre> extrasTorre = new();
    private Dictionary<(int ComponenteId, string Clave), CampoExtraComponente> extrasComponente = new();

    private ResumenColumna Columna(string ambito, string clave, bool nueva)
    {
        var r = resumen.FirstOrDefault(x => x.Ambito == ambito && string.Equals(x.Clave.Trim(), clave.Trim(), StringComparison.OrdinalIgnoreCase));
        if (r is null) { r = new ResumenColumna { Ambito = ambito, Clave = clave, Nueva = nueva }; resumen.Add(r); }
        return r;
    }

    private static Estado Evaluar(string? actual, string nuevo) =>
        actual is null ? Estado.Nuevo : (actual.Trim() == nuevo.Trim() ? Estado.Igual : Estado.Cambiado);

    private async Task PrepararComparacion()
    {
        if (importando) return;
        importando = true;
        try
        {
            resumen = new(); coordNuevas = coordCambiadas = coordIguales = 0; aplicarCoord = true;
            ubicNuevas = ubicCambiadas = ubicIguales = 0; aplicarUbic = true;
            cambiosPorTorre = new(); torresExcluidas.Clear();
            await Procesar(false);
            // Torres sin cambios en valores ya cargados no se listan (solo datos nuevos).
            foreach (var k in cambiosPorTorre.Where(kv => kv.Value.Cambios.Count == 0).Select(kv => kv.Key).ToList()) cambiosPorTorre.Remove(k);
            paso = "comparar";
        }
        finally { importando = false; }
    }

    private Task Importar() => Aplicar();

    private async Task Aplicar()
    {
        if (importando) return;
        importando = true;
        try
        {
            await using var tx = await Db.Database.BeginTransactionAsync();
            registro = new();
            var r = await Procesar(true);

            // Revisión con copia del Excel y cada cambio (valor anterior → nuevo), permanente y deshacible.
            var codigoRev = versionReferencia.Trim();
            var nombre = archivoPrevio?.Nombre ?? archivoCargado?.Name ?? "Tabla de torres.xlsx";
            string? ruta = null;
            try
            {
                var carpeta = Path.Combine(Env.WebRootPath, "uploads", "tabla-torres");
                Directory.CreateDirectory(carpeta);
                var fisico = $"{Guid.NewGuid():N}{Path.GetExtension(nombre)}";
                if (archivoPrevio is not null) await File.WriteAllBytesAsync(Path.Combine(carpeta, fisico), archivoPrevio.Bytes);
                else if (bytesLeidos is not null) await File.WriteAllBytesAsync(Path.Combine(carpeta, fisico), bytesLeidos);
                ruta = $"/uploads/tabla-torres/{fisico}";
                SigWeb.Data.Trazado.ConfigCargaTabla.Guardar(Path.Combine(carpeta, fisico), new SigWeb.Data.Trazado.ConfigCargaTabla
                {
                    Hoja = hojaElegida, FilasEncabezado = filasEncabezado, Sistema = sistemaSeleccionado.ToString(),
                    Columnas = mapeos.Select(m => new SigWeb.Data.Trazado.ConfigCargaTabla.Columna
                        { Indice = m.Columna.Indice, Destino = m.Destino.ToString(), NombreCampo = m.NombreCampo, PataLetra = m.PataLetra, EjeCoordenada = m.EjeCoordenada }).ToList(),
                    Observaciones = observacionTorre.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value),
                });
            }
            catch (Exception ex) { Console.Error.WriteLine("Tabla de torres: no se pudo guardar la copia del Excel: " + ex.Message); }

            foreach (var v in await Db.RevisionesTablaTorres.Where(x => x.Estado == EstadoRevisionTabla.Vigente && x.Origen == RevisionTablaTorres.OrigenTabla).ToListAsync()) v.Estado = EstadoRevisionTabla.Anterior;
            var rev = new RevisionTablaTorres
            {
                Codigo = codigoRev, Origen = RevisionTablaTorres.OrigenTabla, Fecha = fechaRevision, Descripcion = string.IsNullOrWhiteSpace(descripcionRevision) ? null : descripcionRevision.Trim(),
                NombreArchivo = nombre, RutaArchivo = ruta, FechaCarga = DateTime.Now, Estado = EstadoRevisionTabla.Vigente,
                Torres = registro.Select(x => x.Torre.Id).Distinct().Count(), Cambios = registro.Count,
            };
            Db.RevisionesTablaTorres.Add(rev);
            await Db.SaveChangesAsync();
            foreach (var x in registro)
            {
                Db.CambiosTablaTorres.Add(new CambioTablaTorres
                {
                    RevisionTablaTorresId = rev.Id, ElementoTrazadoId = x.Torre.Id, CodigoTorre = x.Torre.Codigo, ComponenteId = x.ComponenteId,
                    Ambito = x.Ambito, Clave = x.Clave, ValorAnterior = x.Antes, ValorNuevo = x.Ahora, Tipo = x.Tipo,
                    Observacion = observacionTorre.TryGetValue(x.Torre.Codigo, out var obs) && !string.IsNullOrWhiteSpace(obs) ? obs.Trim() : null,
                    CampoNuevoId = x.CampoNuevo switch { CampoExtraTorre t => t.Id, CampoExtraComponente c => c.Id, _ => null },
                    CampoAnteriorId = x.CampoAnterior switch { CampoExtraTorre t => t.Id, CampoExtraComponente c => c.Id, _ => null },
                });
            }
            await Db.SaveChangesAsync();
            // Torres creadas: su ítem del catálogo "Localización" (Materiales). Sincronizar guarda y limpia el contexto.
            foreach (var id in idsTorresCreadas)
                if (await Db.ElementosTrazado.AsNoTracking().FirstOrDefaultAsync(t => t.Id == id) is { } creada)
                    SincronizadorCatalogoLocalizacion.Sincronizar(Db, creada);
            await tx.CommitAsync();
            Db.ChangeTracker.Clear();

            mensajeResultado = $"Revisión {codigoRev} registrada: {rev.Torres} torre(s) con {rev.Cambios} cambio(s) "
                + (idsTorresCreadas.Count > 0 ? $"({idsTorresCreadas.Count} torre(s) nueva(s) con su hoja de vida y 4 patas, " : "(")
                + $"{r.CamposTorre} dato(s) de torre, {r.CamposPata} de pata y {r.Coordenadas} ubicación(es) de torre o pata). "
                + "El mapa, Avance de obra y Línea 3D usan ya estas ubicaciones. "
                + "El historial queda en Tabla de torres › Revisiones y en la hoja de vida de cada torre.";
            paso = "resultado";
        }
        finally { importando = false; }
    }

    // aplicar = false: solo cuenta y arma el resumen. aplicar = true: escribe, respetando lo elegido en el resumen.
    private async Task<(int Torres, int CamposTorre, int CamposPata, int Coordenadas)> Procesar(bool aplicar)
    {
        var colIdentificador = mapeos.First(m => m.Destino == TipoDestino.IdentificadorTorre);
        int indiceIdentificador = mapeos.IndexOf(colIdentificador);
        var nombreArchivo = archivoPrevio?.Nombre ?? (string.IsNullOrWhiteSpace(archivoCargado?.Name) ? "Tabla de torres" : archivoCargado!.Name);
        var origenTexto = $"{nombreArchivo} — {DateTime.Now:dd/MM/yyyy HH:mm}"
            + (string.IsNullOrWhiteSpace(versionReferencia) ? "" : $" (v. {versionReferencia.Trim()})");

        var torres = await Db.ElementosTrazado.Where(t => !t.Eliminado).ToListAsync();
        var torresPorCodigo = new Dictionary<string, ElementoTrazado>();
        foreach (var t in torres) torresPorCodigo[NormalizarCodigo(t.Codigo)] = t;
        var migraciones = conflictos.Where(c => c.Decision == "Migrar")
            .ToDictionary(c => NormalizarCodigo(c.CodigoFila), c => c.TorreSugerida.Id);

        var componentes = await Db.Componentes.Where(c => !c.Eliminado).ToListAsync();
        extrasTorre = new(); extrasComponente = new();
        foreach (var c in await Db.CamposExtraTorre.Where(c => !c.Eliminado).ToListAsync()) extrasTorre[(c.ElementoTrazadoId, c.Clave.Trim().ToUpperInvariant())] = c;
        foreach (var c in await Db.CamposExtraComponente.Where(c => !c.Eliminado).ToListAsync()) extrasComponente[(c.ComponenteId, c.Clave.Trim().ToUpperInvariant())] = c;
        var clavesTorreExistentes = extrasTorre.Values.Select(c => c.Clave.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var clavesPataExistentes = extrasComponente.Values.Select(c => c.Clave.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);

        torresNoEncontradas = new(); torresNuevas = new(); fueraDeRango = new(); idTemporal = 0;
        if (aplicar) { idsTorresCreadas = new(); capaCarga = null; }
        var omitidas = conflictos.Where(c => c.Decision == "Omitir").Select(c => NormalizarCodigo(c.CodigoFila)).ToHashSet();
        int torresActualizadas = 0, camposTorre = 0, camposPata = 0, coordenadas = 0;
        var ahora = DateTime.Now;

        foreach (var fila in tabla!.Filas)
        {
            var codigoCrudo = fila[indiceIdentificador];
            var codigoTorre = NormalizarCodigo(codigoCrudo);
            if (string.IsNullOrWhiteSpace(codigoTorre)) continue;

            if (!torresPorCodigo.TryGetValue(codigoTorre, out var torre))
                if (migraciones.TryGetValue(codigoTorre, out var idMig)) torre = torres.FirstOrDefault(t => t.Id == idMig);
            var ubic = UbicacionTorre(fila, codigoCrudo.Trim());
            bool esNueva = false;
            if (torre is null)
            {
                // Código que no existe: se crea si trae coordenadas de torre y no se marcó Omitir en Coincidencias.
                if (ubic is null || omitidas.Contains(codigoTorre)) { torresNoEncontradas.Add(codigoCrudo); continue; }
                if (aplicar && torresExcluidas.Contains(codigoCrudo.Trim())) continue;
                torre = await TorreNuevaAsync(codigoCrudo.Trim(), ubic.Value, aplicar, componentes);
                torresPorCodigo[codigoTorre] = torre;
                esNueva = true;
            }
            if (aplicar && torresExcluidas.Contains(torre.Codigo)) continue;

            bool huboCambios = esNueva;
            var patas = componentes.Where(c => c.ElementoTrazadoId == torre.Id).ToList();

            // Ubicación de la torre (manda la tabla de torres: mapa, Avance de obra, Línea 3D, tendido).
            if (!esNueva && ubic is { } u)
            {
                bool sinUbic = torre.Latitud == 0 && torre.Longitud == 0;
                bool igualUbic = !sinUbic && Math.Abs(torre.Latitud - u.Lat) < 1e-7 && Math.Abs(torre.Longitud - u.Lon) < 1e-7;
                var antes = sinUbic ? null : ServicioRevisionesTabla.Coordenada(torre.Latitud, torre.Longitud);
                var despues = ServicioRevisionesTabla.Coordenada(u.Lat, u.Lon);
                if (!aplicar)
                {
                    if (sinUbic) ubicNuevas++; else if (igualUbic) ubicIguales++;
                    else { ubicCambiadas++; VistaDe(torre).Cambios.Add(new CambioVista("Torre", ServicioRevisionesTabla.ClaveUbicacion, antes, despues)); }
                }
                else if (!igualUbic && (sinUbic || aplicarUbic))
                {
                    registro.Add(new RegistroCambio(torre, null, "Torre", ServicioRevisionesTabla.ClaveUbicacion, antes, despues, TipoCambioTabla.Coordenada, null, null));
                    torre.Latitud = u.Lat; torre.Longitud = u.Lon;
                    coordenadas++; huboCambios = true;
                }
            }

            foreach (var m in mapeos.Where(m => m.Destino == TipoDestino.CampoTorre))
            {
                var valor = fila[mapeos.IndexOf(m)];
                if (string.IsNullOrWhiteSpace(valor) || string.IsNullOrWhiteSpace(m.NombreCampo)) continue;
                var clave = m.NombreCampo.Trim();
                extrasTorre.TryGetValue((torre.Id, clave.Trim().ToUpperInvariant()), out var actual);
                if (actual is not null) clave = actual.Clave;
                var est = Evaluar(actual?.Valor, valor);
                var col = Columna("Torre", clave, !clavesTorreExistentes.Contains(clave.Trim()));
                if (!aplicar)
                {
                    if (est == Estado.Nuevo) { col.Nuevos++; if (actual is null && !col.Nueva) VistaDe(torre).Nuevos++; }
                    else if (est == Estado.Igual) col.Iguales++;
                    else
                    {
                        col.Cambiados++; if (col.Muestras.Count < 60) col.Muestras.Add((torre.Codigo, actual!.Valor, valor));
                        VistaDe(torre).Cambios.Add(new CambioVista("Torre", clave, actual!.Valor, valor));
                    }
                    extrasTorre[(torre.Id, clave.Trim().ToUpperInvariant())] = new CampoExtraTorre { Clave = clave, Valor = valor };
                    continue;
                }
                if (est == Estado.Igual || (est == Estado.Cambiado && !col.AplicarCambios)) continue;
                if (actual is not null) { actual.Eliminado = true; actual.FechaEliminacion = ahora; }
                var nuevo = new CampoExtraTorre { ElementoTrazadoId = torre.Id, Clave = clave, Valor = valor, Origen = origenTexto };
                Db.CamposExtraTorre.Add(nuevo);
                registro.Add(new RegistroCambio(torre, null, "Torre", clave, actual?.Valor, valor,
                    actual is null ? TipoCambioTabla.Nuevo : TipoCambioTabla.Cambiado, nuevo, actual));
                extrasTorre[(torre.Id, clave.Trim().ToUpperInvariant())] = nuevo;
                camposTorre++; huboCambios = true;
            }

            foreach (var m in mapeos.Where(m => m.Destino == TipoDestino.CampoPata))
            {
                var valor = fila[mapeos.IndexOf(m)];
                if (string.IsNullOrWhiteSpace(valor) || string.IsNullOrWhiteSpace(m.NombreCampo)) continue;
                var pata = patas.FirstOrDefault(p => p.Nombre.Equals($"Pata {m.PataLetra}", StringComparison.OrdinalIgnoreCase));
                if (pata is null) continue;
                var clave = m.NombreCampo.Trim();
                extrasComponente.TryGetValue((pata.Id, clave.Trim().ToUpperInvariant()), out var actual);
                if (actual is not null) clave = actual.Clave;
                var est = Evaluar(actual?.Valor, valor);
                var col = Columna($"Pata {m.PataLetra}", clave, !clavesPataExistentes.Contains(clave.Trim()));
                if (!aplicar)
                {
                    if (est == Estado.Nuevo) { col.Nuevos++; if (actual is null && !col.Nueva) VistaDe(torre).Nuevos++; }
                    else if (est == Estado.Igual) col.Iguales++;
                    else
                    {
                        col.Cambiados++; if (col.Muestras.Count < 60) col.Muestras.Add((torre.Codigo, actual!.Valor, valor));
                        VistaDe(torre).Cambios.Add(new CambioVista($"Pata {m.PataLetra}", clave, actual!.Valor, valor));
                    }
                    extrasComponente[(pata.Id, clave.Trim().ToUpperInvariant())] = new CampoExtraComponente { Clave = clave, Valor = valor };
                    continue;
                }
                if (est == Estado.Igual || (est == Estado.Cambiado && !col.AplicarCambios)) continue;
                if (actual is not null) { actual.Eliminado = true; actual.FechaEliminacion = ahora; }
                var nuevo = new CampoExtraComponente { ComponenteId = pata.Id, Clave = clave, Valor = valor, Origen = origenTexto };
                Db.CamposExtraComponente.Add(nuevo);
                registro.Add(new RegistroCambio(torre, pata.Id, $"Pata {m.PataLetra}", clave, actual?.Valor, valor,
                    actual is null ? TipoCambioTabla.Nuevo : TipoCambioTabla.Cambiado, nuevo, actual));
                extrasComponente[(pata.Id, clave.Trim().ToUpperInvariant())] = nuevo;
                camposPata++; huboCambios = true;
            }

            foreach (var letra in new[] { "A", "B", "C", "D" })
            {
                var mEste = mapeos.FirstOrDefault(m => m.Destino == TipoDestino.CoordenadaPata && m.PataLetra == letra && m.EjeCoordenada == "Este");
                var mNorte = mapeos.FirstOrDefault(m => m.Destino == TipoDestino.CoordenadaPata && m.PataLetra == letra && m.EjeCoordenada == "Norte");
                if (mEste is null || mNorte is null) continue;
                if (LeerNumero(fila[mapeos.IndexOf(mEste)]) is not double x) continue;
                if (LeerNumero(fila[mapeos.IndexOf(mNorte)]) is not double y) continue;
                var pata = patas.FirstOrDefault(p => p.Nombre.Equals($"Pata {letra}", StringComparison.OrdinalIgnoreCase));
                if (pata is null) continue;

                var (lat, lon) = ConversorCoordenadas.Convertir(x, y, sistemaSeleccionado);
                if (lat is < -5 or > 14 || lon is < -83 or > -65 || double.IsNaN(lat) || double.IsNaN(lon))
                {
                    if (!fueraDeRango.Contains(torre.Codigo)) fueraDeRango.Add(torre.Codigo);
                    continue;
                }
                bool sinCoord = pata.Latitud is null || pata.Longitud is null || (pata.Latitud == 0 && pata.Longitud == 0);
                bool igual = !sinCoord && Math.Abs(pata.Latitud!.Value - lat) < 1e-7 && Math.Abs(pata.Longitud!.Value - lon) < 1e-7;
                if (!aplicar)
                {
                    if (sinCoord) coordNuevas++; else if (igual) coordIguales++;
                    else
                    {
                        coordCambiadas++;
                        VistaDe(torre).Cambios.Add(new CambioVista($"Pata {letra}", "Ubicación",
                            SigWeb.Data.Trazado.ServicioRevisionesTabla.Coordenada(pata.Latitud, pata.Longitud), SigWeb.Data.Trazado.ServicioRevisionesTabla.Coordenada(lat, lon)));
                    }
                    pata.Latitud = lat; pata.Longitud = lon;
                    continue;
                }
                if (igual || (!sinCoord && !aplicarCoord)) continue;
                registro.Add(new RegistroCambio(torre, pata.Id, $"Pata {letra}", "Ubicación",
                    sinCoord ? null : SigWeb.Data.Trazado.ServicioRevisionesTabla.Coordenada(pata.Latitud, pata.Longitud),
                    SigWeb.Data.Trazado.ServicioRevisionesTabla.Coordenada(lat, lon), TipoCambioTabla.Coordenada, null, null));
                pata.Latitud = lat; pata.Longitud = lon;
                coordenadas++; huboCambios = true;
            }

            if (huboCambios) torresActualizadas++;
        }

        if (!aplicar)
        {
            var enArchivo = resumen.Select(r => r.Clave).ToHashSet(StringComparer.OrdinalIgnoreCase);
            clavesConservadas = clavesTorreExistentes.Concat(clavesPataExistentes).Distinct(StringComparer.OrdinalIgnoreCase)
                .Where(c => !enArchivo.Contains(c)).OrderBy(c => c, StringComparer.OrdinalIgnoreCase).ToList();
            Db.ChangeTracker.Clear();
            return (0, 0, 0, 0);
        }

        await Db.SaveChangesAsync();   // Aplicar registra la revisión y limpia el contexto
        return (torresActualizadas, camposTorre, camposPata, coordenadas);
    }

    private static string NormalizarCodigo(string codigo) => (codigo ?? "").Trim().ToUpperInvariant();

    // Regresa a la pantalla desde la que se abrió (Trazado o Tabla de torres).
    private Task Cerrar() => JS.VolverAsync("/trazado");

    private static string NormCampo(string? s) => new string((s ?? "").ToUpperInvariant().Where(char.IsLetterOrDigit).ToArray());

    private static bool EsExistente(MapeoColumna m, List<string> claves) => claves.Any(c => string.Equals(c, m.NombreCampo?.Trim(), StringComparison.OrdinalIgnoreCase));

    private void ElegirCampo(MapeoColumna m, string? valor, List<string> claves)
    {
        if (valor == CampoNuevo)
        {
            // Pasa a campo nuevo: si tenía un existente, propone el nombre del encabezado para editarlo.
            if (EsExistente(m, claves)) m.NombreCampo = NombreCampoPorDefecto(m.Columna) is var d && !claves.Contains(d, StringComparer.OrdinalIgnoreCase) ? d : "";
        }
        else if (!string.IsNullOrEmpty(valor)) m.NombreCampo = valor;
    }

    // Detalle de un campo: lista de campos ya existentes + "Campo nuevo…" (con su nombre editable) y la marca de qué hará.
    private RenderFragment SelectorCampo(MapeoColumna m, List<string> claves) => __builder =>
    {
        var existente = EsExistente(m, claves);
        <div class="dat-campo @(existente ? "existente" : "")">
            <select class="form-select form-select-sm" data-sin-flotante title="Campo donde se guarda esta columna"
                    value="@(existente ? claves.First(c => string.Equals(c, m.NombreCampo.Trim(), StringComparison.OrdinalIgnoreCase)) : CampoNuevo)"
                    @onchange="e => ElegirCampo(m, e.Value?.ToString(), claves)">
                <option value="@CampoNuevo">➕ Campo nuevo…</option>
                @foreach (var c in claves)
                {
                    <option value="@c">@c</option>
                }
            </select>
            @if (!existente)
            {
                <input class="form-control form-control-sm" data-sin-flotante placeholder="Nombre del campo nuevo" title="@(string.IsNullOrWhiteSpace(m.NombreCampo) ? "Nombre del campo nuevo" : m.NombreCampo)" @bind="m.NombreCampo" @bind:event="oninput" />
            }
            <span class="badge @(existente ? "text-bg-primary" : "text-bg-success")" title="@(existente ? "Actualiza el campo que ya existe" : "Crea un campo nuevo")">@(existente ? "Actualiza" : "Nuevo")</span>
        </div>
    };

    // Dos o más columnas al mismo destino (mismo campo de torre, o misma pata y campo, o misma coordenada de pata).
    private string ClaveDestino(MapeoColumna m) => m.Destino switch
    {
        TipoDestino.CampoTorre => "Torre · " + NormCampo(m.NombreCampo),
        TipoDestino.CampoPata => $"Pata {m.PataLetra} · " + NormCampo(m.NombreCampo),
        TipoDestino.CoordenadaTorre => $"Torre · coordenada {m.EjeCoordenada}",
        TipoDestino.CoordenadaPata => $"Pata {m.PataLetra} · coordenada {m.EjeCoordenada}",
        TipoDestino.IdentificadorTorre => "Identificador de torre",
        _ => ""
    };

    private sealed record Repetida(string Destino, List<string> Columnas);
    private List<Repetida> ColumnasRepetidas => mapeos
        .Where(m => m.Destino != TipoDestino.Ignorar && !(m.Destino is TipoDestino.CampoTorre or TipoDestino.CampoPata && string.IsNullOrWhiteSpace(m.NombreCampo)))
        .GroupBy(ClaveDestino).Where(g => g.Count() > 1)
        .Select(g => new Repetida(g.First().Destino switch
            {
                TipoDestino.CampoTorre => g.First().NombreCampo.Trim(),
                TipoDestino.CampoPata => $"Pata {g.First().PataLetra} · {g.First().NombreCampo.Trim()}",
                TipoDestino.CoordenadaPata => $"Pata {g.First().PataLetra} · {g.First().EjeCoordenada}",
                TipoDestino.CoordenadaTorre => $"Torre · {g.First().EjeCoordenada}",
                _ => "Identificador de torre"
            }, g.Select(m => m.Columna.Direccion).ToList()))
        .ToList();

    private bool EsRepetida(MapeoColumna m) => m.Destino != TipoDestino.Ignorar && ColumnasRepetidas.Count > 0
        && mapeos.Count(x => x.Destino != TipoDestino.Ignorar && ClaveDestino(x) == ClaveDestino(m) && ClaveDestino(m) != "") > 1;
}
