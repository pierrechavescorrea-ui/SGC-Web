@* Celda de una tabla con "Campos": muestra el valor (nativo, digitado o calculado),
   aplica el formato condicional y permite editar en línea los campos digitados. *@
@using SigWeb.Data
@using SigWeb.Data.Tablas
@using SigWeb.Models
@inject AppDbContext Db

@{
    var texto = Motor.Texto(Fila, Campo, out var error);
    var est = error is null ? Motor.Estilo(Fila, Campo) : null;
    var formula = Motor.FormulaDe(Fila, Campo);
    var editable = !SoloLectura && Campo.Origen != OrigenCampoTabla.Nativo && formula is null && Campo.Tipo != TipoCampoTabla.Archivos;
}
<td class="small cc @Clase @(editable ? "cc-editable" : "") @(error is not null ? "cc-error" : "")" data-col="@Col"
    style="@Unir(Estilo, EstiloTd(est))" title="@(error ?? (formula is null ? null : "ƒ " + formula))" @onclick="Editar">
    @if (editando)
    {
        switch (Campo.Tipo)
        {
            case TipoCampoTabla.Numero:
                <input @ref="entrada" type="number" step="any" class="form-control form-control-sm cc-input" value="@ValorCrudo" @onchange="Guardar" @onblur="Cancelar" />
                break;
            case TipoCampoTabla.Fecha:
                <input @ref="entrada" type="date" class="form-control form-control-sm cc-input" value="@ValorCrudo" @onchange="Guardar" @onblur="Cancelar" />
                break;
            case TipoCampoTabla.Lista when Campo.Multiple:
                @* Varios valores: fichas + lista para agregar; cada cambio se guarda; ✓ termina. *@
                <div class="cc-varios" @onclick:stopPropagation="true">
                    <SigWeb.Components.Layout.SelectorMultiple Valores="variosEdicion" Opciones="Motor.OpcionesDe(Campo)" OnCambio="GuardarVarios" />
                    <button type="button" class="btn btn-sm btn-outline-secondary cc-listo" title="Listo" @onclick="TerminarVarios">✓</button>
                </div>
                break;
            case TipoCampoTabla.Lista:
                <select @ref="entrada" class="form-select form-select-sm cc-input" value="@ValorCrudo" @onchange="Guardar" @onblur="Cancelar">
                    <option value=""></option>
                    @foreach (var o in Motor.OpcionesDe(Campo)) { <option value="@o">@o</option> }
                </select>
                break;
            case TipoCampoTabla.SiNo:
                <input @ref="entrada" type="checkbox" class="form-check-input" checked="@(ValorCrudo == "1")" @onchange="GuardarSiNo" @onblur="Cancelar" />
                break;
            default:
                <input @ref="entrada" type="text" class="form-control form-control-sm cc-input" value="@ValorCrudo" @onchange="Guardar" @onblur="Cancelar" />
                break;
        }
    }
    else if (Campo.Tipo == TipoCampoTabla.Archivos)
    {
        @if (texto.Length > 0) { <span class="text-nowrap" title="Archivos adjuntos (se cargan en el formulario o en Adjuntos)"><SigWeb.Components.Layout.Ico Nombre="documento" /> @texto</span> }
    }
    else if (Campo.Tipo == TipoCampoTabla.Lista && Campo.Multiple && est is null && texto.Length > 0)
    {
        @foreach (var v in MotorTabla.Partes(texto))
        {
            @if (Campo.CatalogoTipo is not null) { <SigWeb.Components.Layout.ValorCatalogo Tipo="@Campo.CatalogoTipo" Valor="@v" ClaseSinFormato="rg-chip" Clase="cc-vario" /> }
            else { <span class="rg-chip cc-vario">@v</span> }
        }
    }
    else if (est is not null && est.Forma == "pildora" && texto.Length > 0)
    {
        <span class="cc-pildora" style="background:@est.ColorFondo;color:@est.ColorTexto;font-weight:@(est.Negrita ? 600 : 400)">@texto</span>
    }
    else if (est is not null && est.Forma == "texto")
    {
        <span style="color:@est.ColorTexto;font-weight:@(est.Negrita ? 600 : 400)">@texto</span>
    }
    else
    {
        @texto
    }
    @if (errorGuardado is not null) { <span class="text-danger small" role="alert">@errorGuardado</span> }
    @if (!editando && Motor.FormulaDeCelda(Fila, Campo))
    {
        <span class="cc-fx" title="Fórmula solo en esta celda">ƒ</span>
    }
</td>

@code {
    [Parameter, EditorRequired] public MotorTabla Motor { get; set; } = default!;
    [Parameter, EditorRequired] public CampoTabla Campo { get; set; } = default!;
    [Parameter] public int Fila { get; set; }
    [Parameter] public string? Clase { get; set; }
    // Estilo y data-col de la página (columnas fijas, franjas…), para que la celda se integre a su tabla.
    [Parameter] public string? Estilo { get; set; }
    [Parameter] public string? Col { get; set; }

    private static string? Unir(string? a, string? b) => string.IsNullOrEmpty(a) ? b : string.IsNullOrEmpty(b) ? a : a + ";" + b;
    [Parameter] public EventCallback OnCambio { get; set; }
    // true = solo muestra (la página decide cuándo se edita, ej. Listado maestro de documentos).
    [Parameter] public bool SoloLectura { get; set; }

    private bool editando, enfocar, guardando;
    private string? errorGuardado;
    private ElementReference entrada;

    private string? ValorCrudo => Motor.Registro(Fila, Campo)?.Valor;

    private static string? EstiloTd(EstiloCelda? e) =>
        e is not null && e.Forma == "celda" ? $"background:{e.ColorFondo} !important;color:{e.ColorTexto};font-weight:{(e.Negrita ? 600 : 400)}" : null;

    private void Editar()
    {
        if (SoloLectura || editando || Campo.Origen == OrigenCampoTabla.Nativo || Campo.Tipo == TipoCampoTabla.Archivos || Motor.FormulaDe(Fila, Campo) is not null) return;
        errorGuardado = null;
        if (Campo.Tipo == TipoCampoTabla.Lista && Campo.Multiple) variosEdicion = MotorTabla.Partes(ValorCrudo);
        editando = true; enfocar = !(Campo.Tipo == TipoCampoTabla.Lista && Campo.Multiple);
    }

    private List<string> variosEdicion = new();

    private async Task GuardarVarios()
    {
        guardando = true; errorGuardado = null;
        try { await Motor.GuardarValorAsync(Db, Fila, Campo, MotorTabla.UnirVarios(variosEdicion)); await OnCambio.InvokeAsync(); }
        catch (Exception ex) { Db.ChangeTracker.Clear(); errorGuardado = "No se pudo guardar: " + (ex.InnerException?.Message ?? ex.Message); }
        finally { guardando = false; }
    }

    private void TerminarVarios() { if (errorGuardado is null) editando = false; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!enfocar) return;
        enfocar = false;
        try { await entrada.FocusAsync(); } catch { }
    }

    private Task Guardar(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        if (Campo.Tipo == TipoCampoTabla.Numero && !string.IsNullOrWhiteSpace(v)) v = v.Replace(',', '.');
        return GuardarValor(v);
    }

    private Task GuardarSiNo(ChangeEventArgs e) => GuardarValor(e.Value is true ? "1" : "0");

    private async Task GuardarValor(string? valor)
    {
        guardando = true; errorGuardado = null;
        try
        {
            await Motor.GuardarValorAsync(Db, Fila, Campo, valor);
            editando = false;
            await OnCambio.InvokeAsync();
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            editando = true;
            errorGuardado = "No se pudo guardar: " + (ex.InnerException?.Message ?? ex.Message);
        }
        finally { guardando = false; }
    }

    private void Cancelar() { if (!guardando && errorGuardado is null) editando = false; }
}
