@page "/modelos3d/detalle"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Detalle por pieza</PageTitle>

<EncabezadoPagina Titulo="Detalle por pieza" Icono="ifc" Subtitulo="BP6 · torre completa (piloto)" Atras="ifc" />

@if (error is not null)
{
    <div class="alert alert-danger py-1 px-2 small">@error</div>
}
<div class="vdet-marco" @ref="marco">
    <div class="vdet-lienzo" @ref="contenedor"></div>
</div>
