        var rutaGen = Path.Combine(Env.WebRootPath, gen);
        var hayGen = File.Exists(rutaGen);
        m.SinMiniatura = !hayGen && m.Cargado?.ArchivoMiniatura is null;
        if (hayGen && m.Cargado?.ArchivoMiniatura is null) m.MiniUrl = gen + "?v=" + File.GetLastWriteTimeUtc(rutaGen).Ticks;
        var r = m.RutaJson is null ? null : ResumenModelos.Leer(Path.Combine(Env.WebRootPath, m.RutaJson));
        if (m.Cargado is { } c) r = (r ?? new ResumenModelo(null, null, 0, 0, 0)) with { Validaciones = c.Validaciones, Supuestos = c.Supuestos };
        m.Resumen = r;
