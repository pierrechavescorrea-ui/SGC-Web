@page "/ifc"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using SigWeb.Data
@using SigWeb.Data.Modelos3D
@using SigWeb.Data.Tablas
@using SigWeb.Models
@using Microsoft.EntityFrameworkCore
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject AppDbContext Db
@inject SigWeb.Data.Impacto.AnalizadorImpacto Analizador

<PageTitle>Modelos 3D</PageTitle>

<EncabezadoPagina Titulo="@(verVinculo ? "Modelos en Línea 3D" : "Modelos 3D")" Icono="ifc" Subtitulo="@Subtitulo" OnAtras="AtrasCb">
    <Acciones>
        @if (verVinculo)
        {
            <BotonCampos Activo="verCamposVinculo" Deshabilitado="motorVinculo is null" OnClick="() => verCamposVinculo = true" />
            <BotonExportar Titulo="Modelos en Línea 3D" />
        }
        else if (sel is null)
        {
            <button type="button" class="pg-btn" title="Modelos en Línea 3D" @onclick="AbrirVinculo">
                <IconoPunto Punto="menu:linea3d" Clase="ui-svg"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M7 20 9 6l2 14M13 20l2-14 2 14"/><path d="M4 9c3 2 6 2 8 0s5-2 8 0"/></svg></IconoPunto>
            </button>
            <button type="button" class="pg-btn @(carga is not null ? "activo" : "")" title="Cargar modelo IFC" @onclick="() => AbrirCarga(null)"><Ico Nombre="importar" /></button>
        }
        else
        {
            <button type="button" class="pg-btn @(verLista ? "activo" : "")" title="Lista de materiales" disabled="@(torreJson is null)" @onclick="AlternarListaAsync"><Ico Nombre="listado" /></button>
            <button type="button" class="pg-btn" title="Datos de la torre, validación y supuestos" @onclick="AlternarTorre">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.6v.2"/></svg>
            </button>
            <a class="pg-btn" href="@sel.Url" download title="Descargar .ifc">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
            </a>
            @if (sel.Informe is not null)
            {
                <a class="pg-btn" href="@sel.Informe" target="_blank" title="Informe de validación"><Ico Nombre="documento" /></a>
            }
            @if (string.Equals(sel.Nombre, "BP6", StringComparison.OrdinalIgnoreCase))
            {
                @* Piloto de detalle total (brazo de guarda): vista aparte, no reemplaza este modelo *@
                <a class="pg-btn" href="modelos3d/detalle" title="Detalle por pieza: torre completa (piloto)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12 6 6M12 12l6-6M12 12l-6 6M12 12l6 6"/><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="17" y="2" width="5" height="5" rx="1"/><rect x="2" y="17" width="5" height="5" rx="1"/><rect x="17" y="17" width="5" height="5" rx="1"/></svg></a>
            }
            @if (JsonAnalitico is { } ja)
            {
                <a class="pg-btn" href="@($"modelos3d?modelo={Uri.EscapeDataString(ja)}")" title="Modelo analítico (JSON)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7.5v9L12 21l8-4.5v-9z"/><path d="M4 7.5 12 12l8-4.5M12 12v9"/></svg></a>
            }
            <button type="button" class="pg-btn @(verVersiones ? "activo" : "")" title="Versiones" @onclick="() => verVersiones = !verVersiones"><Ico Nombre="versiones" /></button>
            <button type="button" class="pg-btn @(carga is not null ? "activo" : "")" title="Nueva versión" @onclick="() => AbrirCarga(sel)"><Ico Nombre="nueva-version" /></button>
        }
    </Acciones>
</EncabezadoPagina>

@if (error is not null)
{
    <div class="alert alert-danger py-1 px-2 small">@error</div>
}

@if (carga is not null)
{
    <FormularioSig Titulo="@(carga.Reemplaza ? $"{carga.Codigo} · versión {carga.Version}" : "Cargar modelo IFC")" Icono="@(carga.Reemplaza ? "nueva-version" : "importar")" Clase="mb-3" OnCerrar="CerrarCarga">
        <ChildContent>
            <SeccionFormulario Titulo="Modelo">
                <CampoFormulario Etiqueta="Código" Ancho="col-md-2" Obligatorio="true" Destacado="true">
                    <input class="form-control" list="dl-ifc-cod" value="@carga.Codigo" @onchange="@(e => CambiarCodigo(e.Value?.ToString() ?? ""))" disabled="@carga.Fijo" />
                </CampoFormulario>
                <CampoFormulario Etiqueta="Tipo en tabla de torres" Ancho="col-md-2"><input class="form-control" placeholder="@carga.Codigo" @bind="carga.Nombre" /></CampoFormulario>
                <CampoFormulario Etiqueta="Familia" Ancho="col-md-2"><input class="form-control" list="dl-ifc-fam" @bind="carga.Familia" /></CampoFormulario>
                <CampoFormulario Etiqueta="Descripción" Ancho="col-md-6"><input class="form-control" @bind="carga.Descripcion" /></CampoFormulario>
                @if (carga.Reemplaza)
                {
                    <CampoFormulario Etiqueta="Cambios de esta versión" Ancho="col-md-12"><textarea class="form-control" rows="2" @bind="carga.Cambios"></textarea></CampoFormulario>
                }
            </SeccionFormulario>
            <SeccionFormulario Titulo="Archivos">
                <CampoFormulario Etiqueta="IFC" Ancho="col-md-3" Obligatorio="true">
                    <InputFile class="form-control form-control-sm" accept=".ifc" OnChange="@(e => RecibirAsync(e, "ifc"))" disabled="@carga.Leyendo" />
                </CampoFormulario>
                <CampoFormulario Etiqueta="JSON del modelo" Ancho="col-md-3">
                    <InputFile class="form-control form-control-sm" accept=".json" OnChange="@(e => RecibirAsync(e, "json"))" disabled="@carga.Leyendo" />
                </CampoFormulario>
                <CampoFormulario Etiqueta="Miniatura" Ancho="col-md-3">
                    <InputFile class="form-control form-control-sm" accept=".png,.jpg,.jpeg,.webp" OnChange="@(e => RecibirAsync(e, "mini"))" disabled="@carga.Leyendo" />
                </CampoFormulario>
                <CampoFormulario Etiqueta="Informe de validación" Ancho="col-md-3">
                    <InputFile class="form-control form-control-sm" OnChange="@(e => RecibirAsync(e, "informe"))" disabled="@carga.Leyendo" />
                </CampoFormulario>
                <div class="col-12 d-flex flex-wrap gap-2 align-items-center small">
                    @if (carga.Leyendo) { <span class="spinner-border spinner-border-sm" title="Leyendo archivo"></span> }
                    @if (carga.Ifc is { } li)
                    {
                        if (!li.EsIfc) { <span class="rg-chip text-danger" title="El archivo no empieza con ISO-10303-21">✕ No es un IFC</span> }
                        else
                        {
                            <span class="rg-chip" title="Esquema del IFC">@(li.Esquema ?? "IFC")</span>
                            <span class="rg-chip @(li.Validaciones == 0 ? "text-warning" : "")" title="Cotas comparadas plano / modelo (Pset SigWeb_Torre)">@(li.Validaciones == 0 ? "○" : "✓") @li.Validaciones validaciones</span>
                            <span class="rg-chip @(li.Supuestos == 0 ? "text-warning" : "")" title="Supuestos declarados (Pset SigWeb_Torre)">@(li.Supuestos == 0 ? "○" : "✓") @li.Supuestos supuestos</span>
                        }
                    }
                    @if (carga.MiembrosJson is int mj)
                    {
                        <span class="rg-chip" title="Miembros del JSON: lista de materiales, Línea 3D y Avance de obra">✓ JSON · @mj miembros</span>
                    }
                    else if (carga.Temp.ContainsKey("json"))
                    {
                        <span class="rg-chip text-danger" title="El JSON no trae la lista &quot;miembros&quot;">✕ JSON no válido</span>
                    }
                    else if (carga.Ifc is { EsIfc: true })
                    {
                        <span class="rg-chip" title="Sin JSON: al guardar se genera desde el IFC (barras, perfiles, marcas y lista de materiales; lo no leído queda como supuesto)">⚙ JSON desde el IFC</span>
                    }
                </div>
                @if (carga.Ifc is { EsIfc: true } lv && (lv.Validaciones == 0 || lv.Supuestos == 0) && !carga.Temp.ContainsKey("informe"))
                {
                    <div class="col-12"><div class="alert alert-warning py-1 px-2 small mb-0">Modelo sin validación o sin lista de supuestos.</div></div>
                }
                @if (carga.Mensaje is not null)
                {
                    <div class="col-12"><div class="alert alert-danger py-1 px-2 small mb-0">@carga.Mensaje</div></div>
                }
            </SeccionFormulario>
        </ChildContent>
        <Acciones>
            <button type="button" class="btn btn-secondary btn-sm" title="Cancelar" @onclick="CerrarCarga"><Ico Nombre="cancelar" /></button>
            <button type="button" class="btn btn-primary btn-sm" title="Guardar" disabled="@(!PuedeGuardarCarga)" @onclick="GuardarCargaAsync"><Ico Nombre="guardar" /></button>
        </Acciones>
    </FormularioSig>
    <datalist id="dl-ifc-cod">@foreach (var c in CodigosExistentes) { <option value="@c"></option> }</datalist>
    <datalist id="dl-ifc-fam">@foreach (var f in modelos.Select(m => m.Familia).Where(f => !string.IsNullOrWhiteSpace(f)).Distinct()) { <option value="@f"></option> }</datalist>
}

@if (elimVersion is not null)
{
    <div class="card panel-formulario mb-3 border-danger">
        <div class="card-body">
            <div class="mb-2"><Ico Nombre="eliminar" /> <strong>@elimVersion.Codigo v@(elimVersion.Version)</strong></div>
            <PanelImpacto Informe="impacto" OnEntendido="@(v => impactoOk = v)" />
            <div class="frm-pie frm-pie-plano">
                <button class="btn btn-secondary btn-sm" type="button" title="Cancelar" @onclick="CancelarEliminar"><Ico Nombre="cancelar" /></button>
                <button data-texto="Eliminar" class="btn btn-danger btn-sm" type="button" title="Eliminar (va a la Papelera)" disabled="@BloqueadoPorImpacto" @onclick="ConfirmarEliminarAsync"><Ico Nombre="eliminar" /></button>
            </div>
        </div>
    </div>
}

@if (verVersiones && sel is not null && !verVinculo)
{
    var versiones = VersionesDe(sel);
    <div class="tabla-scroll mb-2" style="max-height:260px;"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin">
        <thead><tr><th>Versión</th><th>Fecha</th><th>Archivo</th><th>Validación</th><th>Supuestos</th><th>JSON</th><th>Informe</th><th>Cambios</th><th></th></tr></thead>
        <tbody>
            @foreach (var v in versiones)
            {
                var actual = v.Url == sel.Url;
                <tr class="@(actual ? "ifc-bom-sel" : "")">
                    <td class="fw-bold text-nowrap">@(v.Cargado is null ? "Repositorio" : "v" + v.Cargado.Version)@(v.Vigente ? " ★" : "")</td>
                    <td class="text-nowrap">@v.Cargado?.FechaCarga.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="text-truncate" style="max-width:220px;" title="@(v.Cargado?.NombreOriginalIfc ?? v.Archivo)">@(v.Cargado?.NombreOriginalIfc ?? v.Archivo)</td>
                    <td class="text-end">@v.Cargado?.Validaciones</td>
                    <td class="text-end">@v.Cargado?.Supuestos</td>
                    <td class="text-center">@(v.RutaJson is not null && (v.Cargado is null || v.Cargado.ArchivoJson is not null) ? "✓" : "")</td>
                    <td class="text-center">@if (v.Informe is not null) { <a class="ens-mini" href="@v.Informe" target="_blank" title="@v.Cargado?.NombreOriginalInforme"><Ico Nombre="documento" /></a> }</td>
                    <td class="small">@v.Cargado?.Cambios</td>
                    <td class="text-center text-nowrap">
                        @if (!actual)
                        {
                            <button type="button" class="ens-mini" title="Ver esta versión" @onclick="() => Abrir(v)"><Ico Nombre="ubicar" /></button>
                        }
                        @if (v.Cargado is { } cv)
                        {
                            <button type="button" class="ens-mini" title="Eliminar (va a la Papelera)" @onclick="() => PedirEliminarAsync(cv)"><Ico Nombre="eliminar" /></button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}

@if (verVinculo)
{
    @if (verCamposVinculo && motorVinculo is not null)
    {
        <PanelCampos Motor="motorVinculo" OnCerrar="() => verCamposVinculo = false" OnCambio="StateHasChanged" />
    }
    <input class="form-control form-control-sm mb-2" style="max-width:240px;" placeholder="Buscar modelo..." @bind="filtroVinculo" @bind:event="oninput" />
    <div class="tabla-scroll tabla-llena"><table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin">
        <thead>
            <tr>
                @foreach (var c in ColumnasVinculo)
                {
                    <th class="th-ordenable" @onclick="() => OrdenarVinculo(c.Clave)">@c.Nombre@(colVinculo == c.Clave ? (ascVinculo ? " ▲" : " ▼") : "")</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var (c, id) in FilasVinculo)
            {
                var repetido = cfg.Count(x => ConfigModelos3D.Norm(x.Nombre) == ConfigModelos3D.Norm(c.Nombre)) > 1;
                <tr class="@(c.Vinculado ? "ifc-vinc-on" : "")">
                    @foreach (var col in ColumnasVinculo)
                    {
                        @if (col.Origen == OrigenCampoTabla.Nativo && col.Clave == "nombre")
                        {
                            <td class="@(repetido ? "ifc-vinc-rep" : "")" title="@(repetido ? "Varios modelos con este nombre: solo uno va a Línea 3D" : null)">
                                <input class="form-control form-control-sm" value="@c.Nombre" @onchange="@(e => CambiarNombre(c, e.Value?.ToString() ?? ""))" />
                            </td>
                        }
                        else if (col.Origen == OrigenCampoTabla.Nativo && col.Clave == "descripcion")
                        {
                            <td><input class="form-control form-control-sm" value="@c.Descripcion" @onchange="@(e => CambiarDescripcion(c, e.Value?.ToString() ?? ""))" /></td>
                        }
                        else if (col.Origen == OrigenCampoTabla.Nativo && col.Clave == "linea3d")
                        {
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input" checked="@c.Vinculado" title="Mostrar este modelo en Línea 3D" @onchange="@(e => Vincular(c, (bool)e.Value!))" />
                            </td>
                        }
                        else
                        {
                            <CeldaCampo Motor="motorVinculo!" Campo="col" Fila="id" Clase="@(col.Clave == "codigo" ? "fw-bold" : null)" OnCambio="StateHasChanged" />
                        }
                    }
                </tr>
            }
        </tbody>
    </table></div>
}
else if (sel is null && familiaSel is null)
{
    <div class="ens-grid">
        @foreach (var g in modelos.GroupBy(m => m.Familia ?? "Otros"))
        {
            var primero = g.Last();
            <div class="ens-cuadro ifc-cuadro" role="button" title="Familia @g.Key" @onclick="() => familiaSel = g.Key">
                @if (primero.MiniUrl is not null)
                {
                    <img src="@primero.MiniUrl" alt="" class="ifc-mini" />
                }
                <div class="ens-nombre">@g.Key</div>
                <div class="ens-cuenta">@g.Count()</div>
            </div>
        }
    </div>
}
else if (sel is null)
{
    <div class="m3d-grid">
        @foreach (var m in modelos.Where(x => (x.Familia ?? "Otros") == familiaSel))
        {
            var c = ConfigDe(m);
            var r = m.Resumen;
            var desc = c?.Descripcion is { Length: > 0 } d ? d : m.Descripcion;
            <div class="m3d-card" role="button" title="@desc" @onclick="() => Abrir(m)">
                <div class="m3d-foto">
                    @if (m.MiniUrl is not null)
                    {
                        <img src="@m.MiniUrl" alt="" />
                    }
                    @if (c?.Vinculado == true)
                    {
                        <span class="ifc-l3d" title="En Línea 3D como @c.Nombre"><IconoPunto Punto="menu:linea3d" Clase="ui-svg"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M7 20 9 6l2 14M13 20l2-14 2 14"/><path d="M4 9c3 2 6 2 8 0s5-2 8 0"/></svg></IconoPunto></span>
                    }
                    @if (m.Cargado is { } cg)
                    {
                        <span class="m3d-ver" title="Cargado el @cg.FechaCarga.ToString("yyyy-MM-dd")">v@(cg.Version)</span>
                    }
                </div>
                <div class="m3d-pie">
                    <div class="m3d-cod">@m.Nombre<small>@desc</small></div>
                    @if (r is not null)
                    {
                        <div class="m3d-chips">
                            @if (r.AltoMm is double alto) { <span class="m3d-chip" title="Alto total">↕ @((alto / 1000).ToString("N1", Es)) m</span> }
                            @if (r.Miembros > 0) { <span class="m3d-chip" title="Piezas del modelo">@r.Miembros.ToString("N0", Es) piezas</span> }
                            @if (r.PesoKg is double kg) { <span class="m3d-chip" title="Peso total del modelo">@kg.ToString("N0", Es) kg</span> }
                            <span class="m3d-chip @(r.Validaciones > 0 ? "ok" : "av")" title="Cotas validadas plano / modelo">@(r.Validaciones > 0 ? "✓" : "○") @r.Validaciones @(r.Validaciones == 1 ? "validación" : "validaciones")</span>
                            <span class="m3d-chip av" title="Supuestos declarados">@r.Supuestos supuestos</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="ifc-marco" @ref="marco">
        <div class="ifc-visor" @ref="contenedor"></div>
        @if (verLista && torreJson is not null)
        {
            var filasBom = FilasBom;
            <aside class="ifc-bom">
                <div class="ifc-bom-cab">
                    <input class="form-control form-control-sm" placeholder="Buscar marca, perfil, conjunto u hoja…" @bind="filtroBom" @bind:event="oninput" />
                    <span class="ifc-bom-cuenta" title="Filas">@filasBom.Count / @torreJson.Lista.Count</span>
                    <BotonCampos Activo="verCamposBom" Deshabilitado="motorBom is null" OnClick="() => verCamposBom = true" />
                    <BotonExportar Titulo="@($"Lista de materiales {sel?.Nombre}")" Motor="motorBom" Filas="() => FilasBom.Select(IdBom)" Deshabilitado="motorBom is null" />
                    <button type="button" class="pg-btn" title="Cerrar lista" @onclick="() => verLista = false"><Ico Nombre="cancelar" /></button>
                </div>
                @if (piezaSel is not null)
                {
                    var asg = AsignacionDe(piezaSel);
                    <div class="ifc-pieza">
                        <span class="ifc-pieza-id" title="Pieza seleccionada en el modelo">@piezaSel</span>
                        @if (asg?.Marca is not null)
                        {
                            <span class="rg-chip" title="Perfil asignado a mano">@asg.Perfil · @asg.Marca
                                <button type="button" class="rg-chip-x" title="Quitar el perfil asignado" @onclick="QuitarPerfilAsync">✕</button></span>
                        }
                        else if (!LeidaAuto(piezaSel))
                        {
                            <span class="text-warning small" title="Elige en la lista la marca de esta pieza">○ sin perfil</span>
                        }
                        @if (asg?.ArchivoPlanoMaestroId is int ap)
                        {
                            <span class="rg-chip" title="Plano adjuntado a mano">📄 @NombrePlanoAsignado(ap)
                                <button type="button" class="rg-chip-x" title="Quitar el plano" @onclick="QuitarPlanoAsync">✕</button></span>
                        }
                        <button type="button" class="ens-mini ms-auto @(buscandoPlano ? "activo" : "")" title="Adjuntar plano a esta pieza" @onclick="AbrirBuscarPlano"><Ico Nombre="adjuntar" /></button>
                    </div>
                    @if (buscandoPlano)
                    {
                        <div class="ifc-plano-buscar">
                            <input class="form-control form-control-sm mb-1" placeholder="Buscar plano…" @bind="filtroPlano" @bind:event="oninput" />
                            <div class="ifc-plano-lista">
                                @foreach (var p in PlanosFiltrados)
                                {
                                    var pid = p.Id;
                                    <button type="button" class="doc-menu-op" @onclick="() => AsignarPlanoAsync(pid)"><Ico Nombre="documento" /> <span class="text-truncate">@p.Texto</span></button>
                                }
                                @if (!PlanosFiltrados.Any()) { <span class="doc-menu-op doc-menu-off">—</span> }
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(mensajePieza)) { <div class="alert alert-warning py-1 m-1 small">@mensajePieza</div> }
                }
                <div class="tabla-scroll ifc-bom-tabla" @ref="bomScroll">
                    <table class="table table-sm table-bordered table-hover tabla-compacta align-middle mb-0 tabla-pin">
                        <thead>
                            <tr>
                                @foreach (var c in ColumnasBom)
                                {
                                    <th class="th-ordenable" @onclick="() => OrdenarBom(c.Clave)">@c.Nombre@(colBom == c.Clave ? (ascBom ? " ▲" : " ▼") : "")</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="filasBom" Context="f" ItemSize="AltoFila" SpacerElement="tr" OverscanCount="20">
                                @{ var id = IdBom(f); var mapeada = torreJson.Piezas.ContainsKey(ClaveFila(f)); }
                                <tr class="@(filasSel.Contains(id) ? "ifc-bom-sel" : "")">
                                    @foreach (var c in ColumnasBom)
                                    {
                                        <CeldaCampo Motor="motorBom!" Campo="c" Fila="id" Clase="@(c.Clave == "marca" ? "fw-bold" : null)" OnCambio="StateHasChanged" />
                                    }
                                    <td class="text-center text-nowrap">
                                        @if (mapeada)
                                        {
                                            <button type="button" class="ens-mini" title="Ver en el modelo" @onclick="() => VerFilaAsync(f)"><Ico Nombre="ubicar" /></button>
                                        }
                                        @if (piezaSel is not null && EsAnguloL(f))
                                        {
                                            <button type="button" class="ens-mini" title="@($"Asignar {f.Perfil} ({f.Marca}) a la pieza {piezaSel}")" @onclick="() => AsignarFilaAsync(f)"><Ico Nombre="usar-en" /></button>
                                        }
                                    </td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
            </aside>
        }
        @if (verCamposBom && motorBom is not null)
        {
            <PanelCampos Motor="motorBom" OnCerrar="() => verCamposBom = false" OnCambio="StateHasChanged" />
        }
    </div>
}

@code {
