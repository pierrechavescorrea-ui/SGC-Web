        if (verVinculo)
        {
            verVinculo = false; verCamposVinculo = false;
            var p = previa?.Split(':', 2);
            if (p is null) { await JS.VolverAsync(); return; }
            if (p[0] == "modelo" && p.Length == 2 && modelos.FirstOrDefault(x => x.Archivo == p[1]) is { } mv) { familiaSel = mv.Familia ?? "Otros"; await Abrir(mv); return; }
            familiaSel = p[0] == "familia" && p.Length == 2 ? p[1] : null;
            return;
        }
        if (sel is not null)
        {
            var familia = sel.Familia ?? "Otros";
            await CerrarVisor(); sel = null; verVersiones = false;
            if (previa == "vinculo") { await AbrirVinculo(); return; }
            familiaSel = familia;
            return;
        }
        if (familiaSel is not null) { familiaSel = null; return; }
        await JS.VolverAsync();
    }

    private async Task CerrarVisor()
    {
        if (visor is not null)
        {
            try { await visor.InvokeVoidAsync("dispose"); await visor.DisposeAsync(); } catch { }
            visor = null;
