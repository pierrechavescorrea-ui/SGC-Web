            var dir = Path.Combine(Env.WebRootPath, CarpetaMiniaturas.Replace('/', Path.DirectorySeparatorChar));
            Directory.CreateDirectory(dir);
            var ruta = Path.Combine(dir, RaizArchivo(s) + ".png");
            await File.WriteAllBytesAsync(ruta, Convert.FromBase64String(b64));
            var url = CarpetaMiniaturas + "/" + RaizArchivo(s) + ".png?v=" + File.GetLastWriteTimeUtc(ruta).Ticks;
            foreach (var m in modelos.Where(x => x.Url == s.Url)) { m.MiniUrl = url; m.SinMiniatura = false; }
            s.SinMiniatura = false;
