    // Enlaces a los PDF del listado maestro de Planos (los muestra la ficha de la pieza).
    private async Task EnlazarPlanosAsync()
    {
        // Copias locales: tras cada await el usuario pudo cerrar el visor o salir de la página (sel/visor/torreJson = null).
        var v = visor; var s = sel; var t = torreJson;
        if (v is null || s is null || t is null) return;
        try
        {
            var porPieza = new Dictionary<string, string>();
            var refs = new List<EnlacePlanos.Referencia>();
            foreach (var m in t.Miembros)
            {
                var r = EnlacePlanos.DePieza(m.Plano?.Codigo, m.Plano?.Hoja ?? 0, m.Plano?.Titulo, t.PlanoBase, m.Fuente);
                if (r is null) continue;
                refs.Add(r);
                porPieza[m.Id] = EnlacePlanos.Clave(r.Codigo, r.Hoja);
            }
            var enlaces = (await EnlacePlanos.ResolverAsync(Db, refs)).Select(e => new { clave = e.Clave, texto = e.Texto, url = e.Url }).ToList();
            if (!Vigente(v, s)) return;
            // Plano adjuntado a mano a una pieza: manda sobre el que se dedujo del IFC.
            var ids = asignaciones.Where(a => a.ArchivoPlanoMaestroId != null).Select(a => a.ArchivoPlanoMaestroId!.Value).Distinct().ToList();
            if (ids.Count > 0)
            {
                var archs = Db.ArchivosPlanoMaestro.AsNoTracking().Where(a => ids.Contains(a.Id) && !a.Eliminado).ToDictionary(a => a.Id);
                foreach (var a in asignaciones.Where(a => a.ArchivoPlanoMaestroId is int id && archs.ContainsKey(id)))
                {
                    var arch = archs[a.ArchivoPlanoMaestroId!.Value];
                    var clave = "manual|" + arch.Id;
                    if (enlaces.All(e => e.clave != clave)) enlaces.Add(new { clave, texto = arch.NombreOriginal, url = (string?)arch.RutaArchivo });
                    porPieza[a.Pieza] = clave;
                }
            }
            if (!Vigente(v, s)) return;
            await v.InvokeVoidAsync("setPlanos", s.Url, enlaces, porPieza);
        }
        catch (Exception) { /* sin enlaces (o visor ya cerrado): la ficha muestra el código del plano del IFC */ }
    }

    // ================= Cargar modelo IFC (nuevo o nueva versión) =================
    private const long MaxArchivo = 500L * 1024 * 1024;

    private sealed class FormCarga
    {
        public string Codigo { get; set; } = "";
        public string? Nombre { get; set; }
        public string? Familia { get; set; }
        public string? Descripcion { get; set; }
        public string? Cambios { get; set; }
        public int Version { get; set; } = 1;
        public bool Reemplaza { get; set; }      // ya hay un modelo con ese código (cargado o del repositorio)
        public bool Fijo { get; set; }           // nueva versión desde el visor: el código no cambia
        public bool Leyendo { get; set; }
        public bool Guardando { get; set; }
        public string? Mensaje { get; set; }
        public Dictionary<string, (string Ruta, string Nombre)> Temp { get; } = new();   // ifc | json | mini | informe
        public ModelosCargados.LecturaIfc? Ifc { get; set; }
        public int? MiembrosJson { get; set; }
    }

    private FormCarga? carga;
    private bool verVersiones;

    private IEnumerable<string> CodigosExistentes => modelos.Select(m => m.Cargado?.Codigo ?? m.Nombre).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c);

    private bool PuedeGuardarCarga => carga is { Leyendo: false, Guardando: false } c && ConfigModelos3D.Norm(c.Codigo).Length > 0
        && c.Ifc is { EsIfc: true } && (!c.Temp.ContainsKey("json") || c.MiembrosJson is not null);

    private void AbrirCarga(ModeloIfc? origen)
    {
        if (carga is not null) { CerrarCarga(); return; }
        elimVersion = null;
        carga = new FormCarga();
        if (origen is not null)
        {
            carga.Fijo = true;
            carga.Nombre = origen.Cargado?.Nombre ?? ConfigDe(origen)?.Nombre;
            carga.Familia = origen.Familia;
            carga.Descripcion = origen.Cargado?.Descripcion ?? origen.Descripcion;
            CambiarCodigo(origen.Cargado?.Codigo ?? origen.Nombre);
        }
    }

    private void CambiarCodigo(string codigo)
    {
        if (carga is null) return;
        carga.Codigo = codigo.Trim();
        var k = ConfigModelos3D.Norm(carga.Codigo);
        var existente = modelos.FirstOrDefault(m => ConfigModelos3D.Norm(m.Cargado?.Codigo ?? m.Nombre) == k);
        carga.Reemplaza = k.Length > 0 && existente is not null;
        if (existente is not null)
        {
            carga.Familia ??= existente.Familia;
            carga.Descripcion ??= existente.Cargado?.Descripcion ?? existente.Descripcion;
        }
        try { carga.Version = k.Length == 0 ? 1 : ModelosCargados.SiguienteVersion(Db, carga.Codigo); carga.Mensaje = null; }
        catch (Exception ex) { carga.Mensaje = "Falta aplicar la migración ModelosIfcCargados: " + ex.Message; }
    }

    private async Task RecibirAsync(InputFileChangeEventArgs e, string clase)
    {
        var c = carga;
        if (c is null) return;
        c.Leyendo = true; c.Mensaje = null;
        try
        {
            var f = e.File;
            var dir = Path.Combine(Path.GetTempPath(), "sigweb-ifc");
            Directory.CreateDirectory(dir);
            var tmp = Path.Combine(dir, Guid.NewGuid().ToString("N") + Path.GetExtension(f.Name).ToLowerInvariant());
            await using (var src = f.OpenReadStream(MaxArchivo))
            await using (var dst = File.Create(tmp))
                await src.CopyToAsync(dst);
            if (c.Temp.TryGetValue(clase, out var viejo)) BorrarTemp(viejo.Ruta);
            c.Temp[clase] = (tmp, f.Name);
            if (clase == "ifc")
            {
                c.Ifc = await Task.Run(() => ModelosCargados.LeerIfc(tmp));
                // torre-bp7.ifc → BP7
                if (!c.Fijo && ConfigModelos3D.Norm(c.Codigo).Length == 0)
                {
                    var n = Path.GetFileNameWithoutExtension(f.Name);
                    if (n.StartsWith("torre-", StringComparison.OrdinalIgnoreCase)) n = n[6..];
                    CambiarCodigo(n.ToUpperInvariant());
                }
            }
            else if (clase == "json") c.MiembrosJson = await Task.Run(() => ModelosCargados.LeerJson(tmp));
        }
        catch (Exception ex) { c.Mensaje = $"No se pudo leer {e.File.Name}: {ex.Message}"; }
        finally { c.Leyendo = false; }
    }

    private static void BorrarTemp(string ruta) { try { if (File.Exists(ruta)) File.Delete(ruta); } catch { } }

    private void CerrarCarga()
    {
        if (carga is not null) foreach (var t in carga.Temp.Values) BorrarTemp(t.Ruta);
        carga = null;
    }

    private static string NombreSeguro(string nombre) =>
        System.Text.RegularExpressions.Regex.Replace(Path.GetFileName(nombre), @"[^A-Za-z0-9._-]+", "_");

    // Sin JSON cargado: se genera desde el IFC (LectorIfcTorre). Si el IFC no trae barras legibles, el modelo
    // queda sin JSON como antes (visor IFC sí, lista de materiales/Línea 3D/montaje no) y no se detiene la carga.
    private async Task<string?> GenerarJsonDesdeIfcAsync(string archivoIfcWeb, string raiz, List<string> movidos)
    {
        try
        {
            var rutaIfc = Path.Combine(Env.WebRootPath, archivoIfcWeb.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
            var r = await Task.Run(() => LectorIfcTorre.Convertir(rutaIfc));
            if (r.Miembros == 0) return null;
            var dir = Path.Combine(Env.WebRootPath, ModelosCargados.CarpetaJson.Replace('/', Path.DirectorySeparatorChar));
            Directory.CreateDirectory(dir);
            var ruta = Path.Combine(dir, raiz + ".json");
            await File.WriteAllTextAsync(ruta, r.Json, new System.Text.UTF8Encoding(false));
            movidos.Add(ruta);
            return "/" + ModelosCargados.CarpetaJson + "/" + raiz + ".json";
        }
        catch { return null; }
    }

    private async Task GuardarCargaAsync()
    {
        var c = carga;
        if (c is null || !PuedeGuardarCarga) return;
        c.Guardando = true; c.Mensaje = null;
        var movidos = new List<string>();
        string Mover(string clase, string carpeta, string destino)
        {
            var dir = Path.Combine(Env.WebRootPath, carpeta.Replace('/', Path.DirectorySeparatorChar));
            Directory.CreateDirectory(dir);
            var ruta = Path.Combine(dir, destino);
            File.Move(c.Temp[clase].Ruta, ruta, overwrite: true);
            movidos.Add(ruta);
            return "/" + carpeta + "/" + destino;
        }
        try
        {
            var codigo = c.Codigo.Trim();
            var ver = ModelosCargados.SiguienteVersion(Db, codigo);
            var raiz = ModelosCargados.Raiz(codigo, ver);
            var ent = new ModeloIfcCargado
            {
                Codigo = codigo, Version = ver,
                Nombre = string.IsNullOrWhiteSpace(c.Nombre) ? codigo : c.Nombre.Trim(),
                Familia = string.IsNullOrWhiteSpace(c.Familia) ? null : c.Familia.Trim(),
                Descripcion = string.IsNullOrWhiteSpace(c.Descripcion) ? null : c.Descripcion.Trim(),
                Cambios = string.IsNullOrWhiteSpace(c.Cambios) ? null : c.Cambios.Trim(),
                NombreOriginalIfc = c.Temp["ifc"].Nombre,
                Validaciones = c.Ifc?.Validaciones ?? 0, Supuestos = c.Ifc?.Supuestos ?? 0,
                FechaCarga = DateTime.Now,
            };
            ent.ArchivoIfc = Mover("ifc", ModelosCargados.CarpetaIfc, raiz + ".ifc");
            if (c.Temp.ContainsKey("json")) ent.ArchivoJson = Mover("json", ModelosCargados.CarpetaJson, raiz + ".json");
            else ent.ArchivoJson = await GenerarJsonDesdeIfcAsync(ent.ArchivoIfc, raiz, movidos);
            if (c.Temp.TryGetValue("mini", out var mini)) ent.ArchivoMiniatura = Mover("mini", ModelosCargados.CarpetaIfc, raiz + Path.GetExtension(mini.Ruta));
            if (c.Temp.TryGetValue("informe", out var inf))
            {
                ent.ArchivoInforme = Mover("informe", ModelosCargados.CarpetaIfc + "/informes", raiz + "-" + NombreSeguro(inf.Nombre));
                ent.NombreOriginalInforme = inf.Nombre;
            }
            Db.ModelosIfcCargados.Add(ent);
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            carga = null;
            CargarModelos();
            if (modelos.FirstOrDefault(m => m.Cargado?.Id == ent.Id) is { } nuevo)
            {
                familiaSel = nuevo.Familia ?? "Otros";
                await Abrir(nuevo);
            }
        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            foreach (var r in movidos) BorrarTemp(r);
            c.Mensaje = "No se pudo guardar (¿falta aplicar la migración ModelosIfcCargados?): " + ex.Message;
            c.Guardando = false;
            foreach (var k in c.Temp.Keys.ToList()) if (!File.Exists(c.Temp[k].Ruta)) c.Temp.Remove(k);
            if (!c.Temp.ContainsKey("ifc")) c.Ifc = null;
            if (!c.Temp.ContainsKey("json")) c.MiembrosJson = null;
        }
    }

    // ================= Eliminar una versión cargada → Papelera =================
    private ModeloIfcCargado? elimVersion;
    private SigWeb.Data.Impacto.InformeImpacto? impacto;
    private bool impactoOk;
    private bool BloqueadoPorImpacto => impacto is null || (impacto.RequiereEntender && !impactoOk);

    private async Task PedirEliminarAsync(ModeloIfcCargado v)
    {
        CerrarCarga();
        elimVersion = v; impacto = null; impactoOk = false;
        try { impacto = await Analizador.ModeloIfc(v.Id); }
        catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
    }

    private void CancelarEliminar() { elimVersion = null; impacto = null; impactoOk = false; }

    private async Task ConfirmarEliminarAsync()
    {
        if (elimVersion is null || BloqueadoPorImpacto) return;
        var id = elimVersion.Id;
        var codigo = ConfigModelos3D.Norm(elimVersion.Codigo);
        try
        {
            var ent = await Db.ModelosIfcCargados.FirstOrDefaultAsync(x => x.Id == id);
            if (ent is not null) { ent.Eliminado = true; ent.FechaEliminacion = DateTime.Now; await Db.SaveChangesAsync(); }
        }
        catch (Exception ex) { error = "No se pudo eliminar: " + ex.Message; }
        Db.ChangeTracker.Clear();
        CancelarEliminar();
        var abierto = sel?.Cargado?.Id == id;
        CargarModelos();
        if (!abierto) return;
        // Se abre lo que queda vigente de ese código (otra versión o el del repositorio).
        var siguiente = modelos.FirstOrDefault(m => ConfigModelos3D.Norm(m.Cargado?.Codigo ?? m.Nombre) == codigo);
        if (siguiente is not null) await Abrir(siguiente);
        else { await CerrarVisor(); sel = null; verVersiones = false; }
    }

    // El visor sigue siendo el mismo y la página no se cerró (tras un await el usuario pudo navegar o elegir otro modelo).
    private bool cerrado;
    private bool Vigente(IJSObjectReference v, ModeloIfc s) => !cerrado && ReferenceEquals(visor, v) && ReferenceEquals(sel, s);
    private static bool CerradoJs(Exception e) => e is JSDisconnectedException or ObjectDisposedException or TaskCanceledException;

    public async ValueTask DisposeAsync()
    {
        cerrado = true;
        CerrarCarga();
        await CerrarVisor();
        if (modulo is not null) { try { await modulo.DisposeAsync(); } catch { } }
        yo?.Dispose();
    }

