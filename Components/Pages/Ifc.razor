    private void CargarModelos()
    {
        try
        {
            var ruta = Path.Combine(Env.WebRootPath, "modelos-ifc", "modelos.json");
            repositorio = File.Exists(ruta)
                ? JsonSerializer.Deserialize<List<ModeloIfc>>(File.ReadAllText(ruta), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new()
                : new();
            foreach (var m in repositorio)
            {
                m.Url = "modelos-ifc/" + m.Archivo;
                m.MiniUrl = string.IsNullOrEmpty(m.Miniatura) ? null : "modelos-ifc/" + m.Miniatura;
