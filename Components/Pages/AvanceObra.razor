    private async Task AlternarCapaTd(string k)
    {
        var on = capasTdOff.Contains(k);
        if (on) capasTdOff.Remove(k); else capasTdOff.Add(k);
        await LlamarTd("capa", k, on);
    }

    private async Task LlamarTd(string metodo, params object[] args)
    {
        if (visorTd is null) return;
        try { await visorTd.InvokeVoidAsync(metodo, args); } catch (JSException) { } catch (JSDisconnectedException) { }
    }

    // Crea el diorama al entrar a la vista, le pasa la línea cuando cambia la instantánea y el estado al cambiar fecha o tiro.
    private async Task SincronizarTendido()
    {
        if (vista != "tendido" || s is null)
        {
            if (visorTd is not null) await LiberarTendido();
            return;
        }
        if (tdIniciando) return;
        try
        {
            tdIniciando = true;
            if (visorTd is null)
            {
                moduloTd ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/tendidoCesium.js");
                yoTd ??= DotNetObjectReference.Create(this);
                visorTd = await moduloTd.InvokeAsync<IJSObjectReference>("crear", lienzoTd, yoTd);
                tdDatosDe = null; tdEstado = null; tdSelEnviado = -1;
                foreach (var k in capasTdOff) await visorTd.InvokeVoidAsync("capa", k, false);
                if (terrTd != "satelite") await visorTd.InvokeVoidAsync("terreno", terrTd);
                if (escTd > 0) await visorTd.InvokeVoidAsync("escala", escTd);
                if (colorTd != "avance") await visorTd.InvokeVoidAsync("colores", colorTd, hexTd);
                if (simTd) await visorTd.InvokeVoidAsync("simular", true);
                if (famOffTd.Count > 0) await visorTd.InvokeVoidAsync("familias", famOffTd.ToList());
                if (giroTd) await visorTd.InvokeVoidAsync("girar", true);
            }
            if (!ReferenceEquals(tdDatosDe, s))
            {
                tdDatosDe = s; tdEstado = null; tdSelEnviado = -1;
                // Mismo formato que Línea 3D (su visor dibuja las torres y el terreno; tendidoCesium.js pone la capa de obra).
                var ids = s.Tiros.SelectMany(t => t.Torres).ToHashSet();
                var conPos = s.Torres.Where(t => ids.Contains(t.Id) && (t.Lat != 0 || t.Lon != 0)).ToList();
                var lat0 = conPos.Count > 0 ? conPos.Average(t => t.Lat) : 0;
                var lon0 = conPos.Count > 0 ? conPos.Average(t => t.Lon) : 0;
                var kLon = 111320.0 * Math.Cos(lat0 * Math.PI / 180.0);
                var datos = new
                {
                    torres = conPos.Select(t => new
                    {
                        id = t.Id, nombre = t.Nombre, x = (t.Lon - lon0) * kLon, z = -(t.Lat - lat0) * 110574.0, lat = t.Lat, lon = t.Lon,
                        familia = string.IsNullOrEmpty(t.Familia) ? "?" : t.Familia, cuerpo = t.Cuerpo,
                        real = t.ModeloCodigo is not null, modelo = t.ModeloCodigo ?? "", color = SigWeb.Data.Modelos3D.ColoresTorre.De(t.Familia), pct = (double?)null
                    }),
                    tiros = s.Tiros.Select(t => new { id = t.Id, nombre = t.Nombre, torres = t.Torres }),
                    urls = conPos.Where(t => t.ModeloCodigo is not null).GroupBy(t => t.ModeloCodigo!).ToDictionary(g => g.Key, g => g.First().ModeloUrl),
                    origen = new { lat0, lon0 }
                };
                await visorTd.InvokeVoidAsync("cargar", datos);
            }
            var dia = DiaTd();
            var clave = $"{dia:yyyyMMdd}";
            if (tdEstado != clave)
            {
                tdEstado = clave;
                var torresEst = TorresTd(dia).ToDictionary(x => x.Key.ToString(), x => new { m = x.Value.M, c = x.Value.C, p = x.Value.P });
                await visorTd.InvokeVoidAsync("estado", s.Tiros.ToDictionary(t => t.Id.ToString(), t => s.CuadroTiro(t, dia)), torresEst);
            }
            if (tdSelEnviado != (tiroSel ?? 0))
            {
                tdSelEnviado = tiroSel ?? 0;
                await visorTd.InvokeVoidAsync("seleccionar", tiroSel);
            }
            if (enfocarTd is int ef)
            {
                enfocarTd = null;
                await visorTd.InvokeVoidAsync("enfocar", ef);
            }
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { error = "No se pudo iniciar el diorama: " + ex.Message; StateHasChanged(); }
        finally { tdIniciando = false; }
    }

    private async Task LiberarTendido()
    {
        PararTd();
        var v = visorTd; visorTd = null; tdDatosDe = null; tdEstado = null; tdSelEnviado = -1; torreTd = null; irTd = "";
        try { if (v is not null) { await v.InvokeVoidAsync("liberar"); await v.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

