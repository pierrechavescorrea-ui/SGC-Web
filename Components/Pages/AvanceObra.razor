    };

    // ----- Edición de fechas de inicio y fin en la matriz -----
    // Las fechas salen de los registros de avance: el inicio es el primer registro y el fin el último que
    // llegó a 100 %. Editar una fecha mueve ese registro al informe del nuevo día (se crea si no existe);
    // poner una fecha donde no había crea el registro (inicio = 0 %, fin = 100 %); borrarla lo envía a la Papelera.
    private record struct CeldaMx(int T, int C, int A, bool Fin);
    private bool editMx, confirmarMx;
    private int mxPapelera;
    private readonly Dictionary<CeldaMx, DateTime?> mxCambios = new();

    private void EditarMatriz() { mxCambios.Clear(); confirmarMx = false; error = null; editMx = true; }
    private void CancelarMatriz() { mxCambios.Clear(); confirmarMx = false; editMx = false; }

    private RenderFragment CeldaFecha(TorreAvance t, ActividadObra a, PataAvance? p, bool fin, DateTime? valor, bool editable) => __builder =>
    {
        if (!(editMx || editTo) || !editable)
        {
            <text>@Fecha(valor)</text>
            return;
        }
        var k = new CeldaMx(t.Id, p?.ComponenteId ?? 0, a.Id, fin);
        var cambiada = mxCambios.TryGetValue(k, out var c);
        var v = cambiada ? c : valor;
        <input type="date" class="av-mx-in @(cambiada ? "cambiado" : "")" value="@(v?.ToString("yyyy-MM-dd"))"
               title="@(fin ? "Fin" : "Inicio")" @onchange="e => CambiarFechaMx(k, valor, e)" />
    };

    private void CambiarFechaMx(CeldaMx k, DateTime? original, ChangeEventArgs e)
    {
        confirmarMx = false;
        DateTime? nueva = DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var f) ? f.Date : null;
        if (nueva == original?.Date) mxCambios.Remove(k);
        else mxCambios[k] = nueva;
    }

    private async Task GuardarMatriz()
    {
        if (s is null || guardando) return;
        error = null;
        if (mxCambios.Count == 0) { CancelarMatriz(); return; }
        guardando = true;
        try
        {
            var n = await AplicarFechasAsync();
            if (n is null) return;
            CancelarMatriz();
            Cargar(); visorTorre = null;
            aviso = $"{n} fecha(s) guardada(s).";
        }
        finally { guardando = false; }
    }

    // Aplica mxCambios (matriz o Torre por torre). null = no se guardó (errores, falta confirmar la Papelera o falló la base).
    private async Task<int?> AplicarFechasAsync()
    {
        if (s is null) return null;
        // 1. Validar y planear cada actividad cambiada (torre o pata).
        var mover = new List<(int Id, DateTime Fecha)>();
        var crear = new List<(int Torre, int? Comp, int Act, DateTime Fecha, decimal Avance)>();
        var a100 = new List<int>();          // registros del mismo día que pasan a 100 %
        var a0 = new List<int>();            // registro único (inicio y fin) cuyo fin se quita: queda como inicio en 0 %
        var papelera = new List<int>();
        var errores = new List<string>();
        foreach (var g in mxCambios.GroupBy(x => (x.Key.T, x.Key.C, x.Key.A)))
        {
            if (Torre(g.Key.T) is not { } t || Act(g.Key.A) is not { } a) continue;
            var p = g.Key.C == 0 ? null : t.Patas.FirstOrDefault(x => x.ComponenteId == g.Key.C);
            var nombre = $"{t.Nombre}{(p is null ? "" : " pata " + p.Letra)} · {a.Nombre}";
            if (s.EsDeCantidades(t.Id, a.Id)) { errores.Add($"{nombre}: el avance sale de las cantidades (Costos y presupuestos › Avance diario); edítelo allá."); continue; }
            int? comp = g.Key.C == 0 ? null : g.Key.C;
            var regs = s.RegistrosDe(t, a, p);
            var (ri, rf) = s.RegistrosInicioFin(t, a, p);
            bool cIni = mxCambios.TryGetValue(new CeldaMx(g.Key.T, g.Key.C, g.Key.A, false), out var ini1);
            bool cFin = mxCambios.TryGetValue(new CeldaMx(g.Key.T, g.Key.C, g.Key.A, true), out var fin1);
            if (!cIni) ini1 = ri?.Fecha.Date;
            if (!cFin) fin1 = rf?.Fecha.Date;
            var resto = regs.Where(r => r != ri && r != rf).ToList();

            if (ini1 is DateTime i1 && fin1 is DateTime f1 && i1 > f1) { errores.Add($"{nombre}: inicio posterior al fin."); continue; }
            if (cFin && fin1 is not null && ini1 is null) { errores.Add($"{nombre}: falta la fecha de inicio."); continue; }
            if (ini1 is DateTime i2 && resto.FirstOrDefault(r => r.Fecha.Date < i2) is { } ra) { errores.Add($"{nombre}: hay avance registrado el {ra.Fecha:dd/MM/yyyy}, antes del inicio."); continue; }
            if (fin1 is DateTime f2 && resto.LastOrDefault(r => r.Fecha.Date > f2) is { } rp) { errores.Add($"{nombre}: hay avance registrado el {rp.Fecha:dd/MM/yyyy}, después del fin."); continue; }

            // Inicio
            if (cIni)
            {
                if (ini1 is DateTime d)
                {
                    if (ri is null || ri == rf) { if (fin1 is null || d < fin1) crear.Add((t.Id, comp, a.Id, d, 0)); }
                    else mover.Add((ri.Id, d));
                }
                else if (ri is not null)
                {
                    if (ri.AvanceAcumulado > 0 || resto.Count > 0 || (rf is not null && rf != ri)) { errores.Add($"{nombre}: tiene avance; el inicio no se puede quitar desde la matriz."); continue; }
                    papelera.Add(ri.Id);
                }
            }
            // Fin
            if (cFin)
            {
                if (fin1 is DateTime d)
                {
                    if (rf is null)
                    {
                        // Si ese día ya hay un registro de la misma torre o pata, pasa a 100 %; si no, se crea.
                        var mismoDia = regs.LastOrDefault(r => r.Fecha.Date == d && r.ComponenteId == comp);
                        if (mismoDia is not null) a100.Add(mismoDia.Id); else crear.Add((t.Id, comp, a.Id, d, 100));
                    }
                    else
                    {
                        if (regs.Any(r => r != rf && r.Fecha.Date == d && r.ComponenteId == rf.ComponenteId && r.AvanceAcumulado < 100))
                        { errores.Add($"{nombre}: ya hay un registro el {d:dd/MM/yyyy}; ajústalo en ese informe."); continue; }
                        // Inicio y fin en el mismo registro: el inicio se conserva con un registro en 0 %.
                        if (rf == ri && !cIni && d > rf.Fecha.Date) crear.Add((t.Id, comp, a.Id, rf.Fecha.Date, 0));
                        mover.Add((rf.Id, d));
                    }
                }
                else if (rf is not null)
                {
                    if (rf == ri && !cIni) a0.Add(rf.Id); else papelera.Add(rf.Id);
                }
            }
        }
        if (errores.Count > 0) { error = string.Join(" ", errores.Take(6)) + (errores.Count > 6 ? $" (+{errores.Count - 6})" : ""); confirmarMx = false; return null; }

        // 2. Lo que va a la Papelera se confirma antes.
        mxPapelera = papelera.Distinct().Count();
        if (mxPapelera > 0 && !confirmarMx) { confirmarMx = true; return null; }

        try
        {
            // 3. Informe de cada día de destino (se crea si no existe).
            var dias = mover.Select(m => m.Fecha).Concat(crear.Select(c => c.Fecha)).Distinct().ToList();
            var porDia = Db.InformesDiarios.Where(i => dias.Contains(i.Fecha.Date)).ToList()
                .GroupBy(i => i.Fecha.Date).ToDictionary(g => g.Key, g => g.OrderBy(i => i.Id).First());
            foreach (var d in dias.Where(d => !porDia.ContainsKey(d)))
            {
                var i = new InformeDiario { Fecha = d, Observaciones = "Creado al editar fechas en la matriz de avance." };
                Db.InformesDiarios.Add(i); porDia[d] = i;
            }
            await Db.SaveChangesAsync();

            var ids = mover.Select(m => m.Id).Concat(a100).Concat(a0).Concat(papelera).Distinct().ToList();
            var regsDb = Db.RegistrosAvance.Where(r => ids.Contains(r.Id)).ToDictionary(r => r.Id);
            foreach (var (id, d) in mover)
                if (regsDb.TryGetValue(id, out var r)) { r.Fecha = d; r.InformeDiarioId = porDia[d].Id; }
            foreach (var id in a100) if (regsDb.TryGetValue(id, out var r)) r.AvanceAcumulado = 100;
            foreach (var id in a0) if (regsDb.TryGetValue(id, out var r)) r.AvanceAcumulado = 0;
            var ahora = DateTime.Now;
            foreach (var id in papelera.Distinct()) if (regsDb.TryGetValue(id, out var r)) { r.Eliminado = true; r.FechaEliminacion = ahora; }
            foreach (var c in crear)
                Db.RegistrosAvance.Add(new RegistroAvance
                {
                    InformeDiarioId = porDia[c.Fecha].Id, Fecha = c.Fecha, ElementoTrazadoId = c.Torre, ComponenteId = c.Comp,
                    ActividadObraId = c.Act, AvanceAcumulado = c.Avance, Observaciones = "Fecha editada en la matriz."
                });
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            confirmarMx = false;
            return mxCambios.Count;
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo guardar: " + (ex.InnerException?.Message ?? ex.Message); return null; }
    }

    // ================= Tendido por tiros (diorama) =================
    // Maqueta plana: torres con la forma de Línea 3D, planta del trazado (KMZ) sin altimetría y cables por tiro.
    // Avance = RegistroAvanceTiro (actividades de ámbito Tiro); se edita aquí, a la fecha mostrada.
    private int? tiroSel;                     // null = línea completa
    private DateTime? diaTd;                  // fecha mostrada (null = hoy)
    private bool editTd, jugandoTd, giroTd, simTd;
    private string terrTd = "satelite", colorTd = "avance", hexTd = "#4e79a7";
    private double escTd;                     // 0 = automática (línea ×10; tiro según su vano)
    private readonly HashSet<string> famOffTd = new();
    private readonly Dictionary<(int Tiro, int Act), string> tdCambios = new();
    private readonly HashSet<string> capasTdOff = new();
    private CancellationTokenSource? ctsTd;
    private ElementReference lienzoTd, marcoTd;
    private async Task PantallaCompletaTd()
    {
        if (moduloTd is null) return;
        try { await moduloTd.InvokeAsync<bool>("pantallaCompleta", marcoTd); } catch (JSException) { } catch (JSDisconnectedException) { }
    }
    private IJSObjectReference? moduloTd, visorTd;
    private object? tdDatosDe;
    private string? tdEstado;
    private int? tdSelEnviado = -1;
    private bool tdIniciando;

    private (DateTime Ini, DateTime Fin) RangoTd()
    {
        var hoy = DateTime.Today;
        var f = FechasTd();
        if (f.Count == 0) return (hoy.AddDays(-30), hoy);
        return (f[0] < hoy ? f[0] : hoy, f[^1] > hoy ? f[^1] : hoy);
    }
    private DateTime DiaTd()
    {
        var (i, f) = RangoTd();
        var d = (diaTd ?? DateTime.Today).Date;
        return d < i ? i : d > f ? f : d;
    }
    // Días con registros de tendido o de las torres de los tiros (montaje, cimentación…): marcas de la línea de tiempo.
    private List<DateTime> FechasTd() => s is null ? new() : s.FechasTendido.Concat(s.Fechas).Distinct().OrderBy(d => d).ToList();

    // Estado de obra de cada torre de los tiros a la fecha (lo dibuja el visor y lo resume la franja bajo él):
    // m = montaje (0 a 1; -1 = no aplica), c = cimentación iniciada (alguna pata con excavación…concreto), p = % de la torre.
    private record EstadoTorreTd(double M, bool C, decimal? P);
    private EstadoTorreTd EstadoDe(TorreAvance t, DateTime dia)
    {
        var q = s!.Cuadro(t, dia);
        var cim = q.Patas.Values.Any(p => new[] { "exc", "sol", "niv", "ace", "con" }.Any(k => p.TryGetValue(k, out var x) && x > 0));
        return new(q.Torre.TryGetValue("mon", out var m) ? m : 0, cim, s.PctTorre(t, dia));
    }
    private (object? De, DateTime Dia, Dictionary<int, EstadoTorreTd> Mapa)? cacheTorresTd;
    private Dictionary<int, EstadoTorreTd> TorresTd(DateTime dia)
    {
        if (cacheTorresTd is { } c && ReferenceEquals(c.De, s) && c.Dia == dia) return c.Mapa;
        var mapa = new Dictionary<int, EstadoTorreTd>();
        foreach (var id in s!.Tiros.SelectMany(t => t.Torres).Distinct())
            if (Torre(id) is { } t) mapa[id] = EstadoDe(t, dia);
        cacheTorresTd = (s, dia, mapa);
        return mapa;
    }

    private List<TiroAvance> TirosTd() => tiroSel is int id ? s!.Tiros.Where(t => t.Id == id).ToList() : s!.Tiros;
    private decimal? PromedioTd(Func<TiroAvance, decimal?> f)
    {
        var v = TirosTd().Select(f).Where(x => x is not null).Select(x => x!.Value).ToList();
        return v.Count == 0 ? null : v.Average();
    }
    private decimal? PctEfectoTd(EfectoAvance3D ef, DateTime d)
    {
        var acts = s!.ActividadesTiro.Where(a => a.Efecto == ef).ToList();
        if (acts.Count == 0) return null;
        return PromedioTd(t => acts.Select(a => s.PctTiro(t, a, d)).Where(x => x is not null).Select(x => x!.Value).DefaultIfEmpty(0).Max());
    }

    private void ElegirTiro(int? id) { tiroSel = id; if (id is null) { editTd = false; tdCambios.Clear(); } }

    // ---------- Buscar torre y ficha de la torre seleccionada (clic en el diorama) ----------
    private DotNetObjectReference<AvanceObra>? yoTd;
    private int? torreTd;                     // torre con la ficha abierta
    private int? enfocarTd;                   // torre a enfocar en el próximo render (tras elegir su tiro)
    private string irTd = "";

    private List<TorreAvance> TorresConTiro() => s is null ? new() :
        s.Tiros.SelectMany(t => t.Torres).Distinct().Select(Torre).Where(t => t is not null && (t.Lat != 0 || t.Lon != 0)).Select(t => t!).ToList();

    // Torres del navegador: las del tiro elegido (en su orden) o todas las de los tiros.
    private List<TorreAvance> TorresNavTd() => s is null ? new() : tiroSel is int id
        ? (s.Tiros.FirstOrDefault(t => t.Id == id)?.Torres ?? new()).Select(Torre).Where(t => t is not null && (t.Lat != 0 || t.Lon != 0)).Select(t => t!).ToList()
        : TorresConTiro();
    private void IrTorreNavTd(TorreAvance t) { error = null; irTd = t.Nombre; torreTd = t.Id; enfocarTd = t.Id; }

    // Exacta, luego por inicio, luego por contenido. Abre su tiro (salvo editando otro) y lleva la cámara a la torre.
    private void IrATorreTd(ChangeEventArgs e)
    {
        var q = e.Value?.ToString()?.Trim() ?? "";
        irTd = q;
        if (q.Length == 0) return;
        var l = TorresConTiro();
        var t = l.FirstOrDefault(x => string.Equals(x.Nombre, q, StringComparison.OrdinalIgnoreCase))
             ?? l.FirstOrDefault(x => x.Nombre.StartsWith(q, StringComparison.OrdinalIgnoreCase))
             ?? l.FirstOrDefault(x => x.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase));
        if (t is null) { error = $"Ninguna torre de los tiros coincide con «{q}»."; return; }
        error = null; irTd = t.Nombre;
        var tiro = s!.Tiros.FirstOrDefault(x => x.Torres.Contains(t.Id));
        if (!editTd && tiro is not null && tiroSel != tiro.Id) ElegirTiro(tiro.Id);
        torreTd = t.Id; enfocarTd = t.Id;
    }

    [JSInvokable]
    public Task AlSeleccionarTorre(int? id, double alto, double ancho, string modelo)
    {
        torreTd = id;
        if (id is null) irTd = "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task AlTerreno(bool ok, string mensaje) => Task.CompletedTask;

    private async Task CerrarTorreTd() { torreTd = null; irTd = ""; await LlamarTd("deseleccionar"); }

    private void AvanceDeTorre(TorreAvance t)
    {
        VerVista("torre");
        buscar = ""; torreFoco = t.Id; idxT = null;
    }

    private void HojaDeVida(TorreAvance t) =>
        Nav.NavigateTo($"/trazado?torre={t.Id}&hdv=true&volver={(vista == "torre" ? "avance-obra-torre" : "avance-obra")}");

    private void VerEnTendido(TorreAvance t)
    {
        var tiro = s!.Tiros.FirstOrDefault(x => x.Torres.Contains(t.Id));
        if (tiro is null) return;
        VerVista("tendido");
        tiroSel = tiro.Id; torreTd = t.Id; enfocarTd = t.Id; irTd = t.Nombre;
    }

    // ---------- Ficha de la torre (Tendido y Torre por torre): avance de obra a la fecha y cumplimiento PIE actual ----------
    private bool ajustesTd;                   // panel "Capas y apariencia" del Tendido
    private bool listasTd = true;
    private bool listasTo = true;             // Torre por torre: false = visor a todo el ancho             // false = visor a todo el ancho (sin tiros ni actividades)
    private string fichaTab = "obra";         // obra | pie
    private bool fichaMin;
    private readonly Dictionary<int, SigWeb.Data.Pie.CumplimientoPie.DetallePie> pieCache = new();

    // Se consulta al mostrar la ficha (no mientras se guarda: el contexto estaría ocupado).
    private SigWeb.Data.Pie.CumplimientoPie.DetallePie? PieDe(int id)
    {
        if (pieCache.TryGetValue(id, out var d)) return d;
        if (guardando) return null;
        try { return pieCache[id] = SigWeb.Data.Pie.CumplimientoPie.Detalle(Db, id); }
        catch (Exception ex) { error = "No se pudo leer el PIE de la torre: " + ex.Message; return null; }
    }

    private static readonly MarkupString SvgChevron = new("<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg>");

    // cerrar ≠ null = ficha en ventana (Estado de las torres): botón cerrar y salto a Torre por torre.
    private RenderFragment FichaTorre(TorreAvance t, DateTime dia, bool enTendido, Action? cerrar = null) => __builder =>
    {
        var pO = s!.PctTorre(t, dia);
        var pie = PieDe(t.Id);
        var pP = pie?.Total.Pct;
        var tiro = s.Tiros.FirstOrDefault(x => x.Torres.Contains(t.Id));
        var e = EstadoDe(t, dia);
        var (estCls, estTxt) = e.M < 0 || e.M >= 1 ? ("av-td-ok", "Montada") : e.M > 0 ? ("av-td-curso", "En montaje") : e.C ? ("av-td-cim", "Cimentación") : ("", "Sin iniciar");
        var sub = string.Join(" · ", new[] { t.TipoTexto, tiro?.Nombre }.Where(x => !string.IsNullOrEmpty(x)));
        <div class="av-ficha @(fichaMin ? "min" : "")" @key="t.Id">
            <div class="av-ficha-cab">
                <div class="av-ficha-tits">
                    <span class="av-ficha-nom">@t.Nombre</span>
                    @if (sub.Length > 0) { <span class="av-ficha-sub">@sub</span> }
                </div>
                <span class="av-td-est @estCls">@estTxt</span>
                <button type="button" class="av-ficha-x av-ficha-plegar" title="@(fichaMin ? "Expandir" : "Contraer")" aria-expanded="@(!fichaMin)" @onclick="() => fichaMin = !fichaMin">@SvgChevron</button>
                @if (cerrar is not null)
                {
                    <button type="button" class="av-ficha-x" title="Cerrar" @onclick="cerrar"><Ico Nombre="cancelar" /></button>
                }
                else if (enTendido)
                {
                    <button type="button" class="av-ficha-x" title="Cerrar" @onclick="CerrarTorreTd"><Ico Nombre="cancelar" /></button>
                }
            </div>
            <div class="av-ficha-kpis" role="tablist">
                <button type="button" role="tab" class="av-ficha-kpi @(!fichaMin && fichaTab == "obra" ? "activo" : "")" aria-selected="@(fichaTab == "obra")" title="Avance de obra ponderado al @Fecha(dia)" @onclick='() => { fichaTab = "obra"; fichaMin = false; }'>
                    <span class="av-ficha-kpi-nom">Obra</span><b>@FormatoPct(pO)</b>
                    <span class="av-ficha-barra"><span style="width:@Pct0(pO ?? 0)%;@EstiloPct(pO)"></span></span>
                </button>
                <button type="button" role="tab" class="av-ficha-kpi @(!fichaMin && fichaTab == "pie" ? "activo" : "")" aria-selected="@(fichaTab == "pie")" title="@(pie is null ? "Cumplimiento PIE" : $"Cumplimiento PIE actual · {pie.Total.Aplican} de {pie.Total.Total} aplican")" @onclick='() => { fichaTab = "pie"; fichaMin = false; }'>
                    <span class="av-ficha-kpi-nom">PIE</span><b>@FormatoPct(pP)</b>
                    <span class="av-ficha-barra"><span style="width:@Pct0(pP ?? 0)%;@EstiloPct(pP)"></span></span>
                </button>
            </div>
            @if (!fichaMin)
            {
                <div class="av-ficha-det">
                    @if (fichaTab == "obra")
                    {
                        @foreach (var g in Grupos())
                        {
                            var v = s.PctGrupo(t, g.Key, dia);
                            if (v is null) continue;
                            <div class="av-ficha-fila" title="@($"{g.Key} · peso {(g.Sum(x => x.Peso) * 100).ToString("0.#", Es)} %")">
                                <span class="av-ficha-fila-nom">@g.Key</span><b>@FormatoPct(v)</b>
                                <span class="av-ficha-barra"><span style="width:@Pct0(v)%;@EstiloPct(v)"></span></span>
                            </div>
                        }
                    }
                    else if (pie is null || pie.Actividades.Count == 0)
                    {
                        <span class="av-ficha-vacio">—</span>
                    }
                    else
                    {
                        @foreach (var a in pie.Actividades)
                        {
                            <div class="av-ficha-fila @(a.Pct is null ? "av-na" : "")" title="@($"{a.Nombre} · {a.Aplican} de {a.Total} aplican")">
                                <span class="av-ficha-fila-nom">@a.Nombre</span><b>@(a.Pct is null ? "N/A" : FormatoPct(a.Pct))</b>
                                <span class="av-ficha-barra"><span style="width:@Pct0(a.Pct ?? 0)%;@EstiloPct(a.Pct)"></span></span>
                            </div>
                        }
                    }
                </div>
                <div class="av-ficha-pie">
                    <span class="av-ficha-meta" title="@((t.Lat != 0 || t.Lon != 0) ? $"{t.Lat.ToString("0.00000", CultureInfo.InvariantCulture)}, {t.Lon.ToString("0.00000", CultureInfo.InvariantCulture)}" : "")">@(t.ModeloCodigo is null ? "Paramétrica" : "Modelo " + t.ModeloCodigo) · @Fecha(dia)</span>
                    @if (cerrar is not null)
                    {
                        <button type="button" class="av3d-btn" title="Torre por torre (visor 3D)" @onclick="() => TorrePorTorre(t)"><Ico Nombre="torre" /></button>
