    private void IrATorre(ChangeEventArgs e)
    {
        var txt = e.Value?.ToString()?.Trim() ?? "";
        irA = "";
        if (txt.Length == 0 || s is null) return;
        var t = s.Torres.FirstOrDefault(x => string.Equals(x.Nombre, txt, StringComparison.OrdinalIgnoreCase))
            ?? s.Torres.FirstOrDefault(x => x.Nombre.Contains(txt, StringComparison.OrdinalIgnoreCase));
        if (t is null) { irA = txt; return; }
        if (!TorresMostradas().Any(x => x.Id == t.Id)) buscar = "";
        torreFoco = t.Id; idxT = null; Parar();
    }

    private async Task AlternarTransparente() { transparente = !transparente; await Llamar("transparente", transparente); }
    private async Task AlternarGiro() { girando = !girando; await Llamar("girar", girando); }

    private void Pausar()
    {
        reproduciendo = false;
        ctsPlay?.Cancel(); ctsPlay = null;
    }

    private void Parar() { Pausar(); bucleActividad = null; }

    private async Task AlternarPlay(TorreAvance t)
    {
        if (reproduciendo) { Pausar(); return; }
        var fechas = FechasTorre(t);
        var bucle = bucleActividad;
        if (fechas.Count == 0 || (fechas.Count < 2 && bucle is null)) return;
        var primero = bucle is null ? 0 : fechas.IndexOf(bucle.Inicio);
        var ultimo = bucle is null ? fechas.Count - 1 : fechas.IndexOf(bucle.Fin);
        if (primero < 0 || ultimo < primero) { Parar(); return; }
        var i = Math.Clamp(idxT ?? ultimo, primero, ultimo);
        if (bucle is null && i == ultimo) i = primero;
        idxT = i;
        reproduciendo = true;
        using var cts = new CancellationTokenSource();
        ctsPlay = cts;
        try
        {
            StateHasChanged();
            while (!cts.IsCancellationRequested)
            {
                await Task.Delay(500, cts.Token);
                if (Foco()?.Id != t.Id || vista != "torre") { Parar(); break; }
                if (i == ultimo && bucle is null) break;
                i = i >= ultimo ? primero : i + 1;
                idxT = i;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
        finally
        {
            if (ctsPlay == cts) { reproduciendo = false; ctsPlay = null; StateHasChanged(); }
        }
    }

    // Datos en memoria, sin consultas durante el render. Fin inclusivo; las actividades
    // incompletas se muestran hasta el último registro disponible al corte (nunca hasta hoy).
    private (DateTime Inicio, DateTime Fin)? LapsoActividad(TorreAvance t, ActividadObra a, PataAvance? p = null)
    {
        var regs = s!.RegistrosDe(t, a, p).Where(r => r.Fecha.Date <= corte.Date).ToList();
        if (regs.Count == 0) return null;
        var pct = p is null ? s.PctActividad(t, a, corte) : s.PctPata(t, p, a, corte);
        if (pct is null) return null;
        var fin = pct >= 100 ? regs.LastOrDefault(r => r.AvanceAcumulado >= 100) ?? regs[^1] : regs[^1];
        return (regs[0].Fecha.Date, fin.Fecha.Date);
    }

    private record Trabajo3D(string Tipo, string? Pata, bool Elegida = false);
    private List<Trabajo3D> TrabajosEn(TorreAvance t, DateTime dia)
    {
        var trabajos = new List<Trabajo3D>();
        // La seleccionada tiene prioridad si coinciden tareas en una misma pata.
        foreach (var a in s!.Actividades.OrderByDescending(a => resTorre == t.Id && resAct == a.Id))
        {
            string Tipo() => a.Nombre.Contains("parrilla", StringComparison.OrdinalIgnoreCase) ? "parrilla" : a.Efecto switch
            {
                EfectoAvance3D.Excavacion => "exc", EfectoAvance3D.Solado => "sol",
                EfectoAvance3D.Nivelacion => "niv", EfectoAvance3D.Acero => "ace",
                EfectoAvance3D.Concreto => "con", EfectoAvance3D.Relleno => "rel",
                EfectoAvance3D.Montaje => "mon", _ => "otro"
            };
            bool Activa(PataAvance? p) => LapsoActividad(t, a, p) is { } l && dia.Date >= l.Inicio && dia.Date <= l.Fin
                && (p is null ? s.PctActividad(t, a, dia) : s.PctPata(t, p, a, dia)) is not null;
            // Prearmado: cuadrilla alistando la estructura en el piso (escena propia del visor, no la del montaje).
            if (a.Efecto == EfectoAvance3D.Prearmado)
            {
                if (Activa(null)) trabajos.Add(new("pre", null, resTorre == t.Id && resAct == a.Id));
                continue;
            }
            if (a.Efecto == EfectoAvance3D.Montaje)
            {
                if (Activa(null)) trabajos.Add(new("mon", null));
                continue;
            }
            if (a.Ambito == AmbitoAvance.Pata && t.Patas.Count > 0)
            {
                foreach (var p in t.Patas.Where(p => Activa(p)))
                    if (!trabajos.Any(x => x.Pata == p.Letra)) trabajos.Add(new(Tipo(), p.Letra));
            }
            else if (Activa(null))
                foreach (var letra in a.Ambito == AmbitoAvance.Pata ? new[] { "A", "B", "C", "D" } : new[] { "A" })
                    if (!trabajos.Any(x => x.Pata == letra)) trabajos.Add(new(Tipo(), letra));
        }
        return trabajos;
    }

    // ----- Edición en Torre por torre -----
    // Clic en una actividad = su editor: % acumulado al cierre del día elegido (torre o cada pata; vacío = el registro de
    // ese día a la Papelera; N/A = no aplica) y fechas de inicio y fin (misma regla que la matriz, mxCambios).
    private bool editTo;
    private int? actSelTo;
    private DateTime? diaTo;
    private readonly Dictionary<(int T, int C, int A), string> toCambios = new();

    private void EditarTorre() { Parar(); toCambios.Clear(); mxCambios.Clear(); confirmarMx = false; error = null; actSelTo = null; diaTo = null; if (Foco() is { } tf) diaTo = DiaTo(HastaDe(tf, FechasTorre(tf))); editTo = true; }
    private void CancelarTorre() { toCambios.Clear(); if (editTo) mxCambios.Clear(); confirmarMx = false; editTo = false; actSelTo = null; }
    private DateTime DiaTo(DateTime hasta) => (diaTo ?? (hasta > DateTime.Today ? DateTime.Today : hasta)).Date;
    private void CambiarDiaTo(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var f)) diaTo = f.Date;
    }
    private bool TieneCambiosTo(TorreAvance t, ActividadObra a) =>
        toCambios.Keys.Any(k => k.T == t.Id && k.A == a.Id) || mxCambios.Keys.Any(k => k.T == t.Id && k.A == a.Id);

    private RenderFragment EditorActividadTo(TorreAvance t, ActividadObra a, DateTime dia) => __builder =>
    {
        // Filas: la torre, o cada pata en actividades por pata (con patas).
        var filas = a.Ambito == AmbitoAvance.Pata && t.Patas.Count > 0
            ? t.Patas.Select(p => ((PataAvance?)p, "Pata " + p.Letra)).ToList()
            : new List<(PataAvance?, string)> { (null, "Torre") };
        <div class="av-to-ed" @onclick:stopPropagation="true">
            <div class="av-to-fila av-to-tit"><span></span><span>% al @dia.ToString("dd/MM")</span><span>Inicio</span><span>Fin</span></div>
            @foreach (var (p, nom) in filas)
            {
                var comp = p?.ComponenteId ?? 0;
                var k = (t.Id, comp, a.Id);
                var reg = s!.RegistroDelDia(t, comp, a, dia);
                var actual = p is null ? s.PctActividad(t, a, dia) : s.PctPata(t, p, a, dia);
                var valor = toCambios.TryGetValue(k, out var c) ? c : reg is null ? "" : reg.NoAplica ? "N/A" : reg.AvanceAcumulado.ToString("0.##", CultureInfo.InvariantCulture);
                var (ini, fin) = s.InicioFin(t, a, p);
                <div class="av-to-fila">
                    <span class="av-to-nom">@nom</span>
                    <input class="form-control form-control-sm av-to-pct @(toCambios.ContainsKey(k) ? "av-mx-in cambiado" : "")" value="@valor"
                           placeholder="@(actual is decimal x ? x.ToString("0.#", CultureInfo.InvariantCulture) : "N/A")"
                           title="% acumulado al cierre del día (vacío = sin registro ese día; N/A = no aplica)"
                           @onchange="e => CambiarPctTo(k, valor, e)" />
                    @CeldaFecha(t, a, p, false, ini, true)
                    @CeldaFecha(t, a, p, true, fin, true)
                </div>
            }
        </div>
    };

    private void CambiarPctTo((int, int, int) k, string original, ChangeEventArgs e)
    {
        var v = e.Value?.ToString()?.Trim() ?? "";
        if (v == original) toCambios.Remove(k); else toCambios[k] = v;
    }

    private async Task GuardarTorre()
    {
        if (s is null || guardando) return;
        error = null;
        // % del día: se valida todo antes de escribir.
        var dia = DiaTo(Foco() is { } tf ? HastaDe(tf, FechasTorre(tf)) : DateTime.Today);
        var pct = new List<(int Torre, int? Comp, ActividadObra A, decimal? V, bool Na)>();
        foreach (var ((tid, comp, actId), txt) in toCambios)
        {
            if (Act(actId) is not { } a) continue;
            var nombre = $"{Torre(tid)?.Nombre} · {a.Nombre}";
            if (s.EsDeCantidades(tid, actId)) { error = $"{nombre}: el avance sale de las cantidades (Costos y presupuestos › Avance diario); edítelo allá."; return; }
            var x = txt.Trim();
            if (x.Length == 0) { pct.Add((tid, comp == 0 ? null : comp, a, null, false)); continue; }
            if (string.Equals(x, "N/A", StringComparison.OrdinalIgnoreCase) || string.Equals(x, "NA", StringComparison.OrdinalIgnoreCase)) { pct.Add((tid, comp == 0 ? null : comp, a, 0, true)); continue; }
            if (!decimal.TryParse(x.Replace(',', '.').TrimEnd('%', ' '), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) || v < 0 || v > 100)
            { error = $"{nombre}: escribe un % entre 0 y 100 (o N/A)."; return; }
            pct.Add((tid, comp == 0 ? null : comp, a, Math.Round(v, 2), false));
        }
        if (pct.Count == 0 && mxCambios.Count == 0) { CancelarTorre(); return; }
        guardando = true;
        try
        {
            var nFechas = 0;
            if (mxCambios.Count > 0)
            {
                if (await AplicarFechasAsync() is not int n) return;   // errores o confirmación de la Papelera pendiente
                nFechas = n; mxCambios.Clear();
            }
            if (pct.Count > 0)
            {
                InformeDiario? inf0 = null;
                if (pct.Any(c => c.V is not null))
                {
                    inf0 = Db.InformesDiarios.Where(i => i.Fecha.Date == dia).OrderBy(i => i.Id).FirstOrDefault();
                    if (inf0 is null) { inf0 = new InformeDiario { Fecha = dia, Observaciones = "Creado al editar el avance en Torre por torre." }; Db.InformesDiarios.Add(inf0); await Db.SaveChangesAsync(); }
                }
                var ahora = DateTime.Now;
                foreach (var (tid, comp, a, v, na) in pct)
                {
                    var r = Db.RegistrosAvance.Where(x => x.ElementoTrazadoId == tid && x.ComponenteId == comp && x.ActividadObraId == a.Id && x.Fecha.Date == dia)
                        .OrderByDescending(x => x.Id).FirstOrDefault();
                    if (v is null) { if (r is not null) { r.Eliminado = true; r.FechaEliminacion = ahora; } continue; }   // → Papelera
                    if (r is null)
                    {
                        r = new RegistroAvance { InformeDiarioId = inf0!.Id, Fecha = dia, ElementoTrazadoId = tid, ComponenteId = comp, ActividadObraId = a.Id, Observaciones = "Editado en Torre por torre." };
                        Db.RegistrosAvance.Add(r);
                    }
                    r.AvanceAcumulado = na ? 0 : v.Value; r.NoAplica = na;
                }
                await Db.SaveChangesAsync();
                Db.ChangeTracker.Clear();
            }
            CancelarTorre();
            Cargar(); visorTorre = null; idxT = null;
            aviso = string.Join(" · ", new[] { pct.Count > 0 ? $"{pct.Count} avance(s) al {dia:dd/MM/yyyy}" : null, nFechas > 0 ? $"{nFechas} fecha(s)" : null }.Where(x => x is not null)) + " guardado(s).";
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo guardar: " + (ex.InnerException?.Message ?? ex.Message); }
        finally { guardando = false; }
    }

