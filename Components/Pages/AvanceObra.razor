    // ================= Torre por torre =================
    private int? torreFoco;
    private int? idxT;                 // posición en la línea de tiempo de la torre (null = la fecha de corte)
    private bool transparente, girando, reproduciendo;
    private CancellationTokenSource? ctsPlay;
    private record BucleActividad(int Torre, int Actividad, DateTime Inicio, DateTime Fin);
    private BucleActividad? bucleActividad;

    private void EnfocarTorre(TorreAvance t) { Parar(); torreFoco = t.Id; idxT = null; vista = "torre"; }

    private TorreAvance? Foco()
    {
        var l = TorresMostradas();
        return l.FirstOrDefault(t => t.Id == torreFoco) ?? l.FirstOrDefault();
    }

    // Fechas de la línea de tiempo de la torre (las de sus registros hasta la fecha de corte).
    private List<DateTime> FechasTorre(TorreAvance t)
    {
        var l = s!.FechasDe(t).Where(d => d <= corte).ToList();
        // El cursor recorre días calendario, también cuando no hay un nuevo registro.
        return l.Count == 0 ? l : Enumerable.Range(0, (l[^1] - l[0]).Days + 1).Select(i => l[0].AddDays(i)).ToList();
    }

    private DateTime HastaDe(TorreAvance t, List<DateTime> fechas)
    {
        if (fechas.Count == 0) return corte;
        var i = Math.Clamp(idxT ?? fechas.Count - 1, 0, fechas.Count - 1);
        return idxT is null ? corte : fechas[i];
    }

    private DateTime PreviaDe(List<DateTime> fechas, DateTime hasta)
    {
        var ant = fechas.Where(d => d < hasta.Date).ToList();
        return ant.Count > 0 ? ant[^1] : hasta.Date.AddDays(-1);
    }

    private void IrA(TorreAvance t, int pos) { torreFoco = t.Id; idxT = pos; }

    // ---------- Línea de tiempo (Torre por torre y Tendido; normal y pantalla completa) ----------
    // Riel con una marca por día con registros, escala de fechas debajo y burbuja con la fecha sobre el cursor
    // (se mueve también al reproducir). Pos = 0 a 1 a lo largo del riel.
    private record MarcaTl(double Pos, string Texto);
    private static string PosCss(double p) => (Math.Clamp(p, 0, 1) * 100).ToString("0.###", CultureInfo.InvariantCulture);

    private RenderFragment LineaTiempo(bool pc, DateTime actual, int valor, int max, IEnumerable<double> marcas, IEnumerable<MarcaTl> escala,
        bool jugando, bool puedeJugar, Func<Task> play, Action<int> ir, string? extra = null, Action? interrumpir = null) => __builder =>
    {
        var pos = max <= 0 ? 1.0 : (double)valor / max;
        <div class="av-tl @(pc ? "av-tl-pc" : "")" style="--p:@Math.Clamp(pos, 0, 1).ToString("0.####", CultureInfo.InvariantCulture)">
            <button type="button" class="av-play @(jugando ? "activo" : "")" title="@(jugando ? "Pausar" : "Reproducir el avance")" disabled="@(!puedeJugar)" @onclick="play">
                @if (jugando)
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
                }
                else
                {
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8-14 8z"/></svg>
                }
            </button>
            <div class="av-tl-pista" @onpointerdown="() => interrumpir?.Invoke()" @onkeydown="() => interrumpir?.Invoke()">
                <div class="av-tl-riel">
                    <span class="av-tl-hecho"></span>
                    @foreach (var m in marcas) { <i style="left:@PosCss(m)%"></i> }
                </div>
                <input type="range" min="0" max="@Math.Max(0, max)" step="1" value="@valor" aria-label="Fecha" disabled="@(max <= 0)"
                       @oninput="e => { if (int.TryParse(e.Value?.ToString(), out var i)) ir(i); }" />
                <span class="av-tl-burbuja">@Fecha(actual)</span>
                <div class="av-tl-escala">
                    @foreach (var et in escala) { <span style="left:@PosCss(et.Pos)%" class="@(et.Pos <= 0 ? "ini" : et.Pos >= 1 ? "fin" : "")">@et.Texto</span> }
                </div>
            </div>
            @if (extra is not null) { <span class="av-tl-n" title="Días calendario">@extra</span> }
        </div>
    };

    // Torre por torre: el cursor recorre los días con registros (posiciones iguales); escala con hasta 5 de esas fechas.
    private string? EtiquetaBucle() => bucleActividad is { } b
        ? $"↻ {s?.Actividades.FirstOrDefault(a => a.Id == b.Actividad)?.Nombre} · {b.Inicio:dd/MM}–{b.Fin:dd/MM}" : null;

    private IEnumerable<double> MarcasTorre(TorreAvance t, List<DateTime> fechas) => fechas.Count <= 1
        ? new[] { 1.0 } : s!.FechasDe(t).Where(d => d <= corte).Select(d => (d - fechas[0]).TotalDays / (fechas.Count - 1));

    private static IEnumerable<double> MarcasIndice(int n) => n <= 1 ? new[] { 1.0 } : Enumerable.Range(0, n).Select(i => (double)i / (n - 1));
    private static IEnumerable<MarcaTl> EscalaIndice(List<DateTime> fechas)
    {
        if (fechas.Count == 0) yield break;
        if (fechas.Count == 1) { yield return new(1, fechas[0].ToString("dd/MM/yy", Es)); yield break; }
        var n = Math.Min(5, fechas.Count);
        foreach (var k in Enumerable.Range(0, n).Select(j => (int)Math.Round(j * (fechas.Count - 1) / (double)(n - 1))).Distinct())
            yield return new((double)k / (fechas.Count - 1), fechas[k].ToString("dd/MM/yy", Es));
    }
    // Tendido: el cursor recorre días calendario; escala = extremos y meses intermedios.
    private static IEnumerable<MarcaTl> EscalaDias(DateTime ini, DateTime fin)
    {
        var dias = Math.Max(1, (fin - ini).TotalDays);
        yield return new(0, ini.ToString("dd/MM/yy", Es));
        var meses = (fin.Year - ini.Year) * 12 + fin.Month - ini.Month;
        var paso = Math.Max(1, (int)Math.Ceiling(meses / 5.0));
        for (var m = new DateTime(ini.Year, ini.Month, 1).AddMonths(1); m < fin; m = m.AddMonths(paso))
        {
            var p = (m - ini).TotalDays / dias;
            if (p > .1 && p < .9) yield return new(p, m.ToString("MMM yy", Es));
        }
        yield return new(1, fin.ToString("dd/MM/yy", Es));
    }

