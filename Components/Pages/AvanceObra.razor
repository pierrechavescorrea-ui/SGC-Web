            <div class="av-grupos">
                @foreach (var g in actsEdit.GroupBy(a => a.Grupo).ToList())
                {
                    <div class="av-grupo">
                        @{ var activas = g.Count(a => a.Activo); var grupo = g.ToList(); }
                        <div class="av-grupo-cab">
                            <label class="av-grupo-chk" title="@(activas == grupo.Count ? "Desactivar todo el grupo (no se ve en el mapa ni cuenta en el %)" : "Activar todo el grupo")">
