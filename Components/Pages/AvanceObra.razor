    private void IrDiaTd(int k) { PararTd(); diaTd = RangoTd().Ini.AddDays(k); }
    private async Task AlternarFamiliaTd(string f)
    {
        if (!famOffTd.Remove(f)) famOffTd.Add(f);
        await LlamarTd("familias", famOffTd.ToList());
    }
    private void PararTd() { jugandoTd = false; ctsTd?.Cancel(); ctsTd = null; }
    private async Task AlternarPlayTd()
    {
        if (jugandoTd) { PararTd(); return; }
        var (ini, fin) = RangoTd();
        if (DiaTd() >= fin) diaTd = ini;
        jugandoTd = true;
        var cts = ctsTd = new CancellationTokenSource();
        try
        {
            while (!cts.IsCancellationRequested && DiaTd() < fin)
            {
                await Task.Delay(260, cts.Token);
                diaTd = DiaTd().AddDays(1);
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
        if (ctsTd == cts) { jugandoTd = false; ctsTd = null; StateHasChanged(); }
    }

    private void EditarTendido() { if (tiroSel is null) return; PararTd(); tdCambios.Clear(); error = null; editTd = true; }
    private void CancelarTendido() { tdCambios.Clear(); editTd = false; }

    // Guarda el % de cada actividad cambiada como registro del día mostrado (vacío = el registro de ese día a la Papelera).
    private async Task GuardarTendido()
    {
        if (s is null || guardando || tiroSel is not int tid || s.Tiros.FirstOrDefault(t => t.Id == tid) is not { } tiro) return;
        error = null;
        var dia = DiaTd();
        var cambios = new List<(ActividadObra A, decimal? V, bool Na)>();
        foreach (var ((_, actId), txt) in tdCambios.Where(x => x.Key.Tiro == tid))
        {
            if (s.ActividadesTiro.FirstOrDefault(a => a.Id == actId) is not { } a) continue;
            var t = txt.Trim();
            if (t.Length == 0) { cambios.Add((a, null, false)); continue; }
            if (string.Equals(t, "N/A", StringComparison.OrdinalIgnoreCase) || string.Equals(t, "NA", StringComparison.OrdinalIgnoreCase)) { cambios.Add((a, 0, true)); continue; }
            if (!decimal.TryParse(t.Replace(',', '.').TrimEnd('%', ' '), NumberStyles.Float, CultureInfo.InvariantCulture, out var v) || v < 0 || v > 100)
            { error = $"{a.Nombre}: escribe un % entre 0 y 100 (o N/A)."; return; }
            cambios.Add((a, Math.Round(v, 2), false));
        }
        guardando = true;
        try
        {
            InformeDiario? inf0 = null;
            if (cambios.Any(c => c.V is not null))
            {
                inf0 = Db.InformesDiarios.Where(i => i.Fecha.Date == dia).OrderBy(i => i.Id).FirstOrDefault();
                if (inf0 is null) { inf0 = new InformeDiario { Fecha = dia }; Db.InformesDiarios.Add(inf0); await Db.SaveChangesAsync(); }
            }
            var ahora = DateTime.Now;
            foreach (var (a, v, na) in cambios)
            {
                var r = Db.RegistrosAvanceTiro.Where(x => x.TiroId == tid && x.ActividadObraId == a.Id && x.Fecha.Date == dia).OrderByDescending(x => x.Id).FirstOrDefault();
                if (v is null) { if (r is not null) { r.Eliminado = true; r.FechaEliminacion = ahora; } continue; }   // → Papelera
                if (r is null) { r = new RegistroAvanceTiro { InformeDiarioId = inf0!.Id, Fecha = dia, TiroId = tid, ActividadObraId = a.Id }; Db.RegistrosAvanceTiro.Add(r); }
                r.AvanceAcumulado = na ? 0 : v.Value; r.NoAplica = na;
            }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            var n = cambios.Count;
            CancelarTendido();
            Cargar();
            aviso = $"{n} avance(s) de {tiro.Nombre} guardado(s) al {dia:dd/MM/yyyy}.";
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo guardar: " + (ex.InnerException?.Message ?? ex.Message); }
        finally { guardando = false; }
    }

