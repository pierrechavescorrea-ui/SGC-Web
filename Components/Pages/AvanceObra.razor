    // ================= Ajustes: actividades, pesos y cotas =================
    private List<ActividadObra> actsEdit = new();
    private ConfigCotasAvance cotasEdit = new();
    private string? claveTipoAlAbrirAjustes, claveCuerpoAlAbrirAjustes;
    private Dictionary<int, int> regsPorAct = new();
    private int? actElim;
    private string nuevaAct = "", nuevoGrupo = "";
    private AmbitoAvance nuevoAmbito = AmbitoAvance.Pata;

    private void PrepararAjustes()
    {
        actsEdit = Db.ActividadesObra.AsNoTracking().OrderBy(a => a.Orden).ThenBy(a => a.Id).ToList();
        cotasEdit = ConfigCotasAvance.Leer(Db.Configuracion.AsNoTracking().Select(c => c.AvanceObraCotas).FirstOrDefault());
        claveTipoAlAbrirAjustes = cotasEdit.ClaveTipoTorre;
        claveCuerpoAlAbrirAjustes = cotasEdit.ClaveCuerpoTorre;
        regsPorAct = Db.RegistrosAvance.AsNoTracking().GroupBy(r => r.ActividadObraId).Select(g => new { g.Key, N = g.Count() }).ToDictionary(x => x.Key, x => x.N);
        foreach (var x in Db.RegistrosAvanceTiro.AsNoTracking().GroupBy(r => r.ActividadObraId).Select(g => new { g.Key, N = g.Count() }).ToList())
            regsPorAct[x.Key] = (regsPorAct.TryGetValue(x.Key, out var k) ? k : 0) + x.N;
        actElim = null;
    }

    private void AgregarActividad()
    {
        if (string.IsNullOrWhiteSpace(nuevaAct)) return;
        var grupo = string.IsNullOrWhiteSpace(nuevoGrupo) ? "Otras" : nuevoGrupo.Trim();
        actsEdit.Add(new ActividadObra { Nombre = nuevaAct.Trim(), Grupo = grupo, Ambito = nuevoAmbito, Orden = (actsEdit.Count == 0 ? 0 : actsEdit.Max(a => a.Orden)) + 1 });
        nuevaAct = "";
    }

    private async Task GuardarAjustes()
    {
        if (guardando) return;
        error = null; guardando = true;
        try
        {
            if (actsEdit.Any(a => string.IsNullOrWhiteSpace(a.Nombre))) { error = "Toda actividad necesita nombre."; return; }
            if (actsEdit.Any(a => a.Peso < 0 || a.Peso > 1)) { error = "El peso va de 0 % a 100 %."; return; }
            await using var tx = await Db.Database.BeginTransactionAsync(System.Data.IsolationLevel.Serializable);
            var cfg = await Db.Configuracion.FirstOrDefaultAsync();
            if (cfg is not null) await Db.Entry(cfg).ReloadAsync();
            var marcasActuales = ConfigCotasAvance.Leer(cfg?.AvanceObraCotas);
            var tipo = MismaColumna(cotasEdit.ClaveTipoTorre, claveTipoAlAbrirAjustes)
                ? marcasActuales.ClaveTipoTorre : NormalizarMarca(cotasEdit.ClaveTipoTorre);
            var cuerpo = MismaColumna(cotasEdit.ClaveCuerpoTorre, claveCuerpoAlAbrirAjustes)
                ? marcasActuales.ClaveCuerpoTorre : NormalizarMarca(cotasEdit.ClaveCuerpoTorre);
            if (tipo is not null && MismaColumna(tipo, cuerpo))
            {
                error = "El tipo y el cuerpo deben usar columnas distintas. Revise las marcas en Tabla de torres › Campos.";
                return;
            }
            var ids = actsEdit.Where(a => a.Id > 0).Select(a => a.Id).ToList();
            var bd = Db.ActividadesObra.Where(a => ids.Contains(a.Id)).ToDictionary(a => a.Id);
            foreach (var a in actsEdit)
            {
                var e = a.Id > 0 && bd.TryGetValue(a.Id, out var x) ? x : null;
                if (e is null) { e = new ActividadObra(); Db.ActividadesObra.Add(e); }
                e.Nombre = a.Nombre.Trim(); e.Grupo = (a.Grupo ?? "").Trim(); e.Ambito = a.Ambito; e.Peso = a.Peso; e.Unidad = a.Unidad;
                e.ItemContrato = a.ItemContrato; e.Efecto = a.Efecto; e.Orden = a.Orden; e.Activo = a.Activo;
            }
            if (cfg is null) { cfg = new ConfiguracionEmpresa { Id = 1 }; Db.Configuracion.Add(cfg); }
            cotasEdit.ClaveTipoTorre = tipo;
            cotasEdit.ClaveCuerpoTorre = cuerpo;
            cfg.AvanceObraCotas = cotasEdit.Escribir();
            await Db.SaveChangesAsync();
            await tx.CommitAsync();
            Db.ChangeTracker.Clear();
            Cargar();
            visorTorre = null;
            vista = vistaAntesFormulario;
            aviso = "Ajustes guardados.";
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo guardar: " + (ex.InnerException?.Message ?? ex.Message); }
        finally { guardando = false; }
    }

    private static string? NormalizarMarca(string? clave) => string.IsNullOrWhiteSpace(clave) ? null : clave;

    private static bool MismaColumna(string? a, string? b) =>
        string.Equals(NormalizarMarca(a), NormalizarMarca(b), StringComparison.OrdinalIgnoreCase);

    private void EliminarActividad(ActividadObra a)
    {
        if (a.Id == 0) { actsEdit.Remove(a); actElim = null; return; }
        try
        {
            var ahora = DateTime.Now;
            var e = Db.ActividadesObra.First(x => x.Id == a.Id);
            e.Eliminado = true; e.FechaEliminacion = ahora;
            foreach (var r in Db.RegistrosAvance.Where(r => r.ActividadObraId == a.Id)) { r.Eliminado = true; r.FechaEliminacion = ahora; }
            foreach (var r in Db.RegistrosAvanceTiro.Where(r => r.ActividadObraId == a.Id)) { r.Eliminado = true; r.FechaEliminacion = ahora; }
            Db.SaveChanges();
            Db.ChangeTracker.Clear();
            actsEdit.Remove(a); actElim = null;
            aviso = $"«{a.Nombre}» enviada a la Papelera.";
            s = ServicioAvanceObra.Cargar(Db, Env.WebRootPath);
            CargarInformes();
        }
        catch (Exception ex) { Db.ChangeTracker.Clear(); error = "No se pudo eliminar: " + ex.Message; }
    }

    private static string NombreEfecto(EfectoAvance3D e) => e switch
    {
        EfectoAvance3D.Ninguno => "Solo en el %",
        EfectoAvance3D.Excavacion => "Excavación",
        EfectoAvance3D.Solado => "Solado",
        EfectoAvance3D.Nivelacion => "Stub / parrilla",
        EfectoAvance3D.Acero => "Acero",
        EfectoAvance3D.Concreto => "Concreto",
        EfectoAvance3D.Relleno => "Relleno",
        EfectoAvance3D.Prearmado => "Prearmado",
        EfectoAvance3D.Montaje => "Montaje (piezas)",
        EfectoAvance3D.Verticalidad => "Verticalidad",
        EfectoAvance3D.Vestida => "Vestida (aisladores)",
        EfectoAvance3D.Poleas => "Poleas",
        EfectoAvance3D.CableGuia => "Cable guía",
        EfectoAvance3D.Guarda => "Cable de guarda",
        EfectoAvance3D.Opgw => "OPGW",
        EfectoAvance3D.Conductor => "Conductor",
        EfectoAvance3D.Flechado => "Flechado",
        EfectoAvance3D.Engrapado => "Engrapado",
        EfectoAvance3D.Separadores => "Separadores",
        _ => e.ToString()
    };

