                                var reg = s.RegistroTiroDelDia(tr, a, dia);
                                var valor = tdCambios.TryGetValue(k, out var c) ? c : reg is null ? "" : reg.NoAplica ? "N/A" : reg.AvanceAcumulado.ToString("0.##", CultureInfo.InvariantCulture);
                                <label class="av-td-in" title="% acumulado al cierre del día (vacío = sin registro ese día; N/A = no aplica)">
