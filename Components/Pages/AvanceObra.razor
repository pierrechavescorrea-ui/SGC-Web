@page "/avance-obra"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.AvanceObra
@using SigWeb.Models
@inject AppDbContext Db
@inject IWebHostEnvironment Env
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IServiceScopeFactory Scopes

<PageTitle>Avance de obra</PageTitle>

<EncabezadoPagina Titulo="Avance de obra" Icono="avance-obra" OnAtras="Atras">
    <Acciones>
        <span class="pg-kpi" title="Avance ponderado del proyecto a la fecha de corte">@FormatoPct(s?.PctProyecto(corte))</span>
        @* Vistas: un solo bloque. «Línea» agrupa el tendido 3D y la planta-perfil (se alterna con el botón de al lado). *@
        <span class="pg-vistas">
            <button type="button" class="pg-btn @(vista == "mapa" ? "activo" : "")" title="Mapa de calor (torres × actividades)" @onclick='() => VerVista("mapa")'><Ico Nombre="tablero" /></button>
            <button type="button" class="pg-btn @(vista == "torre" ? "activo" : "")" title="Torre por torre (visor 3D)" @onclick='() => VerVista("torre")'><Ico Nombre="torre" /></button>
            <button type="button" class="pg-btn @(vista is "tendido" or "perfil" ? "activo" : "")" title="Línea: tendido 3D por tiros y planta-perfil" @onclick='() => { if (vista is not ("tendido" or "perfil")) VerVista("tendido"); }'><Ico Nombre="tiro" /></button>
            <button type="button" class="pg-btn @(vista == "matriz" ? "activo" : "")" title="Avance acumulado (matriz)" @onclick='() => VerVista("matriz")'><Ico Nombre="listado" /></button>
            <button type="button" class="pg-btn @(vista == "estado" ? "activo" : "")" title="Estado de las torres (por tiro; clic en una torre = avance físico y PIE)" @onclick='() => VerVista("estado")'><Ico Nombre="estado-torres" /></button>
        </span>
        @if (vista == "torre" && Foco() is { } tSalto)
        {
            <span class="pg-sep"></span>
            <SaltoTorre ElementoId="tSalto.Id" Actual="avance" />
        }
        @if (vista is "tendido" or "perfil")
        {
            <button type="button" class="pg-btn" title="@(vista == "tendido" ? "Ver en planta-perfil" : "Ver en 3D")" @onclick="AlternarLinea"><Ico Nombre="@(vista == "tendido" ? "perfil" : "tiro")" /></button>
        }
        <span class="pg-sep"></span>
        <BotonBaseDatos Activo='vista == "informe"' Cantidad="informes.Count" Detalle="@($"{informes.Count} informe(s) diario(s) (F-054 importados o hechos a mano)")" OnClick='() => VerVista("informe")' />
        <button type="button" class="pg-btn @(vista == "ajustes" ? "activo" : "")" title="Actividades, pesos y cotas" @onclick='() => VerVista("ajustes")'><Ico Nombre="catalogos" /></button>
        <span class="pg-sep"></span>
        <button type="button" class="pg-btn @(verImportar ? "activo" : "")" title="Importar avance acumulado (Excel)" @onclick="() => { verImportar = !verImportar; }"><Ico Nombre="cargar-excel" /></button>
        @if (vista is "mapa" or "matriz")
        {
            <BotonExportar Titulo="Avance de obra" Selector="@(vista == "mapa" ? "table.pm-mapa" : "table.av-matriz")" />
        }
        <span class="pg-sep"></span>
        @if (vista == "tendido" && editTd)
        {
            <button type="button" class="pg-btn" title="Cancelar edición" @onclick="CancelarTendido"><Ico Nombre="cancelar" /></button>
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar avance del día" disabled="@guardando" @onclick="GuardarTendido"><Ico Nombre="guardar" /></button>
        }
        else if (vista == "torre" && editTo)
        {
            <button type="button" class="pg-btn" title="Cancelar edición" @onclick="CancelarTorre"><Ico Nombre="cancelar" /></button>
            <AvisoCambios Pendientes="toCambios.Count + mxCambios.Count" />
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar avances y fechas" disabled="@guardando" @onclick="GuardarTorre"><Ico Nombre="guardar" />@(toCambios.Count + mxCambios.Count > 0 ? $" {toCambios.Count + mxCambios.Count}" : "")</button>
        }
        else if (vista == "estado" && vEstado is { Editando: true } ve)
        {
            <button type="button" class="pg-btn" title="Cancelar edición" @onclick="ve.Cancelar"><Ico Nombre="cancelar" /></button>
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar estados" disabled="@ve.Guardando" @onclick="ve.GuardarAsync"><Ico Nombre="guardar" /></button>
        }
        else if (vista == "matriz" && editMx)
        {
            <button type="button" class="pg-btn" title="Cancelar edición" @onclick="CancelarMatriz"><Ico Nombre="cancelar" /></button>
            <AvisoCambios Pendientes="mxCambios.Count" />
            <button type="button" class="pg-btn pg-btn-primario" title="Guardar fechas" disabled="@guardando" @onclick="GuardarMatriz"><Ico Nombre="guardar" />@(mxCambios.Count > 0 ? $" {mxCambios.Count}" : "")</button>
        }
        else
        {
            @if (vista == "matriz")
            {
                <button type="button" class="pg-btn" title="Editar fechas" @onclick="EditarMatriz"><Ico Nombre="editar" /></button>
            }
            @if (vista == "torre")
            {
                <button type="button" class="pg-btn" title="Editar avances y fechas de la torre" disabled="@(Foco() is null)" @onclick="EditarTorre"><Ico Nombre="editar" /></button>
            }
            @if (vista == "estado")
            {
                <button type="button" class="pg-btn" title="Editar estados de las torres" disabled="@(vEstado is null)" @onclick="EditarEstado"><Ico Nombre="editar" /></button>
            }
            @if (vista == "tendido")
            {
                <button type="button" class="pg-btn" title="Editar avance del tiro a la fecha mostrada" disabled="@(tiroSel is null)" @onclick="EditarTendido"><Ico Nombre="editar" /></button>
            }
            <button type="button" class="pg-btn pg-btn-primario" title="Nuevo informe del día" @onclick="() => AbrirInforme(DateTime.Today)"><Ico Nombre="agregar" /></button>
        }
    </Acciones>
</EncabezadoPagina>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-warning py-1 small">@error <button type="button" class="btn-close btn-sm float-end" @onclick="() => error = null"></button></div>
}
@if (!string.IsNullOrEmpty(aviso))
{
    <div class="alert alert-success py-1 small">@aviso <button type="button" class="btn-close btn-sm float-end" @onclick="() => aviso = null"></button></div>
}

@if (confirmarMx)
{
    <div class="alert alert-warning py-1 small d-flex align-items-center gap-2">
        <span class="flex-grow-1">@mxPapelera registro(s) de avance irán a la Papelera al quitar sus fechas.</span>
        <button type="button" class="pg-btn" title="Volver a la edición" @onclick="() => confirmarMx = false"><Ico Nombre="cancelar" /></button>
        <button type="button" class="pg-btn pg-btn-primario" title="Guardar" disabled="@guardando" @onclick='() => vista == "torre" ? GuardarTorre() : GuardarMatriz()'><Ico Nombre="guardar" /></button>
    </div>
}

@if (verImportar)
{
    <SigWeb.Components.AvanceObra.PanelImportarAvance OnImportado="TrasImportar" />
}

@if (s is null)
{
    <Esqueleto Tipo="tarjetas" Filas="4" Etiqueta="Cargando avance de obra…" />
}
else
{
    @if (vista is "mapa" or "torre" or "matriz")
    {
        <div class="av-filtros">
            <label class="av-filtro" title="Fecha de corte">
                <Ico Nombre="filtro" />
                <input type="date" class="form-control form-control-sm" value="@corte.ToString("yyyy-MM-dd")" @onchange="CambiarCorte" />
            </label>
            <input class="form-control form-control-sm av-buscar" placeholder="Torre…" title="Filtrar torres" @bind="buscar" @bind:event="oninput" />
            @if (vista == "matriz")
            {
                <select class="form-select form-select-sm av-filtro-act" title="Filtrar actividades" value="@filtroAct" @onchange="e => filtroAct = e.Value?.ToString() ?? string.Empty">
                    <option value="">Todas las actividades</option>
                    <optgroup label="Grupo">
                        @foreach (var g in Grupos()) { <option value="@("g:" + g.Key)">@g.Key</option> }
                    </optgroup>
                    <optgroup label="Actividad">
                        @foreach (var a in s.Actividades) { <option value="@("a:" + a.Id)">@a.Nombre</option> }
                    </optgroup>
                </select>
            }
            <span class="av-filtro-dato">@TorresMostradas().Count / @s.Torres.Count torres</span>
            @if (vista == "torre")
            {
                <select class="form-select form-select-sm av-filtro-act av-filtro-grupo" title="Filtrar actividades por grupo" value="@grupoActsTo" @onchange="e => grupoActsTo = e.Value?.ToString() ?? string.Empty">
                    <option value="">Todos los grupos</option>
                    @foreach (var g in Grupos()) { <option value="@g.Key">@g.Key</option> }
                </select>
            }
        </div>
    }
    @switch (vista)
    {
        case "torre": @VistaTorre() break;
        case "matriz": @VistaMatriz() break;
        case "tendido": @VistaTendido() break;
        case "perfil": @VistaPerfil() break;
        case "informe": @VistaInforme() break;
        case "ajustes": @VistaAjustes() break;
        case "estado": @VistaEstado() break;
        default: @VistaMapa() break;
    }
}

@code {
    private InstantaneaAvance? s;
    private string vista = "mapa";   // mapa | torre | tendido | perfil | matriz | informe | ajustes
    private DateTime corte = DateTime.Today;
    private string buscar = "";
    private string? error, aviso;
    private bool guardando;

    private static readonly CultureInfo Es = CultureInfo.GetCultureInfo("es-CO");
    private static string FormatoPct(decimal? v) => v is decimal x ? x.ToString("0.#", Es) + " %" : "—";
    private static string Pct0(decimal? v) => v is decimal x ? x.ToString("0", CultureInfo.InvariantCulture) : "";
    private static string Fecha(DateTime? f) => f is DateTime x ? x.ToString("dd/MM/yyyy") : "";
    private static string EstiloPct(decimal? v)
    {
        if (v is not decimal x) return "";
        var h = (int)Math.Round(Math.Clamp(x, 0, 100) * 1.2m);
        return $"background:hsl({h} 62% 46%);color:#fff;";
    }

    // ?vista=tendido|torre|perfil|matriz&torre=Id: la vista y la torre se anotan en la URL mientras se
    // trabaja (js/volver.js), así que al volver con Atrás desde otra pantalla se abre igual.
    [SupplyParameterFromQuery(Name = "vista")] public string? VistaQ { get; set; }
    [SupplyParameterFromQuery(Name = "torre")] public int? TorreQ { get; set; }

    protected override void OnInitialized()
    {
        Cargar();
        if (s is null) return;
        if (VistaQ is "perfil" or "matriz")
        {
            vista = VistaQ!;
            if (vista == "perfil" && TorreQ is int idP && Torre(idP) is not null) { torrePf = idP; pfSeleccionar = idP; }
            return;
        }
        if (VistaQ == "torre" && TorreQ is int idT && Torre(idT) is not null) { vista = "torre"; torreFoco = idT; return; }
        if (VistaQ == "estado") { VerVista("estado"); return; }
        if (VistaQ != "tendido") return;
        vista = "tendido";
        if (TorreQ is int id) EnfocarTendido(id);
    }

    private void EnfocarTendido(int id)
    {
        if (s!.Tiros.FirstOrDefault(x => x.Torres.Contains(id)) is not { } tiro) return;
        tiroSel = tiro.Id; torreTd = id; enfocarTd = id; irTd = Torre(id)?.Nombre ?? "";
    }

    // ---------- Volver: vistas ya vistas en esta página y anotación en la URL ----------
    private readonly PilaVistas pila = new();
    private string? vistaAnotada;
    private int? TorreDeVista => vista switch { "torre" => torreFoco, "tendido" => torreTd, "perfil" => torrePf, _ => null };
    private string EstadoVista => TorreDeVista is int t ? $"{vista}:{t}" : vista;

    private async Task AnotarVista(bool primera)
    {
        if (primera) await pila.CargarAsync(JS, "avance-obra");
        pila.Observar(EstadoVista);
        await pila.GuardarAsync(JS, "avance-obra", "/avance-obra");
        if (EstadoVista == vistaAnotada) return;
        vistaAnotada = EstadoVista;
        await JS.RecordarVistaAsync("/avance-obra", new Dictionary<string, object?>
        {
            ["vista"] = vista is "torre" or "tendido" or "perfil" or "matriz" or "estado" ? vista : null,
            ["torre"] = TorreDeVista,
        });
    }

    // Línea: el tendido 3D y la planta-perfil se alternan conservando la torre en que se estaba.
    private int? torrePf;          // torre elegida en la planta-perfil (la avisa perfil.js)
    private int? pfSeleccionar;    // torre a marcar en la planta-perfil cuando esté lista

    private void AlternarLinea()
    {
        if (vista == "tendido")
        {
            var t = torreTd ?? torrePf;
            VerVista("perfil");
            if (t is int id) { torrePf = id; pfSeleccionar = id; }
        }
        else if (torrePf is int id && Torre(id) is { } t && s!.Tiros.Any(x => x.Torres.Contains(id))) VerEnTendido(t);
        else VerVista("tendido");
    }

    [JSInvokable]
    public Task PerfilSeleccion(int id) { torrePf = id; return Task.CompletedTask; }

    private void AplicarVista(string estado)
    {
        var partes = estado.Split(':', 2);
        VerVista(partes[0]);
        if (partes.Length < 2 || !int.TryParse(partes[1], out var id)) return;
        if (partes[0] == "torre" && Torre(id) is not null) { torreFoco = id; idxT = null; }
        else if (partes[0] == "tendido") EnfocarTendido(id);
        else if (partes[0] == "perfil" && Torre(id) is not null) { torrePf = id; pfSeleccionar = id; }
    }

    private void Cargar()
    {
        try
        {
            s = ServicioAvanceObra.Cargar(Db, Env.WebRootPath);
            pieCache.Clear();
            CargarInformes();
            if (vista == "ajustes") PrepararAjustes();
        }
        catch (Exception ex) { error = "No se pudo cargar el avance de obra: " + ex.Message; }
    }

    private void Recargar() { CancelarMatriz(); CancelarTorre(); Cargar(); visorTorre = null; }

    // Importar el avance acumulado desde un Excel de cualquier formato (Components/AvanceObra/PanelImportarAvance).
    private bool verImportar;
    private void TrasImportar() { Cargar(); visorTorre = null; }

    private void VerVista(string v)
    {
        if (v != "matriz" && v != "torre") CancelarMatriz();
        if (v != "torre") CancelarTorre();
        if (v == "torre" && editMx) CancelarMatriz();
        if (v != "tendido") { PararTd(); CancelarTendido(); ajustesTd = false; }
        if (v == "ajustes" && vista != "ajustes") vistaAntesFormulario = vista;
        if (v != "estado") { if (vEstado is { Editando: true } ve) ve.Cancelar(); fichaEstado = null; }
        vista = v;
        if (v == "ajustes") PrepararAjustes();
        if (v != "torre") Parar();
        if (v == "estado" && sCostos is null && !cargandoEstado) _ = CargarEstadoAsync();
    }

    // ---------- Estado de las torres (vive aquí desde el 2026-11-19; antes en Costos y presupuestos) ----------
    // Mismo componente (Components/Costos/VistaEstadoTorres) con la instantánea de Costos leída en su propio scope (no
    // choca con el DbContext del circuito). Fuera de edición, clic en una torre = ficha de avance físico y PIE (FichaTorre).
    private SigWeb.Data.Costos.InstantaneaCostos? sCostos;
    private SigWeb.Components.Costos.VistaEstadoTorres? vEstado;
    private bool cargandoEstado;
    private int? fichaEstado;
    private double fichaX, fichaY;

    private async Task CargarEstadoAsync()
    {
        cargandoEstado = true;
        try
        {
            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            sCostos = await SigWeb.Data.Costos.InstantaneaCostos.CargarAsync(db);
        }
        catch (Exception ex) { error = "No se pudo leer el estado de las torres: " + ex.Message; }
        finally { cargandoEstado = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task RecargarEstadoAsync() { sCostos = null; await CargarEstadoAsync(); }

    private Task EditarEstado() { fichaEstado = null; return vEstado?.EditarAsync() ?? Task.CompletedTask; }

    private void AbrirFichaEstado(SigWeb.Components.Costos.VistaEstadoTorres.ClicTorreEstado c)
    {
        if (Torre(c.Id) is null) { error = "Esta torre no está en Avance de obra (sin actividades o fuera del trazado)."; return; }
        fichaEstado = fichaEstado == c.Id ? null : c.Id; fichaX = c.X; fichaY = c.Y; fichaMin = false;
    }

    private void TorrePorTorre(TorreAvance t) { fichaEstado = null; VerVista("torre"); torreFoco = t.Id; idxT = null; }

    private void ErrorEstado(string m) => error = m;

    private RenderFragment VistaEstado() => __builder =>
    {
        if (sCostos is null)
        {
            <Esqueleto Tipo="tarjetas" Filas="4" Etiqueta="Cargando estado de las torres…" />
            return;
        }
        <div class="av-estado">
            <SigWeb.Components.Costos.VistaEstadoTorres @ref="vEstado" S="sCostos" Corte="corte" OnCambio="RecargarEstadoAsync" OnEstado="StateHasChanged"
                                                        OnError="ErrorEstado" OnTorre="AbrirFichaEstado" />
        </div>
        @if (fichaEstado is int id && Torre(id) is { } tf)
        {
            <div class="av-et-fondo" @onclick="() => fichaEstado = null"></div>
            <div class="av-et-pop" role="dialog" aria-label="@($"Avance de la torre {tf.Nombre}")" style="@EstiloFicha">
                @FichaTorre(tf, corte, false, () => fichaEstado = null)
            </div>
        }
    };

    private string EstiloFicha => $"--x:{fichaX.ToString(CultureInfo.InvariantCulture)};--y:{fichaY.ToString(CultureInfo.InvariantCulture)}";

    // Cierra el informe abierto; si no, vuelve a la vista anterior de la página y, si no hay, a la pantalla anterior.
    private EventCallback Atras => EventCallback.Factory.Create(this, async () =>
    {
        if (vista == "informe" && inf is not null) { inf = null; return; }
        if (pila.Volver(EstadoVista) is { } previa) { AplicarVista(previa); return; }
        await JS.VolverAsync();
    });

    private void CambiarCorte(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var f)) corte = f.Date;
        Parar(); idxT = null;
    }

    private List<TorreAvance> TorresMostradas()
    {
        if (s is null) return new();
        var q = buscar.Trim();
        return q.Length == 0 ? s.Torres : s.Torres.Where(t => t.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase) || (t.TipoTexto ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private List<IGrouping<string, ActividadObra>> Grupos() => s!.Actividades.GroupBy(a => a.Grupo).ToList();

    // Filtro de actividades de la matriz: "" = todas, "g:Grupo" o "a:Id".
    private string filtroAct = "";
    private string grupoActsTo = "";     // Torre por torre: grupo de actividades del panel derecho ("" = todos)
    private List<ActividadObra> ActividadesMostradas() =>
        filtroAct.StartsWith("g:") ? s!.Actividades.Where(a => a.Grupo == filtroAct[2..]).ToList()
        : filtroAct.StartsWith("a:") && int.TryParse(filtroAct[2..], out var id) ? s!.Actividades.Where(a => a.Id == id).ToList()
        : s!.Actividades;

    // ================= Mapa de calor =================
    private RenderFragment VistaMapa() => __builder =>
    {
        var torres = TorresMostradas();
        var grupos = Grupos();
        <div class="pm-mapa-marco">
            <table class="pm-mapa av-mapa @(s!.Actividades.Count > 18 ? "pm-muchas" : "")">
                <thead>
                    <tr>
                        <th class="pm-esq" rowspan="2">Torre</th>
                        <th class="pm-tot-th" rowspan="2" title="Avance ponderado de la torre">%</th>
                        @foreach (var g in grupos)
                        {
                            <th class="av-grupo-th" colspan="@g.Count()" title="@g.Key">@g.Key</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var a in s!.Actividades)
                        {
                            <th class="pm-act" title="@($"{a.Nombre} · {a.Grupo} · peso {a.Peso * 100:0.#} %")"><span class="pm-act-txt">@a.Nombre</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t0 in torres)
                    {
                        var t = t0;
                        var pt = s.PctTorre(t, corte);
                        <tr>
                            <th class="pm-torre" @onclick="() => EnfocarTorre(t)" title="Ver torre">
                                <span class="pm-torre-nom">@t.Nombre</span>
                                @if (!string.IsNullOrEmpty(t.TipoTexto)) { <span class="pm-torre-tiro">@t.TipoTexto</span> }
                            </th>
                            <td class="pm-tot">
                                <span class="pm-tot-barra"><span style="width:@Pct0(pt ?? 0)%;@EstiloPct(pt)"></span></span>
                                <span class="pm-tot-num">@FormatoPct(pt)</span>
                            </td>
                            @foreach (var a0 in s.Actividades)
                            {
                                var a = a0;
                                var v = s.PctActividad(t, a, corte);
                                <td class="pm-cel @(v is null ? "pm-sin" : "")" style="@EstiloPct(v)" title="@($"{t.Nombre} · {a.Nombre}: {FormatoPct(v)}")" @onclick="() => EnfocarTorre(t)">@Pct0(v)</td>
                            }
                        </tr>
                    }
                    @if (torres.Count == 0)
                    {
                        <tr><td colspan="@(s.Actividades.Count + 2)" class="text-muted small text-center py-3">Sin torres.</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th class="pm-esq">Proyecto</th>
                        <td class="pm-tot"><span class="pm-tot-num fw-bold">@FormatoPct(s.PctProyecto(corte))</span></td>
                        @foreach (var a in s.Actividades)
                        {
                            var vals = torres.Select(t => s.PctActividad(t, a, corte)).Where(v => v is not null).Select(v => v!.Value).ToList();
                            decimal? v = vals.Count == 0 ? null : vals.Average();
                            <td class="pm-cel pm-pie @(v is null ? "pm-sin" : "")" style="@EstiloPct(v)" title="@($"{a.Nombre}: {FormatoPct(v)}")">@Pct0(v)</td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="pm-escala"><span>0 %</span><span class="pm-escala-barra"></span><span>100 %</span><span class="pm-escala-sin"></span><span>No aplica</span></div>
