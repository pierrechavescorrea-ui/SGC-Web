    private async Task SincronizarPerfil()
    {
        if (vista != "perfil" || s is null)
        {
            if (visorPf is not null) await LiberarPerfil();
            return;
        }
        if (pfIniciando) return;
        try
        {
            pfIniciando = true;
            if (visorPf is null)
            {
                moduloPf ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/perfil.js");
                yoTd ??= DotNetObjectReference.Create(this);
                visorPf = await moduloPf.InvokeAsync<IJSObjectReference>("crear", raizPf, yoTd);
                pfDatosDe = null; pfEstado = null;
            }
            if (!ReferenceEquals(pfDatosDe, s))
            {
                pfDatosDe = s; pfEstado = null;
                var datos = new
                {
                    torres = s.Torres.Where(t => t.Perfil is not null).Select(t => new
                    {
                        id = t.Id, n = t.Nombre, tipo = t.TipoTexto, fn = PerfilLinea.Funcion(t.Familia, t.TipoTexto),
                        x = t.Perfil!.Abscisa, z = t.Perfil.Cota, zc = t.Perfil.CotaConstruccion, h = t.Perfil.AlturaTotal,
                        hc = t.Perfil.Amarre, defl = t.Perfil.Deflexion, lat = t.Lat, lon = t.Lon
                    }),
                    tiros = s.Tiros.Select(t => new { id = t.Id, nombre = t.Nombre, torres = t.Torres })
                };
                await visorPf.InvokeVoidAsync("cargar", datos);
            }
            var clave = $"{corte:yyyyMMdd}";
            if (pfEstado != clave)
            {
                pfEstado = clave;
                var pct = s.Torres.Where(t => t.Perfil is not null).Select(t => (t.Id, P: s.PctTorre(t, corte)))
                    .Where(x => x.P is not null).ToDictionary(x => x.Id.ToString(), x => (double)x.P!.Value);
                await visorPf.InvokeVoidAsync("estado", pct);
            }
            if (pfSeleccionar is int sel) { pfSeleccionar = null; await visorPf.InvokeVoidAsync("seleccionar", sel); }
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { error = "No se pudo iniciar el perfil: " + ex.Message; StateHasChanged(); }
        finally { pfIniciando = false; }
    }

    private async Task LiberarPerfil()
    {
        var v = visorPf; visorPf = null; pfDatosDe = null; pfEstado = null;
        try { if (v is not null) { await v.InvokeVoidAsync("liberar"); await v.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    // Botones de la ficha del perfil: Torre por torre, Ver en el tendido, Hoja de vida.
