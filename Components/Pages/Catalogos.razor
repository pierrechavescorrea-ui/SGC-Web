        tipoSeleccionado = d.Nombre;
        abierto = true;
        filtro = "";
        CerrarFormItem();
        CargarLista();
    }

    private void AlternarFormItem()
    {
        if (mostrarFormItem) CerrarFormItem();
        else { CancelarEdicion(); mostrarFormItem = true; }
    }

    private void CerrarFormItem() { CancelarEdicion(); mostrarFormItem = false; }

    private void EditarItem(ItemCatalogo i) { Editar(i); mostrarFormItem = true; }

    private async Task CalcularImpacto(Func<Task<SigWeb.Data.Impacto.InformeImpacto>> f)
    {
        impacto = null; impactoOk = false;
        try { impacto = await f(); } catch { impacto = new SigWeb.Data.Impacto.InformeImpacto { Elemento = "No se pudo calcular el impacto" }; }
        await InvokeAsync(StateHasChanged);
    }

    private void PedirEliminarCatalogo(DefinicionCatalogo d)
    {
        elimCatalogo = d;
        _ = CalcularImpacto(() => Analizador.Catalogo(d.Id));
    }

    private void CancelarEliminarCatalogo() { elimCatalogo = null; impacto = null; impactoOk = false; }

    private async Task EliminarCatalogoActual()
    {
        if (elimCatalogo is null || BloqueadoPorImpacto) return;
        var entidad = await Db.DefinicionesCatalogo.FirstOrDefaultAsync(x => x.Id == elimCatalogo.Id);
        if (entidad is not null)
        {
            entidad.Eliminado = true;
            entidad.FechaEliminacion = DateTime.Now;
            await Db.SaveChangesAsync();
        }
        Db.ChangeTracker.Clear();
        if (tipoSeleccionado == elimCatalogo.Nombre) abierto = false;
        CancelarEliminarCatalogo();
        CargarDefiniciones();
        CargarConteos();
        CargarLista();
    }

    // Desde la pestaña Íconos, «volver» regresa a Catálogos; desde ahí, a la página anterior.
    // Volver: a lo visto antes en esta página (lista, un catálogo, íconos) y, si no hay, a la pantalla anterior.
    private EventCallback AtrasCatalogos => EventCallback.Factory.Create(this, AtrasAsync);

    private readonly PilaVistas pila = new();
    private string? vistaAnotada;
    private string EstadoVista => pestana is "iconos" or "plantillas" ? pestana : abierto && definicionActual is not null ? $"catalogo:{definicionActual.Id}" : "lista";

    private bool desdeFormularios;

    // Ítem con el formato que tiene AHORA en el formulario (aún sin guardar).
    private RenderFragment VistaItem(ItemCatalogo it, bool marcar) => __builder =>
    {
        var nombre = string.IsNullOrWhiteSpace(it.Nombre) ? "Nuevo" : it.Nombre;
        var est = SigWeb.Data.Catalogos.EstilosCatalogo.De(it);
        var cls = marcar ? "cm-vista-edita" : "";
        if (est is null)
        {
            <span class="@(marcar ? "cm-vista-sin cm-vista-edita" : "")">@nombre</span>
        }
        else if (est.Forma == "texto")
        {
            <span class="@cls" style="color:@est.ColorTexto;font-weight:@(est.Negrita ? 600 : 400)">@nombre</span>
        }
        else
        {
            <span class="@(est.Forma == "celda" ? "vc-celda" : "rg-pill") @cls" style="background:@est.ColorFondo;color:@est.ColorTexto;font-weight:@(est.Negrita ? 600 : 400)">@nombre</span>
        }
    };

    private Task VolverAlDisenadorAsync()
    {
        desdeFormularios = false;
        CerrarFormItem();
        Nav.NavigateTo(string.IsNullOrEmpty(formVolver) ? "editor?pestana=formularios" : $"editor?pestana=formularios&form={Uri.EscapeDataString(formVolver)}");
        return Task.CompletedTask;
    }

    private async Task AtrasAsync()
    {
        if (desdeFormularios && pestana == "catalogos") { await VolverAlDisenadorAsync(); return; }
        if (pila.Volver(EstadoVista) is not { } previa) { await JS.VolverAsync(); return; }
        var partes = previa.Split(':', 2);
        if (partes[0] is "iconos" or "plantillas") { pestana = partes[0]; return; }
        pestana = "catalogos";
        if (partes.Length == 2 && int.TryParse(partes[1], out var id) && definiciones.FirstOrDefault(x => x.Id == id) is { } def)
        {
            if (!(abierto && tipoSeleccionado == def.Nombre)) AbrirCatalogo(def);
        }
        else if (abierto) CerrarCatalogo();
    }

    private async Task AnotarVista(bool primera)
    {
        if (primera) await pila.CargarAsync(JS, "catalogos");
        pila.Observar(EstadoVista);
        await pila.GuardarAsync(JS, "catalogos", "/catalogos");
        if (EstadoVista == vistaAnotada) return;
        vistaAnotada = EstadoVista;
        await JS.RecordarVistaAsync("/catalogos", new Dictionary<string, object?>
        {
            ["pestana"] = pestana is "iconos" or "plantillas" ? pestana : null,
            ["catalogo"] = abierto ? definicionActual?.Id : null,
        });
    }
