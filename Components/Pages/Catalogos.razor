    }

    private async Task Guardar()
    {
        try
        {
            mensaje = "";
            var nombre = (itemActual.Nombre ?? "").Trim();

            if (string.IsNullOrWhiteSpace(nombre))
            {
                mensaje = "El nombre es obligatorio.";
                return;
            }

            bool duplicado = Db.Catalogos.AsNoTracking().Any(c =>
                c.Tipo == tipoSeleccionado &&
                c.Nombre.ToLower() == nombre.ToLower() &&
                c.Id != itemActual.Id);

            if (duplicado)
            {
                mensaje = $"\"{nombre}\" ya existe en {tipoSeleccionado}.";
                return;
            }

            // Nombre anterior: si cambia, los registros que ya usan la opción heredan el nombre nuevo (PropagadorCatalogo).
            var nombreAnterior = modoEdicion
                ? Db.Catalogos.AsNoTracking().Where(c => c.Id == itemActual.Id).Select(c => c.Nombre).FirstOrDefault()
                : null;

            itemActual.Nombre = nombre;
            itemActual.Tipo = tipoSeleccionado;

            if (modoEdicion)
            {
                Db.Catalogos.Update(itemActual);
            }
            else
            {
                Db.Catalogos.Add(itemActual);
            }

            await Db.SaveChangesAsync();

            foreach (var campo in camposDelCatalogoActual)
            {
                var valor = ValorCampo(campo.Nombre);
                var existente = await Db.ValoresCampoCatalogoItem.FirstOrDefaultAsync(
                    v => v.ItemCatalogoId == itemActual.Id && v.Clave == campo.Nombre);
                if (existente is not null)
                {
                    existente.Valor = valor;
                }
                else if (!string.IsNullOrWhiteSpace(valor))
                {
                    Db.ValoresCampoCatalogoItem.Add(new ValorCampoCatalogoItem
                    {
                        ItemCatalogoId = itemActual.Id,
                        Clave = campo.Nombre,
                        Valor = valor
                    });
                }
            }
            await Db.SaveChangesAsync();
            Db.ChangeTracker.Clear();
            string heredado = "";
            if (nombreAnterior is not null && nombreAnterior != nombre)
                heredado = await SigWeb.Data.Catalogos.PropagadorCatalogo.RenombrarAsync(Db, tipoSeleccionado, nombreAnterior, nombre);
            EstilosCat.Recargar();

            CerrarFormItem();
            avisoHerencia = heredado != "" ? $"«{nombreAnterior}» ahora es «{nombre}» también en los registros que la usaban ({heredado})." : "";
            CargarLista();
            CargarConteos();

        }
        catch (Exception ex)
        {
            Db.ChangeTracker.Clear();
            mensaje = "No se pudo guardar: " + (ex.InnerException?.Message ?? ex.Message);
        }
    }

    private void Editar(ItemCatalogo i)
    {
        itemActual = new ItemCatalogo
        {
            Id = i.Id,
