@* Pantalla de un módulo del menú que aún no tiene contenido. *@
<PageTitle>@Titulo</PageTitle>

<EncabezadoPagina Titulo="@Titulo" Icono="@Icono" Atras="/" />

<div class="pg-vacio" title="@Titulo (vacío)">
    <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@((MarkupString)EncabezadoPagina.Trazos(Icono))</svg>
    <span>Vacío</span>
</div>

@code {
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Icono { get; set; } = "";
}
