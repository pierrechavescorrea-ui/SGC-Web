@* Asistente de ayuda INTERNO (sin API ni servicios externos): botón «?» del encabezado de cada página y panel lateral con
   la conversación. Responde con el manual de usuario (docs/manual) según la pantalla actual. Lógica en Data/Asistente/;
   estilos en css/asistente.css (clases asis-*); desplazamiento y foco en js/asistente.js (sigAsistente). *@
@using SigWeb.Data.Asistente
@inject AsistenteAyuda Asistente
@inject NavigationManager Nav
@inject IJSRuntime JS

<button type="button" class="pg-btn asis-boton @(abierto ? "activo" : "")" title="Asistente de ayuda" aria-label="Asistente de ayuda"
        id="asis-abrir" aria-controls="asis-panel" aria-expanded="@abierto.ToString().ToLowerInvariant()" @onclick="Alternar">
    <Ico Nombre="ayuda" />
</button>

@if (abierto)
{
    <div id="asis-panel" class="asis-panel" tabindex="-1" role="dialog" aria-label="πr, asistente de ayuda">
        @* πr (avatar «Contorno», media sonrisa): la cabeza se asoma por detrás del borde superior y las manos se agarran a
           él (dos SVG: cabeza detrás del encabezado, manos delante). Mirada, parpadeo, asentir y «pensando» en js/asistente.js
           (sigPir); estilos pir-* en css/asistente.css. *@
        <svg class="pir pir-cab" viewBox="0 0 120 86" aria-hidden="true" focusable="false">
            <g class="pir-cuerpo"><g class="pir-asiente"><g class="pir-cabeza">
                <rect class="pir-cara" x="30" y="14" width="60" height="52" rx="18" />
                <g class="pir-ojos">
                    <path class="pir-ojo" d="M40 32 H54 M44 32 V43 M50 32 V43" />
                    <path class="pir-ojo" d="M66 32 H80 M70 32 V43 M76 32 V43" />
                </g>
                <path class="pir-boca" d="M52 54 Q62 57 69 51" />
                <path class="pir-boca-hmm" d="M53 54 Q61 54.5 68 53" />
            </g></g></g>
            <g class="pir-puntos"><circle cx="97" cy="17" r="1.6" /><circle cx="103" cy="11" r="2.1" /><circle cx="110" cy="5" r="2.6" /></g>
        </svg>
        <svg class="pir pir-manos" viewBox="0 0 120 86" aria-hidden="true" focusable="false">
            <path d="M22 80 q4-10 12-4 M86 76 q8-6 12 4" />
        </svg>
        <div class="asis-cab">
            <div class="asis-cab-txt">
                <strong class="asis-nombre" title="πr"><span class="asis-pi">π</span><span class="asis-r">r</span></strong>
            </div>
            <button type="button" class="asis-cab-btn" title="Nueva conversación" aria-label="Nueva conversación" @onclick="Reiniciar"><Ico Nombre="restaurar" /></button>
            <button type="button" class="asis-cab-btn" title="Cerrar" aria-label="Cerrar" @onclick="() => abierto = false"><Ico Nombre="cancelar" /></button>
        </div>

        <div class="asis-mensajes" @ref="caja" role="log" aria-label="Conversación">
            @foreach (var m in Asistente.Historial)
            {
                if (m.De == AsistenteAyuda.Quien.Usuario)
                {
                    <div class="asis-msg asis-yo">@m.Texto</div>
                }
                else
                {
                    <div class="asis-msg asis-el">
                        @if (!string.IsNullOrEmpty(m.Texto))
                        {
                            <p class="mb-1">@((MarkupString)MarkdownAyuda.Frase(m.Texto, (t, d) => Asistente.Enlace(t, d, CapituloActual)))</p>
                        }
                        @if (m.Seccion is { } s)
                        {
                            <div class="asis-fuente"><Ico Nombre="documento" /> @s.Capitulo.Titulo › @s.Titulo</div>
                            <div class="asis-cuerpo">@((MarkupString)MarkdownAyuda.AHtml(s.Markdown, (t, d) => Asistente.Enlace(t, d, s.Capitulo)))</div>
                        }
                        @if (m.Aviso is not null)
                        {
                            <div class="asis-aviso">@m.Aviso</div>
                        }
                        @if (m.RutaIr is not null)
                        {
                            <a class="asis-ir" href="@m.RutaIr.TrimStart('/')" data-resaltar="@m.ResaltarIr"><Ico Nombre="enlace" /> Ir a @m.NombreIr</a>
                        }
                        @if (m.Atajos.Count > 0)
                        {
                            <div class="asis-sugs">
                                <div class="asis-sugs-tit">Ir directo</div>
                                @foreach (var at in m.Atajos)
                                {
                                    <a class="asis-sug asis-atajo" href="@at.Ruta!.TrimStart('/')" data-resaltar="@at.Resaltar" title="Ir a @at.Destino"><Ico Nombre="enlace" /> @at.Texto</a>
                                }
                            </div>
                        }
                        @if (m.Sugerencias.Count > 0)
                        {
                            <div class="asis-sugs">
                                @if (m.Seccion is not null) { <div class="asis-sugs-tit">También puede servirle</div> }
                                @foreach (var sg in m.Sugerencias)
                                {
                                    var sug = sg;
                                    <span class="asis-sug-par">
                                        <button type="button" class="asis-sug" @onclick="() => Sugerencia(sug)">@sug.Texto</button>
                                        @if (sug.Ruta is not null)
                                        {
                                            <a class="asis-sug-ir" href="@sug.Ruta.TrimStart('/')" data-resaltar="@sug.Resaltar" title="Ir a @sug.Destino" aria-label="Ir a @sug.Destino"><Ico Nombre="enlace" /></a>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <form class="asis-pie" @onsubmit="Enviar" @onsubmit:preventDefault>
            <input class="form-control form-control-sm" data-sin-flotante @ref="entrada" maxlength="300" autocomplete="off"
                   placeholder="Escriba su pregunta…" aria-label="Pregunta" @bind="texto" @bind:event="oninput" />
            <button type="submit" class="btn btn-primary btn-sm" title="Preguntar" aria-label="Preguntar" disabled="@string.IsNullOrWhiteSpace(texto)"><Ico Nombre="aceptar" /></button>
        </form>
    </div>
}

@code {
    private bool abierto;
    private string texto = "";
    private ElementReference caja, entrada;
    private bool desplazar;

    private string Ruta => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
    [Inject] private ManualAyuda Manual { get; set; } = default!;
    private ManualAyuda.Capitulo? CapituloActual => Manual.CapituloDeRuta(Ruta);

    private void Alternar()
    {
        abierto = !abierto;
        if (abierto && Asistente.Historial.Count == 0) Asistente.Historial.Add(Asistente.Bienvenida(Ruta));
        desplazar = abierto;
    }

    private void Reiniciar()
    {
        Asistente.Historial.Clear();
        Asistente.Historial.Add(Asistente.Reinicio(Ruta));
        desplazar = true;
    }

    private void Enviar()
    {
        if (string.IsNullOrWhiteSpace(texto)) return;
        Asistente.Preguntar(texto, Ruta);
        texto = "";
        desplazar = true;
    }

    private void Sugerencia(AsistenteAyuda.Sugerencia s)
    {
        if (s.SeccionId is not null) Asistente.AbrirSeccion(s.SeccionId, s.Texto);
        else if (s.Pregunta is not null) Asistente.Preguntar(s.Pregunta, Ruta);
        desplazar = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!desplazar || !abierto) return;
        desplazar = false;
        try { await JS.InvokeVoidAsync("sigAsistente.alFinal", caja, entrada); } catch (JSException) { } catch (InvalidOperationException) { }
    }
}
