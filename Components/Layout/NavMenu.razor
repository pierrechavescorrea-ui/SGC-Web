@* Etiqueta flotante de los íconos cuando el menú está en modo barra (la posiciona js/menu.js). *@
<div class="nav-tip" aria-hidden="true"></div>

@code {
    private string? logoUrl;
    private IReadOnlyList<Proyecto> proyectos = Array.Empty<Proyecto>();

    protected override void OnInitialized()
    {
        logoUrl = Logo.Url;   // uno para todos los proyectos (lo elige el administrador en Administración › Sistema)
        if (Usuario.Id is { } uid) proyectos = Permisos.ProyectosDe(uid);
    }

    // Menú por permisos: un módulo sin "Ver" no aparece (la ruta igual lo bloquea en el servidor).
    private bool Ve(string ruta) => Usuario.Puede(CatalogoModulos.ClaveDeRuta(ruta), Accion.Ver);

    // Módulos creados por el administrador al final de su capítulo. Va aquí (no en otro componente) para que reciba los
    // estilos aislados del menú (NavMenu.razor.css: tamaño del ícono, texto, modo barra).
    private RenderFragment ModulosCreados(string grupo) => __builder =>
    {
        foreach (var m in ModulosCreadosReg.DelGrupo(grupo))
        {
            if (!Usuario.Puede(m.ClavePermiso, Accion.Ver)) continue;
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@m.Ruta" title="@(string.IsNullOrWhiteSpace(m.Descripcion) ? m.Nombre : m.Nombre + " · " + m.Descripcion)">
                    <IconoPunto Punto="@("menu:" + m.Ruta)" Clase="nav-ico"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@((MarkupString)EncabezadoPagina.Trazos(m.Icono))</svg></IconoPunto>
                    <span class="nav-texto">@m.Nombre</span>
                </NavLink>
            </div>
        }
    };

    private static string Inicial(string? s) => string.IsNullOrWhiteSpace(s) ? "?" : s.Trim()[..1].ToUpperInvariant();
    private static string Iniciales(ProyectoActivo p) => p.Codigo.Length <= 3 ? p.Codigo : p.Codigo[..3];
}
