@using Microsoft.EntityFrameworkCore
@using SigWeb.Data
@using SigWeb.Data.Seguridad
@inject AppDbContext Db
@inject UsuarioActual Usuario
@inject ServicioPermisos Permisos
@inject LogoApp Logo
@inject NavigationManager Nav
@inject SigWeb.Data.CreadorModulos.RegistroModulosCreados ModulosCreadosReg

<div class="top-row nav-marca">
    <a class="navbar-brand" href="" title="Inicio">
        @if (!string.IsNullOrEmpty(logoUrl))
        {
            <img src="@logoUrl" alt="Logo de la empresa" class="logo-empresa" />
        }
        else
        {
            <span class="marca-texto">SGC Web</span>
        }
        @* En la barra: el logo de la empresa recortado a su parte izquierda (el emblema). *@
        <img src="@(string.IsNullOrEmpty(logoUrl) ? "favicon.png" : logoUrl)" alt="" class="logo-compacto @(string.IsNullOrEmpty(logoUrl) ? "" : "logo-recorte")" />
    </a>
</div>

@* Buscador rápido (Ctrl + K): lo abre js/navegacion.js. *@
<div class="nav-buscar-caja">
    <button type="button" class="nav-buscar" data-nav="buscar" title="Buscar (Ctrl + K)" aria-label="Buscar">
        <svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></svg>
        <span class="nav-texto">Buscar…</span>
        <kbd class="nav-texto nav-kbd">Ctrl K</kbd>
    </button>
</div>


@* Proyecto activo: cambiarlo es un POST (la cookie de sesión guarda el proyecto). *@
@if (Usuario.Proyecto is { } pa)
{
    <form class="nav-proyecto" method="post" action="cuenta/proyecto" title="Proyecto: @pa.Nombre">
        <AntiforgeryToken />
        <SigWeb.Components.Admin.MarcaProyecto EsEmpresa="@pa.EsEmpresa" Codigo="@pa.Codigo" MaxCodigo="3" Clase="nav-proyecto-marca" Estilo="@($"--np:{pa.Color ?? "#EC1C24"}")" />
        @if (proyectos.Count > 1)
        {
            <select name="id" class="nav-texto nav-proyecto-sel" aria-label="Cambiar de proyecto" data-accion="enviar-form">
                @foreach (var p in proyectos)
                {
                    <option value="@p.Id" selected="@(p.Id == pa.Id)">@(p.EsEmpresa ? "Empresa · " : "")@p.Nombre</option>
                }
            </select>
        }
        else
        {
            <span class="nav-texto nav-proyecto-nom">@pa.Nombre</span>
        }
    </form>
}

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                <IconoPunto Punto="menu:" Clase="nav-ico"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h5v-6h4v6h5V10" /></svg></IconoPunto>
                <span class="nav-texto">Home</span>
