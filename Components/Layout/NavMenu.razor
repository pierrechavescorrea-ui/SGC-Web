        <div class="nav-grupo" data-grupo="hallazgos">
            <button type="button" class="nav-grupo-tit" title="Evaluación y mejora · ISO 9001 cap. 9–10" aria-expanded="false">
                <IconoPunto Punto="menu-grupo:hallazgos" Clase="nav-ico"><svg class="nav-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 0 1-14.3 4.9M4 12a8 8 0 0 1 14.3-4.9" /><path d="M18.5 3v4.2h-4.2M5.5 21v-4.2h4.2" /><path d="m9 12 2 2 4-4" /></svg></IconoPunto>
