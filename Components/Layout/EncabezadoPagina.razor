        "organigrama" => "<rect x=\"9\" y=\"3\" width=\"6\" height=\"4.5\" rx=\"1\"/><rect x=\"3\" y=\"16.5\" width=\"6\" height=\"4.5\" rx=\"1\"/><rect x=\"15\" y=\"16.5\" width=\"6\" height=\"4.5\" rx=\"1\"/><path d=\"M12 7.5V12M6 16.5V12h12v4.5\"/>",
        "manuales-funciones" => "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><circle cx=\"8.5\" cy=\"11\" r=\"2\"/><path d=\"M5.5 16a3 3 0 0 1 6 0M14 10h4M14 13.5h4\"/>",
        "certificaciones" => "<circle cx=\"12\" cy=\"9\" r=\"5.5\"/><path d=\"m10 11 1.5 1.5L15 8\"/><path d=\"M8.5 13.5 7 21l5-2.5 5 2.5-1.5-7.5\"/>",
