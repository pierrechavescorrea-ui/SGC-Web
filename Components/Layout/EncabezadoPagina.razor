        _ => SigWeb.Data.Iconos.GaleriaIconosModulo.Trazos(clave) ?? "<path d=\"M12 2.5 4 7v9l8 4.5 8-4.5V7z\"/><path d=\"M4 7l8 4.5L20 7M12 11.5v9\"/>",
