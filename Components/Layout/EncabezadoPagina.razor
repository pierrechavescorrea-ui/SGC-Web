@inject SigWeb.Data.Iconos.IconosApp IconosApp
@inject NavigationManager Nav
@inject SigWeb.Data.Navegacion.MenuIcono MenuIco
@inject SigWeb.Data.Seguridad.UsuarioActual UsuarioAdm
@implements IDisposable
@{ var modulo = SigWeb.Data.Navegacion.MapaNavegacion.De(Nav.ToBaseRelativePath(Nav.Uri)); }
@* data-grupo: estilos por grupo del menú ; data-estilo="listados" = tablas de css/listados.css. *@
<div class="pg-cab" data-grupo="@modulo?.Grupo" data-estilo="@modulo?.Estilo">
    <div class="pg-titulo">
        @if (OnAtras.HasDelegate)
        {
            <button type="button" class="pg-atras border-0" title="Volver" aria-label="Volver" @onclick="OnAtras">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
        }
        else
        {
            @* Vuelve a la pantalla anterior de la app (js/volver.js); «Atras» solo se usa si no hay ninguna. *@
            <button type="button" class="pg-atras border-0" title="Volver" aria-label="Volver"
                    data-accion="volver" data-destino="@(Atras ?? "/")">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
        }
        @{ var menu = MenuIco.Actual; }
        <span class="pg-logo-marco">
        <span class="pg-logo @(menu is not null ? "pg-logo-menu" : "") @(menuAbierto ? "abierto" : "")"
              role="@(menu is not null ? "button" : null)" tabindex="@(menu is not null ? "0" : null)"
              title="@(menu is not null ? $"{menu.Titulo}: {menu.Opciones.FirstOrDefault(o => o.Clave == menu.Actual)?.Nombre}" : null)"
              aria-haspopup="@(menu is not null ? "listbox" : null)" aria-expanded="@(menu is not null ? menuAbierto.ToString().ToLowerInvariant() : null)"
              aria-hidden="@(menu is null ? "true" : null)"
              @onclick="AlternarMenu" @onkeydown="TeclaMenu">
            @if (!string.IsNullOrEmpty(IconoUrl))
            {
                <img src="@IconoUrl" alt="" width="24" height="24" style="object-fit:contain;" />
            }
            else if (IconosApp.Ruta("cab:" + Icono) is string asignado)
            {
                <img src="@asignado" alt="" width="24" height="24" style="object-fit:contain;" />
            }
            else
            {
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">@((MarkupString)Trazos(Icono))</svg>
            }
            @if (menu is not null)
            {
                <span class="pg-logo-flecha" aria-hidden="true"><svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
            }
        </span>
        @if (menu is not null && menuAbierto)
        {
            <span class="pg-menu-fondo" @onclick="() => menuAbierto = false"></span>
            <div class="pg-menu" role="listbox" aria-label="@menu.Titulo">
                <div class="pg-menu-tit">@menu.Titulo</div>
                @foreach (var o in menu.Opciones)
                {
                    var op = o;
                    var elegida = op.Clave == menu.Actual;
                    <button type="button" class="pg-menu-op @(elegida ? "activo" : "")" role="option" aria-selected="@elegida.ToString().ToLowerInvariant()" @onclick="() => ElegirAsync(op.Clave)">
                        @if (op.Marca is not null)
                        {
                            <SigWeb.Components.Admin.MarcaProyecto EsEmpresa="op.EsEmpresa" Codigo="@op.Marca" Clase="pg-menu-marca" Estilo="@($"--c:{op.Color ?? "#EC1C24"}")" />
                        }
                        <span class="pg-menu-txt"><span>@op.Nombre@(op.Destacada ? " ★" : "")</span>@if (op.Detalle is not null) { <small>@op.Detalle</small> }</span>
                        @if (elegida) { <span class="pg-menu-check" aria-hidden="true">✓</span> }
                    </button>
                }
                @if (menu.EnlaceGestion is not null)
                {
                    <a class="pg-menu-pie" href="@menu.EnlaceGestion"><Ico Nombre="formularios" /> @(menu.TituloGestion ?? "Gestionar")</a>
                }
            </div>
        }
        </span>
        <div class="pg-textos">
            @if (modulo is not null)
            {
                @* Ruta de navegación: grupo › módulo (el módulo lleva a su pantalla principal). *@
                <nav class="pg-migas" aria-label="Ruta">
                    @if (modulo.Grupo != modulo.Nombre)
                    {
                        <span>@modulo.Grupo</span>
                        <span class="pg-migas-sep" aria-hidden="true">›</span>
                    }
                    <a href="@modulo.Href" data-modulo>@modulo.Nombre</a>
                </nav>
            }
            <div class="pg-titulo-linea">
                <h4 class="mb-0">@Titulo</h4>
                <button type="button" class="pg-fav" title="Agregar a favoritos" aria-label="Favorito">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>
                </button>
            </div>
            @if (!string.IsNullOrEmpty(Subtitulo)) { <div class="pg-sub">@Subtitulo</div> }
        </div>
    </div>
    @* Densidad y restablecer columnas (js/tablaPin.js): visible solo si la pantalla muestra una tabla configurable (css en app.css). *@
    <div class="pg-acciones @(Acciones is null && VistasAdmin.Count < 2 ? "pg-acciones-solo-tabla" : "")">
        @* Administración agrupada (Data/Navegacion/MenuAdmin): las pantallas del mismo módulo son vistas. *@
        @if (VistasAdmin.Count > 1)
        {
            <span class="pg-vistas">
                @foreach (var v in VistasAdmin)
                {
                    <a class="pg-btn @(v == VistaAdminActual ? "activo" : "")" href="@v.Ruta" title="@v.Texto" aria-label="@v.Texto" aria-current="@(v == VistaAdminActual ? "page" : null)"><Ico Nombre="@v.Icono" /></a>
                }
            </span>
            @if (Acciones is not null) { <span class="pg-sep"></span> }
        }
        @Acciones
        <button type="button" class="pg-btn pg-tabla-cfg" title="Vista de tabla" aria-label="Vista de tabla">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h10M4 12h10M4 18h10"/><path d="M19 4v16M16.5 6.5 19 4l2.5 2.5M16.5 17.5 19 20l2.5-2.5"/></svg>
        </button>
        @* Asistente de ayuda interno (manual de usuario, sin servicios externos). *@
        <AsistenteAyudaPanel />
    </div>
</div>

@code {
    private bool menuAbierto;

    private List<SigWeb.Data.Navegacion.MenuAdmin.Vista> VistasAdmin = new();
    private SigWeb.Data.Navegacion.MenuAdmin.Vista? VistaAdminActual;

    protected override void OnInitialized()
    {
        MenuIco.Cambio += AlCambiarMenu;
        var ruta = Nav.ToBaseRelativePath(Nav.Uri);
        if (SigWeb.Data.Navegacion.MenuAdmin.GrupoDe(ruta) is { } g)
        {
            bool admin;
            try { admin = UsuarioAdm.EsAdministrador; } catch { admin = false; }
            VistasAdmin = SigWeb.Data.Navegacion.MenuAdmin.Visibles(g, admin).ToList();
            VistaAdminActual = SigWeb.Data.Navegacion.MenuAdmin.VistaDe(ruta);
        }
    }
    private void AlCambiarMenu() { if (MenuIco.Actual is null) menuAbierto = false; _ = InvokeAsync(StateHasChanged); }
    public void Dispose() => MenuIco.Cambio -= AlCambiarMenu;

    private void AlternarMenu() { if (MenuIco.Actual is not null) menuAbierto = !menuAbierto; }
    private void TeclaMenu(KeyboardEventArgs e)
    {
        if (MenuIco.Actual is null) return;
        if (e.Key is "Enter" or " ") menuAbierto = !menuAbierto;
        else if (e.Key == "Escape") menuAbierto = false;
    }
    private async Task ElegirAsync(string clave)
    {
        menuAbierto = false;
        if (MenuIco.Actual is { } m) await m.Elegir(clave);
    }

    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string? Subtitulo { get; set; }
    [Parameter] public string Icono { get; set; } = "cubo";
    [Parameter] public string? IconoUrl { get; set; }
    // Pantalla a la que vuelve «volver» cuando no hay una anterior en esta pestaña (enlace directo, pestaña nueva).
    [Parameter] public string? Atras { get; set; }
    [Parameter] public RenderFragment? Acciones { get; set; }
    // Si se indica, el botón «volver» ejecuta esto en vez de navegar (cierra la vista interna de la página;
    // cuando no hay ninguna abierta, la página debe dejarlo en default para volver a la pantalla anterior).
    [Parameter] public EventCallback OnAtras { get; set; }

    public static string Trazos(string clave) => clave switch
    {
